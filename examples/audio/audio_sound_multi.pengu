## raylib [audio] example - sound multi
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 5.0, last time updated with raylib 5.0
##
## Example contributed by Jeffery Myers (@JeffM2501) and reviewed by Ramon Santamaria (@raysan5)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2023-2025 Jeffery Myers (@JeffM2501)
##
## ## PenguScript Port
## Ported to PenguScript with idiomatic wrappers (`raylibx.drawing`, `raylibx.input`,
## `raylibx.text`, `raylibx.audio`), relative asset paths from project root,
## dynamic sound alias list pool, and full English docstrings.
##
## ## Example
## ```shell
## pengu run examples/audio/audio_sound_multi.pengu
## ```

# --- Imports ---
import raylib
import raylibx.audio as audio
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.text as txt

# --- Constants ---
## Initial window width in pixels.
const SCREEN_WIDTH as int is 800

## Initial window height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Maximum number of concurrent sound playback channels.
const MAX_SOUNDS as int is 10

## Path to the WAV audio file (relative to project root).
const SOUND_PATH as string is "examples/audio/resources/sound.wav"

# --- Entry point ---

## Program main entry point.
##
## Initializes the audio device, loads a source sound effect, creates lightweight
## sound aliases for polyphonic overlapping playback, and cycles through them on SPACE press.
##
## ## Returns
## Exit code `0` on clean shutdown, or `1` if asset loading fails.
weave main into int:
    # Initialization
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [audio] example - sound multi"
    defer calling raylib.CloseWindow

    calling raylib.InitAudioDevice # Initialize audio device
    defer calling raylib.CloseAudioDevice

    # Load audio file into the first slot as the 'source' sound (owns sample data)
    let loaded_sound as maybe raylib.Sound is calling audio.load_sound with SOUND_PATH
    if source_sound as raylib.Sound is loaded_sound:
        var sounds as list of raylib.Sound is list of raylib.Sound
        calling sounds.push with source_sound

        defer:
            # Unload sound aliases (slots 1 to MAX_SOUNDS - 1)
            for i from 1 to sounds.length:
                var alias_sound as raylib.Sound is sounds at i
                calling audio.unload_sound_alias with alias_sound
            # Unload source sound data (slot 0)
            var src as raylib.Sound is sounds at 0
            calling audio.unload_sound with src
            banish sounds

        # Load aliases of the sound into remaining slots. These share the data but can play independently
        for i from 1 to MAX_SOUNDS:
            let loaded_alias as maybe raylib.Sound is calling audio.load_sound_alias with source_sound
            if alias_s as raylib.Sound is loaded_alias:
                calling sounds.push with alias_s

        var current_sound as int is 0 # Set the sound list to the start

        calling raylib.SetTargetFPS with TARGET_FPS # Set our game to run at 60 frames-per-second

        # Main game loop
        while not calling raylib.WindowShouldClose: # Detect window close button or ESC key
            # Update
            if calling input.is_key_pressed with raylib.KEY_SPACE:
                var snd as raylib.Sound is sounds at current_sound
                calling snd.play # Play the next open sound slot
                set current_sound is (current_sound + 1) % sounds.length

            # Draw
            calling drawing.begin_drawing
            calling drawing.clear_background with raylib.RAYWHITE

            calling txt.draw_text with "Press SPACE to PLAY a WAV sound!", 200, 180, 20, raylib.LIGHTGRAY

            calling drawing.end_drawing

        return 0

    return 1
