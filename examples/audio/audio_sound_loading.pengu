## raylib [audio] example - sound loading
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 1.1, last time updated with raylib 3.5
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2014-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to PenguScript with idiomatic wrappers (`raylibx.drawing`, `raylibx.input`,
## `raylibx.text`, `raylibx.audio`), relative asset paths from project root,
## safe resource unwrapping, and full English docstrings.
##
## ## Example
## ```shell
## pengu run examples/audio/audio_sound_loading.pengu
## ```

# --- Imports ---
import raylib
import raylibx.audio as audio
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.text as txt

# --- Constants ---
## Initial window width in pixels.
const SCREEN_WIDTH as int is 800

## Initial window height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Path to the WAV audio file (relative to project root).
const WAV_PATH as string is "examples/audio/resources/sound.wav"

## Path to the OGG audio file (relative to project root).
const OGG_PATH as string is "examples/audio/resources/target.ogg"

# --- Entry point ---

## Program main entry point.
##
## Initializes the window and audio device, loads WAV and OGG sound effects,
## and plays them when SPACE or ENTER are pressed.
##
## ## Returns
## Exit code `0` on clean shutdown, or `1` if asset loading fails.
weave main into int:
    # Initialization
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [audio] example - sound loading"
    defer calling raylib.CloseWindow

    calling raylib.InitAudioDevice # Initialize audio device
    defer calling raylib.CloseAudioDevice

    let loaded_wav as maybe raylib.Sound is calling audio.load_sound with WAV_PATH
    if fx_wav as raylib.Sound is loaded_wav:
        defer calling audio.unload_sound with fx_wav

        let loaded_ogg as maybe raylib.Sound is calling audio.load_sound with OGG_PATH
        if fx_ogg as raylib.Sound is loaded_ogg:
            defer calling audio.unload_sound with fx_ogg

            calling raylib.SetTargetFPS with TARGET_FPS # Set our game to run at 60 frames-per-second

            # Main game loop
            while not calling raylib.WindowShouldClose: # Detect window close button or ESC key
                # Update
                if calling input.is_key_pressed with raylib.KEY_SPACE:
                    calling fx_wav.play # Play WAV sound
                if calling input.is_key_pressed with raylib.KEY_ENTER:
                    calling fx_ogg.play # Play OGG sound

                # Draw
                calling drawing.begin_drawing
                calling drawing.clear_background with raylib.RAYWHITE

                calling txt.draw_text with "Press SPACE to PLAY the WAV sound!", 200, 180, 20, raylib.LIGHTGRAY
                calling txt.draw_text with "Press ENTER to PLAY the OGG sound!", 200, 220, 20, raylib.LIGHTGRAY

                calling drawing.end_drawing

            return 0

    return 1
