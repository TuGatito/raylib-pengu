## raylib [audio] example - stream callback
##
## Example complexity rating: [★★★☆] 3/4
##
## Example originally created with raylib 6.0, last time updated with raylib 6.0
##
## Example created by Dan Hoang (@dan-hoang) and reviewed by Ramon Santamaria (@raysan5)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2026 Dan Hoang (@dan-hoang) and Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to PenguScript with idiomatic wrappers (`raylibx.drawing`, `raylibx.input`,
## `raylibx.shapes`, `raylibx.text`, `raylibx.audio`, `std.fractio`),
## four polymorphic waveform synthesis callbacks (sine, square, triangle, sawtooth),
## and full English docstrings.
##
## ## Example
## ```shell
## pengu run examples/audio/audio_stream_callback.pengu
## ```

# --- Imports ---
import raylib
import raylibx.audio as audio
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.text as txt
import std.ffi
import std.fractio

# --- Constants ---
## Initial window width in pixels.
const SCREEN_WIDTH as int is 800

## Initial window height in pixels.
const SCREEN_HEIGHT as int is 450

## Audio buffer frame capacity.
const BUFFER_SIZE as int is 4096

## Stream audio sample rate in Hz.
const SAMPLE_RATE as int is 44100

## Target frames per second.
const TARGET_FPS as int is 30

# --- Types ---

## Supported procedural waveform generator types.
omen WaveType:
    ## Sine wave oscillator.
    SINE
    ## Square wave oscillator.
    SQUARE
    ## Triangle wave oscillator.
    TRIANGLE
    ## Sawtooth wave oscillator.
    SAWTOOTH

# --- State Helpers ---

## Manages the target synthesis frequency across audio callbacks.
##
## ## Parameters
## - `new_freq`: the new frequency value when `should_set` is true.
## - `should_set`: whether to write `new_freq` or read the current value.
##
## ## Returns
## The current frequency in Hz.
weave audio_wave_frequency with new_freq as int, should_set as bool into int:
    static var freq as int is 440
    if should_set:
        set freq is new_freq
    return freq

## Returns the shared 1-second buffer of uploaded audio samples for oscilloscope rendering.
##
## ## Returns
## Pointer to the persistent float sample array.
weave audio_wave_buffer into ref to f32:
    static var buf as ref to f32 is null
    if calling ffi.is_null with (transmute buf to ref to void):
        set buf is transmute (calling raylib.MemAlloc with SAMPLE_RATE * 4) to ref to f32
        for i from 0 to SAMPLE_RATE:
            set buf at i is 0.0
    return buf

## Records newly synthesized audio frames into the rolling oscilloscope visualizer buffer.
##
## ## Parameters
## - `frames_out`: pointer to freshly generated audio samples.
## - `frame_count`: number of samples to append.
weave audio_record_samples with frames_out as ref to f32, frame_count as int into void:
    var buf as ref to f32 is calling audio_wave_buffer
    let shift_count as int is SAMPLE_RATE - frame_count
    for i from 0 to shift_count:
        set buf at i is buf at (i + frame_count)
    for i from 0 to frame_count:
        set buf at (shift_count + i) is frames_out at i

# --- Callbacks ---

## Synthesizes pure sine wave samples into the audio buffer.
##
## ## Parameters
## - `buffer_data`: pointer to the destination float buffer.
## - `frames`: number of mono frames requested.
weave sine_callback with buffer_data as ref to void, frames as u32 into void:
    static var wave_freq as int is 440
    static var wave_index as int is 0

    let target_freq as int is calling audio_wave_frequency with 0, false
    var wavelength as int is SAMPLE_RATE / wave_freq
    if wavelength < 1:
        set wavelength is 1

    var frames_out as ref to f32 is transmute buffer_data to ref to f32
    let count as int is frames to int

    for i from 0 to count:
        let angle as f32 is (2.0 * raylib.PI * (wave_index to f32)) / (wavelength to f32)
        set frames_out at i is calling angle.get_sin
        set wave_index is wave_index + 1
        if wave_index >= wavelength:
            set wave_freq is target_freq
            set wavelength is SAMPLE_RATE / wave_freq
            if wavelength < 1:
                set wavelength is 1
            set wave_index is 0

    calling audio_record_samples with frames_out, count

## Synthesizes square wave samples into the audio buffer.
##
## ## Parameters
## - `buffer_data`: pointer to the destination float buffer.
## - `frames`: number of mono frames requested.
weave square_callback with buffer_data as ref to void, frames as u32 into void:
    static var wave_freq as int is 440
    static var wave_index as int is 0

    let target_freq as int is calling audio_wave_frequency with 0, false
    var wavelength as int is SAMPLE_RATE / wave_freq
    if wavelength < 1:
        set wavelength is 1

    var frames_out as ref to f32 is transmute buffer_data to ref to f32
    let count as int is frames to int
    let half_wl as int is wavelength / 2

    for i from 0 to count:
        set frames_out at i is if wave_index < half_wl then 1.0 else -1.0
        set wave_index is wave_index + 1
        if wave_index >= wavelength:
            set wave_freq is target_freq
            set wavelength is SAMPLE_RATE / wave_freq
            if wavelength < 1:
                set wavelength is 1
            set wave_index is 0

    calling audio_record_samples with frames_out, count

## Synthesizes triangle wave samples into the audio buffer.
##
## ## Parameters
## - `buffer_data`: pointer to the destination float buffer.
## - `frames`: number of mono frames requested.
weave triangle_callback with buffer_data as ref to void, frames as u32 into void:
    static var wave_freq as int is 440
    static var wave_index as int is 0

    let target_freq as int is calling audio_wave_frequency with 0, false
    var wavelength as int is SAMPLE_RATE / wave_freq
    if wavelength < 1:
        set wavelength is 1

    var frames_out as ref to f32 is transmute buffer_data to ref to f32
    let count as int is frames to int
    let half_wl as int is if (wavelength / 2) < 1 then 1 else (wavelength / 2)

    for i from 0 to count:
        let sample as f32 is if wave_index < half_wl:
            -1.0 + ((2.0 * (wave_index to f32)) / (half_wl to f32))
        else:
            1.0 - ((2.0 * ((wave_index - half_wl) to f32)) / (half_wl to f32))
        set frames_out at i is sample
        set wave_index is wave_index + 1
        if wave_index >= wavelength:
            set wave_freq is target_freq
            set wavelength is SAMPLE_RATE / wave_freq
            if wavelength < 1:
                set wavelength is 1
            set wave_index is 0

    calling audio_record_samples with frames_out, count

## Synthesizes sawtooth wave samples into the audio buffer.
##
## ## Parameters
## - `buffer_data`: pointer to the destination float buffer.
## - `frames`: number of mono frames requested.
weave sawtooth_callback with buffer_data as ref to void, frames as u32 into void:
    static var wave_freq as int is 440
    static var wave_index as int is 0

    let target_freq as int is calling audio_wave_frequency with 0, false
    var wavelength as int is SAMPLE_RATE / wave_freq
    if wavelength < 1:
        set wavelength is 1

    var frames_out as ref to f32 is transmute buffer_data to ref to f32
    let count as int is frames to int

    for i from 0 to count:
        set frames_out at i is -1.0 + ((2.0 * (wave_index to f32)) / (wavelength to f32))
        set wave_index is wave_index + 1
        if wave_index >= wavelength:
            set wave_freq is target_freq
            set wavelength is SAMPLE_RATE / wave_freq
            if wavelength < 1:
                set wavelength is 1
            set wave_index is 0

    calling audio_record_samples with frames_out, count

## Hooks the selected procedural waveform synthesis callback to an audio stream.
##
## ## Parameters
## - `stream`: the destination audio stream.
## - `wave_type`: selected waveform type omen.
weave apply_wave_callback with stream as raylib.AudioStream, wave_type as WaveType into void:
    judge wave_type:
        when WaveType.SINE ->
            calling raylib.SetAudioStreamCallback with stream, sine_callback
        when WaveType.SQUARE ->
            calling raylib.SetAudioStreamCallback with stream, square_callback
        when WaveType.TRIANGLE ->
            calling raylib.SetAudioStreamCallback with stream, triangle_callback
        when WaveType.SAWTOOTH ->
            calling raylib.SetAudioStreamCallback with stream, sawtooth_callback

## Returns the display name for a waveform type.
##
## ## Parameters
## - `wave_type`: selected waveform type.
##
## ## Returns
## String label of the waveform.
weave wave_type_name with wave_type as WaveType into string:
    return judge wave_type:
        when WaveType.SINE -> "sine"
        when WaveType.SQUARE -> "square"
        when WaveType.TRIANGLE -> "triangle"
        when WaveType.SAWTOOTH -> "sawtooth"

# --- Entry point ---

## Program main entry point.
##
## Sets up a procedural raw audio stream callback, provides interactive frequency
## and waveform switching, and visualizes the generated signal in an oscilloscope graph.
##
## ## Returns
## Exit code `0` on clean shutdown, or `1` if stream creation fails.
weave main into int:
    # Initialization
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [audio] example - stream callback"
    defer calling raylib.CloseWindow

    calling raylib.InitAudioDevice
    defer calling raylib.CloseAudioDevice

    # Set the number of samples the stream will keep in memory at a time to BUFFER_SIZE
    calling raylib.SetAudioStreamBufferSizeDefault with BUFFER_SIZE

    # Allocate visualizer buffer
    let vis_buf as ref to f32 is calling audio_wave_buffer
    defer calling raylib.MemFree with (transmute vis_buf to ref to void)

    # Init raw audio stream (sample rate: 44100, sample size: 32bit-float, channels: 1-mono)
    let loaded_stream as maybe raylib.AudioStream is calling audio.load_audio_stream with SAMPLE_RATE, 32, 1
    if stream as raylib.AudioStream is loaded_stream:
        defer calling audio.unload_audio_stream with stream

        calling stream.play

        var wave_type as WaveType is WaveType.SINE
        calling apply_wave_callback with stream, wave_type

        var new_wave_frequency as int is 440
        calling audio_wave_frequency with new_wave_frequency, true

        calling raylib.SetTargetFPS with TARGET_FPS

        # Main game loop
        while not calling raylib.WindowShouldClose:
            # Update
            if calling input.is_key_down with raylib.KEY_UP:
                set new_wave_frequency is new_wave_frequency + 10
                if new_wave_frequency > 12500:
                    set new_wave_frequency is 12500
                calling audio_wave_frequency with new_wave_frequency, true

            if calling input.is_key_down with raylib.KEY_DOWN:
                set new_wave_frequency is new_wave_frequency - 10
                if new_wave_frequency < 20:
                    set new_wave_frequency is 20
                calling audio_wave_frequency with new_wave_frequency, true

            if calling input.is_key_pressed with raylib.KEY_LEFT:
                set wave_type is judge wave_type:
                    when WaveType.SINE -> WaveType.SAWTOOTH
                    when WaveType.SQUARE -> WaveType.SINE
                    when WaveType.TRIANGLE -> WaveType.SQUARE
                    when WaveType.SAWTOOTH -> WaveType.TRIANGLE
                calling apply_wave_callback with stream, wave_type

            if calling input.is_key_pressed with raylib.KEY_RIGHT:
                set wave_type is judge wave_type:
                    when WaveType.SINE -> WaveType.SQUARE
                    when WaveType.SQUARE -> WaveType.TRIANGLE
                    when WaveType.TRIANGLE -> WaveType.SAWTOOTH
                    when WaveType.SAWTOOTH -> WaveType.SINE
                calling apply_wave_callback with stream, wave_type

            # Draw
            calling drawing.begin_drawing
            calling drawing.clear_background with raylib.RAYWHITE

            let freq_txt as string is "frequency: {new_wave_frequency}"
            calling txt.draw_text with freq_txt, SCREEN_WIDTH - 220, 10, 20, raylib.RED
            banish freq_txt

            let type_str as string is calling wave_type_name with wave_type
            let type_txt as string is "wave type: {type_str}"
            calling txt.draw_text with type_txt, SCREEN_WIDTH - 220, 30, 20, raylib.RED
            banish type_txt

            calling txt.draw_text with "Up/down to change frequency", 10, 10, 20, raylib.DARKGRAY
            calling txt.draw_text with "Left/right to change wave type", 10, 30, 20, raylib.DARKGRAY

            # Draw the last 10 ms of uploaded audio
            var buf as ref to f32 is calling audio_wave_buffer
            let base_idx as int is SAMPLE_RATE - (SAMPLE_RATE / 100)
            let span as int is SAMPLE_RATE / 100

            for i from 0 to (SCREEN_WIDTH - 1):
                let idx0 as int is base_idx + ((i * span) / SCREEN_WIDTH)
                let idx1 as int is base_idx + (((i + 1) * span) / SCREEN_WIDTH)
                var start_pos as raylib.Vector2 is with x is (i to f32), y is 250.0 - (50.0 * (buf at idx0))
                let end_pos as raylib.Vector2 is with x is ((i + 1) to f32), y is 250.0 - (50.0 * (buf at idx1))
                calling start_pos.draw_line_to with end_pos, raylib.RED

            calling drawing.end_drawing

        return 0

    return 1
