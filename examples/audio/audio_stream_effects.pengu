## raylib [audio] example - stream effects
##
## Example complexity rating: [★★★★] 4/4
##
## Example originally created with raylib 4.2, last time updated with raylib 5.0
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2022-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to PenguScript with idiomatic wrappers (`raylibx.drawing`, `raylibx.input`,
## `raylibx.shapes`, `raylibx.text`, `raylibx.audio`), relative asset paths from project root,
## real-time DSP audio stream processors (low-pass filter and circular delay buffer),
## and full English docstrings.
##
## ## Example
## ```shell
## pengu run examples/audio/audio_stream_effects.pengu
## ```

# --- Imports ---
import raylib
import raylibx.audio as audio
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.text as txt
import std.ffi

# --- Constants ---
## Initial window width in pixels.
const SCREEN_WIDTH as int is 800

## Initial window height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Capacity of the circular delay effect buffer (48000 Hz * 2 channels = 1 second delay).
const DELAY_BUFFER_SIZE as int is 96000

## Path to the MP3 music stream file (relative to project root).
const MUSIC_PATH as string is "examples/audio/resources/country.mp3"

# --- State Helpers ---

## Returns the shared 1-second circular delay buffer for audio echoing.
##
## ## Returns
## Pointer to the persistent float delay buffer.
weave audio_delay_buffer into ref to f32:
    static var buf as ref to f32 is null
    if calling ffi.is_null with (transmute buf to ref to void):
        set buf is transmute (calling raylib.MemAlloc with DELAY_BUFFER_SIZE * 4) to ref to f32
        for i from 0 to DELAY_BUFFER_SIZE:
            set buf at i is 0.0
    return buf

# --- Callbacks ---

## Audio effect callback: 70 Hz first-order RC low-pass filter.
##
## ## Parameters
## - `buffer_data`: pointer to interleaved 32-bit floating point audio samples.
## - `frames`: number of stereo audio frames in the buffer.
weave audio_process_effect_lpf with buffer_data as ref to void, frames as u32 into void:
    static var low0 as f32 is 0.0
    static var low1 as f32 is 0.0
    const cutoff as f32 is 70.0 / 44100.0 # 70 Hz lowpass filter
    const k as f32 is cutoff / (cutoff + 0.1591549431) # RC filter formula

    var buf as ref to f32 is transmute buffer_data to ref to f32
    var i as int is 0
    let total as int is (frames * 2) to int
    while i < total:
        let l as f32 is buf at i
        let r as f32 is buf at (i + 1)

        set low0 is low0 + (k * (l - low0))
        set low1 is low1 + (k * (r - low1))
        set buf at i is low0
        set buf at (i + 1) is low1

        set i is i + 2

## Audio effect callback: circular buffer delay echo.
##
## ## Parameters
## - `buffer_data`: pointer to interleaved 32-bit floating point audio samples.
## - `frames`: number of stereo audio frames in the buffer.
weave audio_process_effect_delay with buffer_data as ref to void, frames as u32 into void:
    static var read_idx as int is 2
    static var write_idx as int is 0

    var delay_buf as ref to f32 is calling audio_delay_buffer
    var buf as ref to f32 is transmute buffer_data to ref to f32

    var i as int is 0
    let total as int is (frames * 2) to int
    while i < total:
        let left_delay as f32 is delay_buf at read_idx
        set read_idx is read_idx + 1
        let right_delay as f32 is delay_buf at read_idx
        set read_idx is read_idx + 1

        if read_idx >= DELAY_BUFFER_SIZE:
            set read_idx is 0

        let out_l as f32 is (0.5 * (buf at i)) + (0.5 * left_delay)
        let out_r as f32 is (0.5 * (buf at (i + 1))) + (0.5 * right_delay)
        set buf at i is out_l
        set buf at (i + 1) is out_r

        set delay_buf at write_idx is out_l
        set write_idx is write_idx + 1
        set delay_buf at write_idx is out_r
        set write_idx is write_idx + 1

        if write_idx >= DELAY_BUFFER_SIZE:
            set write_idx is 0

        set i is i + 2

# --- Entry point ---

## Program main entry point.
##
## Initializes the audio device, plays a streaming music track, and allows dynamically
## attaching and detaching low-pass filter and delay DSP effects to the audio stream.
##
## ## Returns
## Exit code `0` on clean shutdown, or `1` if asset loading fails.
weave main into int:
    # Initialization
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [audio] example - stream effects"
    defer calling raylib.CloseWindow

    calling raylib.InitAudioDevice # Initialize audio device
    defer calling raylib.CloseAudioDevice

    # Allocate buffer for the delay effect
    let delay_buf as ref to f32 is calling audio_delay_buffer
    defer calling raylib.MemFree with (transmute delay_buf to ref to void)

    let loaded_music as maybe raylib.Music is calling audio.load_music_stream with MUSIC_PATH
    if music as raylib.Music is loaded_music:
        defer calling audio.unload_music_stream with music

        calling music.play

        var time_played as f32 is 0.0       # Time played normalized [0.0..1.0]
        var pause as bool is false          # Music playing paused

        var enable_effect_lpf as bool is false   # Enable effect low-pass-filter
        var enable_effect_delay as bool is false # Enable effect delay (1 second)

        calling raylib.SetTargetFPS with TARGET_FPS # Set our game to run at 60 frames-per-second

        # Main game loop
        while not calling raylib.WindowShouldClose: # Detect window close button or ESC key
            # Update
            calling music.update # Update music buffer with new stream data

            # Restart music playing (stop and play)
            if calling input.is_key_pressed with raylib.KEY_SPACE:
                calling music.stop
                calling music.play

            # Pause/Resume music playing
            if calling input.is_key_pressed with raylib.KEY_P:
                set pause is not pause

                if pause:
                    calling music.pause
                else:
                    calling music.resume

            # Add/Remove effect: lowpass filter
            if calling input.is_key_pressed with raylib.KEY_F:
                set enable_effect_lpf is not enable_effect_lpf
                if enable_effect_lpf:
                    calling raylib.AttachAudioStreamProcessor with music.stream, audio_process_effect_lpf
                else:
                    calling raylib.DetachAudioStreamProcessor with music.stream, audio_process_effect_lpf

            # Add/Remove effect: delay
            if calling input.is_key_pressed with raylib.KEY_D:
                set enable_effect_delay is not enable_effect_delay
                if enable_effect_delay:
                    calling raylib.AttachAudioStreamProcessor with music.stream, audio_process_effect_delay
                else:
                    calling raylib.DetachAudioStreamProcessor with music.stream, audio_process_effect_delay

            # Get normalized time played for current music stream
            let total_len as f32 is calling music.time_length
            if total_len > 0.0:
                set time_played is (calling music.time_played) / total_len
            if time_played > 1.0:
                set time_played is 1.0

            # Draw
            calling drawing.begin_drawing
            calling drawing.clear_background with raylib.RAYWHITE

            calling txt.draw_text with "MUSIC SHOULD BE PLAYING!", 245, 150, 20, raylib.LIGHTGRAY

            calling shapes.draw_rectangle with 200, 180, 400, 12, raylib.LIGHTGRAY
            calling shapes.draw_rectangle with 200, 180, (time_played * 400.0) to int, 12, raylib.MAROON
            calling shapes.draw_rectangle_lines with 200, 180, 400, 12, raylib.GRAY

            calling txt.draw_text with "PRESS SPACE TO RESTART MUSIC", 215, 230, 20, raylib.LIGHTGRAY
            calling txt.draw_text with "PRESS P TO PAUSE/RESUME MUSIC", 208, 260, 20, raylib.LIGHTGRAY

            let lpf_state as string is if enable_effect_lpf then "ON" else "OFF"
            let lpf_txt as string is "PRESS F TO TOGGLE LPF EFFECT: {lpf_state}"
            calling txt.draw_text with lpf_txt, 200, 320, 20, raylib.GRAY
            banish lpf_txt

            let delay_state as string is if enable_effect_delay then "ON" else "OFF"
            let delay_txt as string is "PRESS D TO TOGGLE DELAY EFFECT: {delay_state}"
            calling txt.draw_text with delay_txt, 180, 350, 20, raylib.GRAY
            banish delay_txt

            calling drawing.end_drawing

        return 0

    return 1
