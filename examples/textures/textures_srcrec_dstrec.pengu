## raylib [textures] example - srcrec dstrec
##
## Example complexity rating: [★★★☆] 3/4
##
## Example originally created with raylib 1.3, last time updated with raylib 1.3
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to idiomatic PenguScript with raylibx wrappers (`textures`, `shapes`, `drawing`, `text`).
##
## ## Example
## ```shell
## pengu run examples/textures/textures_srcrec_dstrec.pengu
## ```

# --- Imports ---
import raylib
import raylibx.drawing as drawing
import raylibx.shapes as shapes
import raylibx.text as txt
import raylibx.textures as textures

# --- Constants ---

## Initial window width in pixels.
const SCREEN_WIDTH as int is 800

## Initial window height in pixels.
const SCREEN_HEIGHT as int is 450

## Number of horizontal frames in the Scarfy spritesheet.
const NUM_FRAMES as int is 6

# --- Entry point ---

## Application main entry point.
##
## Initializes the window, loads the Scarfy animated sprite texture,
## defines source and destination rectangles and an origin pivot point,
## and renders the rotating sprite scaled up with `draw_pro`.
##
## ## Returns
## Exit code `0` on successful execution, or `1` if resource loading fails.
weave main into int:
    # Initialization
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [textures] example - srcrec dstrec"
    defer calling raylib.CloseWindow

    # NOTE: Textures MUST be loaded after Window initialization (OpenGL context is required)
    let loaded_texture as maybe raylib.Texture2D is calling textures.load_texture with "examples/textures/resources/scarfy.png"
    if scarfy as raylib.Texture2D is loaded_texture:
        defer calling textures.unload_texture with scarfy

        let frame_width as int is scarfy.width / NUM_FRAMES
        let frame_height as int is scarfy.height

        # Source rectangle (part of the texture to use for drawing)
        var source_rec as raylib.Rectangle is with:
            set .x is 0.0
            set .y is 0.0
            set .width is frame_width to f32
            set .height is frame_height to f32

        # Destination rectangle (screen rectangle where drawing part of texture)
        var dest_rec as raylib.Rectangle is with:
            set .x is (SCREEN_WIDTH to f32) / 2.0
            set .y is (SCREEN_HEIGHT to f32) / 2.0
            set .width is (frame_width to f32) * 2.0
            set .height is (frame_height to f32) * 2.0

        # Origin of the texture (rotation/scale point), relative to destination rectangle size
        var origin as raylib.Vector2 is with:
            set .x is frame_width to f32
            set .y is frame_height to f32

        var rotation as int is 0

        calling raylib.SetTargetFPS with 60

        # Main game loop
        while not calling raylib.WindowShouldClose:
            # Update
            set rotation is rotation + 1

            # Draw
            calling drawing.begin_drawing
            calling drawing.clear_background with raylib.RAYWHITE

            # Draw rotated and scaled sprite part using draw_pro
            calling scarfy.draw_pro with source_rec, dest_rec, origin, (rotation to f32), raylib.WHITE

            calling shapes.draw_line with (dest_rec.x to int), 0, (dest_rec.x to int), SCREEN_HEIGHT, raylib.GRAY
            calling shapes.draw_line with 0, (dest_rec.y to int), SCREEN_WIDTH, (dest_rec.y to int), raylib.GRAY

            calling txt.draw_text with "(c) Scarfy sprite by Eiden Marsal", SCREEN_WIDTH - 200, SCREEN_HEIGHT - 20, 10, raylib.GRAY

            calling drawing.end_drawing

        return 0
    else:
        return 1
