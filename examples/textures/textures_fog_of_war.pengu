## examples/textures/textures_fog_of_war.pengu
## raylib [textures] example - fog of war
##
## Example complexity rating: [★★★☆] 3/4
##
## Example originally created with raylib 4.2, last time updated with raylib 4.2
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2018-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/textures/textures_fog_of_war.c` using the
## `raylibx` wrapper layer. Simulates a dynamic fog-of-war system using a low-resolution
## render texture upscaled with bilinear filtering for smooth fog gradients.
##
## ## Example
## ```bash
## pengu run examples/textures/textures_fog_of_war.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.text as txt
import raylibx.textures as textures

# --- Constants ----------------------------------------------------------
## Window width in pixels.
const SCREEN_WIDTH as int is 800

## Window height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Map tile size in pixels (32x32).
const MAP_TILE_SIZE as int is 32

## Player square size in pixels.
const PLAYER_SIZE as int is 16

## Player visibility radius in tiles.
const PLAYER_TILE_VISIBILITY as int is 2

## Number of tiles along the horizontal axis.
const TILES_X as int is 25

## Number of tiles along the vertical axis.
const TILES_Y as int is 15

## Total number of tiles on the map grid.
const TOTAL_TILES as int is TILES_X * TILES_Y

# --- Entry point --------------------------------------------------------
## Main program entry point.
##
## ## Returns
## Exit code `0` on normal termination.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [textures] example - fog of war"
    defer calling raylib.CloseWindow

    var tile_ids as list of byte is list of byte
    defer banish tile_ids

    var tile_fog as list of byte is list of byte
    defer banish tile_fog

    # Load map tiles (generating 2 random tile ids for testing)
    for _i from 0 to TOTAL_TILES:
        let random_id as byte is (calling raylib.GetRandomValue with 0, 1) to byte
        calling tile_ids.append with random_id
        calling tile_fog.append with (0 to byte)

    # Player position on the screen (pixel coordinates, not tile coordinates)
    var player_position as raylib.Vector2 is with x is 180.0, y is 130.0
    var player_tile_x as int is 0
    var player_tile_y as int is 0

    # Render texture to render fog of war
    # NOTE: To get an automatic smooth-fog effect we use a render texture to render fog
    # at a smaller size (one pixel per tile) and scale it on drawing with bilinear filtering
    var fog_of_war as raylib.RenderTexture is with:
        set .id is 0
        set .texture is with id is 0, width is 0, height is 0, mipmaps is 0, format is 0
        set .depth is with id is 0, width is 0, height is 0, mipmaps is 0, format is 0
    if loaded_fog as raylib.RenderTexture is calling textures.load_render_texture with TILES_X, TILES_Y:
        set fog_of_war is loaded_fog
    defer calling textures.unload_render_texture with fog_of_war

    calling fog_of_war.texture.set_filter with raylib.TEXTURE_FILTER_BILINEAR
    calling fog_of_war.texture.set_wrap with raylib.TEXTURE_WRAP_CLAMP

    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        # Move player around
        if calling input.is_key_down with raylib.KEY_RIGHT:
            set player_position.x is player_position.x + 5.0
        if calling input.is_key_down with raylib.KEY_LEFT:
            set player_position.x is player_position.x - 5.0
        if calling input.is_key_down with raylib.KEY_DOWN:
            set player_position.y is player_position.y + 5.0
        if calling input.is_key_down with raylib.KEY_UP:
            set player_position.y is player_position.y - 5.0

        # Check player position to avoid moving outside tilemap limits
        let max_pos_x as f32 is ((TILES_X * MAP_TILE_SIZE) - PLAYER_SIZE) to f32
        let max_pos_y as f32 is ((TILES_Y * MAP_TILE_SIZE) - PLAYER_SIZE) to f32

        if player_position.x < 0.0:
            set player_position.x is 0.0
        else if (player_position.x + (PLAYER_SIZE to f32)) > ((TILES_X * MAP_TILE_SIZE) to f32):
            set player_position.x is max_pos_x

        if player_position.y < 0.0:
            set player_position.y is 0.0
        else if (player_position.y + (PLAYER_SIZE to f32)) > ((TILES_Y * MAP_TILE_SIZE) to f32):
            set player_position.y is max_pos_y

        # Previous visited tiles are set to partial fog
        for i from 0 to TOTAL_TILES:
            if (tile_fog at i) == (1 to byte):
                set tile_fog at i is 2 to byte

        # Get current tile position from player pixel position
        let half_tile as f32 is (MAP_TILE_SIZE to f32) / 2.0
        set player_tile_x is ((player_position.x + half_tile) / (MAP_TILE_SIZE to f32)) to int
        set player_tile_y is ((player_position.y + half_tile) / (MAP_TILE_SIZE to f32)) to int

        # Check visibility and update fog
        # NOTE: We check tilemap limits to avoid processing tiles out-of-array-bounds
        let min_vy as int is player_tile_y - PLAYER_TILE_VISIBILITY
        let max_vy as int is player_tile_y + PLAYER_TILE_VISIBILITY
        let min_vx as int is player_tile_x - PLAYER_TILE_VISIBILITY
        let max_vx as int is player_tile_x + PLAYER_TILE_VISIBILITY

        for vy from min_vy to max_vy:
            for vx from min_vx to max_vx:
                if (vx >= 0) and (vx < TILES_X) and (vy >= 0) and (vy < TILES_Y):
                    set tile_fog at (vy * TILES_X + vx) is 1 to byte
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        # Draw fog of war to a small render texture for automatic smoothing on scaling
        calling drawing.begin_texture_mode with fog_of_war

        calling drawing.clear_background with raylib.BLANK
        for y from 0 to TILES_Y:
            for x from 0 to TILES_X:
                let state as byte is tile_fog at (y * TILES_X + x)
                if state == (0 to byte):
                    calling shapes.draw_rectangle with x, y, 1, 1, raylib.BLACK
                else if state == (2 to byte):
                    calling shapes.draw_rectangle with x, y, 1, 1, (calling colors.fade with raylib.BLACK, 0.8)

        calling drawing.end_texture_mode

        calling drawing.begin_drawing

        calling drawing.clear_background with raylib.RAYWHITE

        for y from 0 to TILES_Y:
            for x from 0 to TILES_X:
                let tid as byte is tile_ids at (y * TILES_X + x)
                var tile_color as raylib.Color is raylib.BLUE
                if tid != (0 to byte):
                    set tile_color is calling colors.fade with raylib.BLUE, 0.9

                let tx as int is x * MAP_TILE_SIZE
                let ty as int is y * MAP_TILE_SIZE
                calling shapes.draw_rectangle with tx, ty, MAP_TILE_SIZE, MAP_TILE_SIZE, tile_color
                calling shapes.draw_rectangle_lines with tx, ty, MAP_TILE_SIZE, MAP_TILE_SIZE, (calling colors.fade with raylib.DARKBLUE, 0.5)

        # Draw player
        calling shapes.draw_rectangle with (player_position.x to int), (player_position.y to int), PLAYER_SIZE, PLAYER_SIZE, raylib.RED

        # Draw fog of war (scaled to full map, bilinear filtering)
        let src_rec as raylib.Rectangle is with:
            set .x is 0.0
            set .y is 0.0
            set .width is fog_of_war.texture.width to f32
            set .height is -((fog_of_war.texture.height) to f32)
        let dst_rec as raylib.Rectangle is with:
            set .x is 0.0
            set .y is 0.0
            set .width is (TILES_X * MAP_TILE_SIZE) to f32
            set .height is (TILES_Y * MAP_TILE_SIZE) to f32
        let origin as raylib.Vector2 is with x is 0.0, y is 0.0

        calling fog_of_war.texture.draw_pro with src_rec, dst_rec, origin, 0.0, raylib.WHITE

        # Draw player current tile
        calling txt.draw_text with "Current tile: [{player_tile_x},{player_tile_y}]", 10, 10, 20, raylib.RAYWHITE
        calling txt.draw_text with "ARROW KEYS to move", 10, SCREEN_HEIGHT - 25, 20, raylib.RAYWHITE

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
