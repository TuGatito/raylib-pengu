## raylib [textures] example - raw data
##
## Example complexity rating: [★★★☆] 3/4
##
## NOTE: Images are loaded in CPU memory (RAM); textures are loaded in GPU memory (VRAM)
##
## Example originally created with raylib 1.3, last time updated with raylib 3.5
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to idiomatic PenguScript with raw pixel allocation and raylibx wrappers.
##
## ## Example
## ```shell
## pengu run examples/textures/textures_raw_data.pengu
## ```

import pengu.raylib as raylib
import pengu.raylibx.textures as textures
import pengu.raylibx.images as images
import pengu.raylibx.drawing as drawing
import pengu.raylibx.text as txt
import pengu.raylibx.colors as colors
import std.ffi

# --- Entry point ---

## Application main entry point.
weave main into int:
    # Initialization
    # --------------------------------------------------------------------------------------
    let screen_width as int is 800
    let screen_height as int is 450

    calling raylib.InitWindow with screen_width, screen_height, "raylib [textures] example - raw data"
    defer calling raylib.CloseWindow

    # NOTE: Textures MUST be loaded after Window initialization (OpenGL context is required)

    # Load RAW image data (384x512, 32bit RGBA, no file header)
    var fudesumi_raw as raylib.Image is with:
        set .data is calling ffi.null_void
        set .width is 0
        set .height is 0
        set .mipmaps is 0
        set .format is 0
    if loaded_raw as raylib.Image is calling images.load_image_raw with "examples/textures/resources/fudesumi.raw", 384, 512, raylib.PixelFormat.PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, 0:
        set fudesumi_raw is loaded_raw
    else:
        return 1

    var fudesumi as raylib.Texture2D is with id is 0
    if loaded_tex as raylib.Texture2D is calling textures.load_texture_from_image with fudesumi_raw:
        set fudesumi is loaded_tex
    else:
        calling images.unload_image with fudesumi_raw
        return 1
    calling images.unload_image with fudesumi_raw
    defer calling textures.unload_texture with fudesumi

    # Generate a checked texture by code
    let im_width as int is 960
    let im_height as int is 480

    # Dynamic memory allocation to store pixels data (Color type: 4 bytes per pixel)
    let total_bytes as u32 is ((im_width * im_height * 4) to u32)
    let pixels_ptr as ref to byte is transmute (calling raylib.MemAlloc with total_bytes) to (ref to byte)

    for y from 0 to im_height - 1:
        for x from 0 to im_width - 1:
            let idx as int is ((y * im_width) + x) * 4
            if ((((x / 32) + (y / 32)) / 1) % 2) == 0:
                set pixels_ptr at (idx + 0) is raylib.ORANGE.r
                set pixels_ptr at (idx + 1) is raylib.ORANGE.g
                set pixels_ptr at (idx + 2) is raylib.ORANGE.b
                set pixels_ptr at (idx + 3) is raylib.ORANGE.a
            else:
                set pixels_ptr at (idx + 0) is raylib.GOLD.r
                set pixels_ptr at (idx + 1) is raylib.GOLD.g
                set pixels_ptr at (idx + 2) is raylib.GOLD.b
                set pixels_ptr at (idx + 3) is raylib.GOLD.a

    # Load pixels data into an image structure and create texture
    var checked_im as raylib.Image is with:
        set .data is transmute pixels_ptr to (ref to void)
        set .width is im_width
        set .height is im_height
        set .format is (raylib.PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 to int)
        set .mipmaps is 1

    var checked as raylib.Texture2D is with id is 0
    if loaded_chk as raylib.Texture2D is calling textures.load_texture_from_image with checked_im:
        set checked is loaded_chk
    else:
        calling images.unload_image with checked_im
        return 1
    calling images.unload_image with checked_im
    defer calling textures.unload_texture with checked

    calling raylib.SetTargetFPS with 60
    # --------------------------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Draw
        # ----------------------------------------------------------------------------------
        calling drawing.begin_drawing

        calling drawing.clear_background with raylib.RAYWHITE

        let chk_x as int is (screen_width / 2) - (checked.width / 2)
        let chk_y as int is (screen_height / 2) - (checked.height / 2)
        let chk_tint as raylib.Color is calling colors.fade with raylib.WHITE, 0.5
        calling checked.draw with chk_x, chk_y, chk_tint

        calling fudesumi.draw with 430, -30, raylib.WHITE

        calling txt.draw_text with "CHECKED TEXTURE ", 84, 85, 30, raylib.BROWN
        calling txt.draw_text with "GENERATED by CODE", 72, 148, 30, raylib.BROWN
        calling txt.draw_text with "and RAW IMAGE LOADING", 46, 210, 30, raylib.BROWN

        calling txt.draw_text with "(c) Fudesumi sprite by Eiden Marsal", 310, screen_height - 20, 10, raylib.BROWN

        calling drawing.end_drawing
        # ----------------------------------------------------------------------------------

    return 0
