## examples/textures/textures_image_rotate.pengu
## raylib [textures] example - image rotate
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.0, last time updated with raylib 1.0
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2014-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/textures/textures_image_rotate.c` built on top of the
## `raylibx` wrapper layer. Loads the raylib logo image three times, applies
## rotations (45°, 90°, -90°) using `img.rotate`, and uploads them to GPU textures.
##
## ## Example
## ```bash
## pengu run examples/textures/textures_image_rotate.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.images as images
import raylibx.input as input
import raylibx.text as txt
import raylibx.textures as textures

# --- Constants ----------------------------------------------------------
## Screen width in pixels.
const SCREEN_WIDTH as int is 800

## Screen height in pixels.
const SCREEN_HEIGHT as int is 450

## Number of textures to cycle through.
const NUM_TEXTURES as int is 3

## Target frames per second.
const TARGET_FPS as int is 60

# --- Helpers ------------------------------------------------------------
## Loads an image from disk, rotates it by the given angle, creates a GPU texture,
## and releases the CPU image.
##
## ## Parameters
## - `path`: Path to the image file to load.
## - `angle`: Rotation angle in degrees (e.g. 45, 90, -90).
##
## ## Returns
## A `maybe raylib.Texture` containing the loaded texture, or `maybe none` if loading failed.
weave load_rotated_texture with path as string, angle as int into maybe raylib.Texture:
    let maybe_img as maybe raylib.Image is calling images.load_image with path
    if img as raylib.Image is maybe_img:
        var mutable_img as raylib.Image is img
        calling mutable_img.rotate with angle
        let maybe_tex as maybe raylib.Texture is calling textures.load_texture_from_image with mutable_img
        calling images.unload_image with mutable_img
        return maybe_tex
    return maybe none

# --- Entry point --------------------------------------------------------
## Program main entry point. Cycles through rotated textures on mouse click or right arrow key.
##
## ## Returns
## Exit code 0 on success.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [textures] example - image rotate"
    defer calling raylib.CloseWindow

    # NOTE: Textures MUST be loaded after Window initialization (OpenGL context is required)
    let maybe_tex45 as maybe raylib.Texture is calling load_rotated_texture with "examples/textures/resources/raylib_logo.png", 45
    let maybe_tex90 as maybe raylib.Texture is calling load_rotated_texture with "examples/textures/resources/raylib_logo.png", 90
    let maybe_tex_neg90 as maybe raylib.Texture is calling load_rotated_texture with "examples/textures/resources/raylib_logo.png", -90

    if tex0 as raylib.Texture is maybe_tex45:
        defer calling textures.unload_texture with tex0
        if tex1 as raylib.Texture is maybe_tex90:
            defer calling textures.unload_texture with tex1
            if tex2 as raylib.Texture is maybe_tex_neg90:
                defer calling textures.unload_texture with tex2

                var textures_list as list of raylib.Texture is list of raylib.Texture
                defer banish textures_list
                calling textures_list.append with tex0
                calling textures_list.append with tex1
                calling textures_list.append with tex2

                var current_texture as int is 0

                calling raylib.SetTargetFPS with TARGET_FPS
                # -----------------------------------------------------------------

                # Main game loop
                while not calling raylib.WindowShouldClose:
                    # Update
                    # -------------------------------------------------------------
                    if (calling input.is_mouse_button_pressed with raylib.MOUSE_BUTTON_LEFT) or (calling input.is_key_pressed with raylib.KEY_RIGHT):
                        set current_texture is (current_texture + 1) % NUM_TEXTURES
                    # -------------------------------------------------------------

                    # Draw
                    # -------------------------------------------------------------
                    calling drawing.begin_drawing

                    calling drawing.clear_background with raylib.RAYWHITE

                    let current_tex as raylib.Texture is textures_list at current_texture
                    let draw_x as int is (SCREEN_WIDTH / 2) - (current_tex.width / 2)
                    let draw_y as int is (SCREEN_HEIGHT / 2) - (current_tex.height / 2)
                    calling current_tex.draw with draw_x, draw_y, raylib.WHITE

                    calling txt.draw_text with "Press LEFT MOUSE BUTTON to rotate the image clockwise", 250, 420, 10, raylib.DARKGRAY

                    calling drawing.end_drawing
                    # -------------------------------------------------------------

    return 0
