## examples/textures/textures_mouse_painting.pengu
## raylib [textures] example - mouse painting
##
## Example complexity rating: [★★★☆] 3/4
##
## Example originally created with raylib 3.0, last time updated with raylib 6.0
## Contributed by Chris Dill (@MysteriousSpace) and reviewed by Ramon Santamaria (@raysan5)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2019-2025 Chris Dill (@MysteriousSpace) and Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/textures/textures_mouse_painting.c` built on top of the
## `raylibx` wrapper layer. Implements an interactive painting canvas with color palette
## selection, adjustable brush radius, canvas clearing, and image exporting.
##
## ## Example
## ```bash
## pengu run examples/textures/textures_mouse_painting.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.images as images
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.text as txt
import raylibx.textures as textures

# --- Constants ----------------------------------------------------------
## Screen width in pixels.
const SCREEN_WIDTH as int is 800

## Screen height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 120

## Number of selectable colors in the palette.
const MAX_COLORS_COUNT as int is 23

# --- Entry point --------------------------------------------------------
## Program main entry point. Runs the interactive canvas painting tool.
##
## ## Returns
## Exit code 0 on success.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [textures] example - mouse painting"
    defer calling raylib.CloseWindow

    # Colors to choose from
    let color_list as list of raylib.Color is [
        raylib.RAYWHITE, raylib.YELLOW, raylib.GOLD, raylib.ORANGE, raylib.PINK, raylib.RED,
        raylib.MAROON, raylib.GREEN, raylib.LIME, raylib.DARKGREEN, raylib.SKYBLUE, raylib.BLUE,
        raylib.DARKBLUE, raylib.PURPLE, raylib.VIOLET, raylib.DARKPURPLE, raylib.BEIGE, raylib.BROWN,
        raylib.DARKBROWN, raylib.LIGHTGRAY, raylib.GRAY, raylib.DARKGRAY, raylib.BLACK
    ]
    defer banish color_list

    # Define color palette rectangle buttons
    var recs_list as list of raylib.Rectangle is list of raylib.Rectangle
    defer banish recs_list

    for i from 0 to MAX_COLORS_COUNT:
        let rx as f32 is 10.0 + (30.0 * (i to f32)) + (2.0 * (i to f32))
        let rec as raylib.Rectangle is with x is rx, y is 10.0, width is 30.0, height is 30.0
        calling recs_list.append with rec

    var color_selected as int is 0
    var color_selected_prev as int is color_selected
    var color_mouse_hover as int is 0
    var brush_radius as f32 is 20.0
    var mouse_was_pressed as bool is false

    let btn_save_rec as raylib.Rectangle is with x is 750.0, y is 10.0, width is 40.0, height is 30.0
    var btn_save_mouse_hover as bool is false
    var show_save_message as bool is false
    var save_message_counter as int is 0

    # Create a RenderTexture2D to use as a canvas
    let maybe_target as maybe raylib.RenderTexture is calling textures.load_render_texture with SCREEN_WIDTH, SCREEN_HEIGHT
    if target as raylib.RenderTexture is maybe_target:
        defer calling textures.unload_render_texture with target

        # Clear render texture before entering the game loop
        calling drawing.begin_texture_mode with target
        calling drawing.clear_background with (color_list at 0)
        calling drawing.end_texture_mode

        calling raylib.SetTargetFPS with TARGET_FPS
        # -----------------------------------------------------------------

        # Main game loop
        while not calling raylib.WindowShouldClose:
            # Update
            # -------------------------------------------------------------
            let mouse_pos as raylib.Vector2 is calling raylib.GetMousePosition

            # Move between colors with keys
            if calling input.is_key_pressed with raylib.KEY_RIGHT:
                set color_selected is color_selected + 1
            else:
                if calling input.is_key_pressed with raylib.KEY_LEFT:
                    set color_selected is color_selected - 1

            if color_selected >= MAX_COLORS_COUNT:
                set color_selected is MAX_COLORS_COUNT - 1
            else:
                if color_selected < 0:
                    set color_selected is 0

            # Choose color with mouse
            set color_mouse_hover is -1
            for j from 0 to MAX_COLORS_COUNT:
                let r as raylib.Rectangle is recs_list at j
                if calling r.contains_point with mouse_pos:
                    set color_mouse_hover is j
                    break

            if (color_mouse_hover >= 0) and (calling input.is_mouse_button_pressed with raylib.MOUSE_BUTTON_LEFT):
                set color_selected is color_mouse_hover
                set color_selected_prev is color_selected

            # Change brush size
            set brush_radius is brush_radius + ((calling raylib.GetMouseWheelMove) * 5.0)
            if brush_radius < 2.0:
                set brush_radius is 2.0
            if brush_radius > 50.0:
                set brush_radius is 50.0

            if calling input.is_key_pressed with raylib.KEY_C:
                # Clear render texture to background color
                calling drawing.begin_texture_mode with target
                calling drawing.clear_background with (color_list at 0)
                calling drawing.end_texture_mode

            if (calling input.is_mouse_button_down with raylib.MOUSE_BUTTON_LEFT) or (calling input.is_gesture_detected with raylib.GESTURE_DRAG):
                # Paint circle into render texture
                calling drawing.begin_texture_mode with target
                if mouse_pos.y > 50.0:
                    calling shapes.draw_circle with (mouse_pos.x to int), (mouse_pos.y to int), brush_radius, (color_list at color_selected)
                calling drawing.end_texture_mode

            if calling input.is_mouse_button_down with raylib.MOUSE_BUTTON_RIGHT:
                if not mouse_was_pressed:
                    set color_selected_prev is color_selected
                    set color_selected is 0
                set mouse_was_pressed is true

                # Erase circle from render texture
                calling drawing.begin_texture_mode with target
                if mouse_pos.y > 50.0:
                    calling shapes.draw_circle with (mouse_pos.x to int), (mouse_pos.y to int), brush_radius, (color_list at 0)
                calling drawing.end_texture_mode
            else:
                if (calling input.is_mouse_button_released with raylib.MOUSE_BUTTON_RIGHT) and mouse_was_pressed:
                    set color_selected is color_selected_prev
                    set mouse_was_pressed is false

            # Check mouse hover save button
            set btn_save_mouse_hover is calling btn_save_rec.contains_point with mouse_pos

            # Image saving logic
            if (btn_save_mouse_hover and (calling input.is_mouse_button_released with raylib.MOUSE_BUTTON_LEFT)) or (calling input.is_key_pressed with raylib.KEY_S):
                let maybe_image as maybe raylib.Image is calling images.load_image_from_texture with target.texture
                if image as raylib.Image is maybe_image:
                    var mutable_image as raylib.Image is image
                    calling mutable_image.flip_vertical
                    let _saved as bool is calling images.export_image with mutable_image, "my_amazing_texture_painting.png"
                    calling images.unload_image with mutable_image
                    set show_save_message is true

            if show_save_message:
                # On saving, show a full screen message for 2 seconds
                set save_message_counter is save_message_counter + 1
                if save_message_counter > 240:
                    set show_save_message is false
                    set save_message_counter is 0
            # -------------------------------------------------------------

            # Draw
            # -------------------------------------------------------------
            calling drawing.begin_drawing

            calling drawing.clear_background with raylib.RAYWHITE

            # Render texture must be y-flipped due to default OpenGL coordinates (left-bottom)
            let canvas_rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is (target.texture.width to f32), height is (-(target.texture.height to f32))
            let canvas_pos as raylib.Vector2 is with x is 0.0, y is 0.0
            let canvas_tex as raylib.Texture is target.texture
            calling canvas_tex.draw_rec with canvas_rec, canvas_pos, raylib.WHITE

            # Draw drawing circle for reference
            if mouse_pos.y > 50.0:
                if calling input.is_mouse_button_down with raylib.MOUSE_BUTTON_RIGHT:
                    calling shapes.draw_circle_lines with (mouse_pos.x to int), (mouse_pos.y to int), brush_radius, raylib.GRAY
                else:
                    calling shapes.draw_circle with (calling raylib.GetMouseX), (calling raylib.GetMouseY), brush_radius, (color_list at color_selected)

            # Draw top panel
            calling shapes.draw_rectangle with 0, 0, (calling raylib.GetScreenWidth), 50, raylib.RAYWHITE
            calling shapes.draw_line with 0, 50, (calling raylib.GetScreenWidth), 50, raylib.LIGHTGRAY

            # Draw color selection rectangles
            for k from 0 to MAX_COLORS_COUNT:
                let rk as raylib.Rectangle is recs_list at k
                calling rk.draw with (color_list at k)
            calling shapes.draw_rectangle_lines with 10, 10, 30, 30, raylib.LIGHTGRAY

            if color_mouse_hover >= 0:
                let hover_r as raylib.Rectangle is recs_list at color_mouse_hover
                calling hover_r.draw with (calling colors.fade with raylib.WHITE, 0.6)

            let sel_r as raylib.Rectangle is recs_list at color_selected
            let sel_outline as raylib.Rectangle is with:
                set .x is sel_r.x - 2.0
                set .y is sel_r.y - 2.0
                set .width is sel_r.width + 4.0
                set .height is sel_r.height + 4.0
            calling sel_outline.draw_outline with 2.0, raylib.BLACK

            # Draw save image button
            var btn_color as raylib.Color is raylib.BLACK
            if btn_save_mouse_hover:
                set btn_color is raylib.RED
            calling btn_save_rec.draw_outline with 2.0, btn_color
            calling txt.draw_text with "SAVE!", 755, 20, 10, btn_color

            # Draw save image message
            if show_save_message:
                calling shapes.draw_rectangle with 0, 0, (calling raylib.GetScreenWidth), (calling raylib.GetScreenHeight), (calling colors.fade with raylib.RAYWHITE, 0.8)
                calling shapes.draw_rectangle with 0, 150, (calling raylib.GetScreenWidth), 80, raylib.BLACK
                calling txt.draw_text with "IMAGE SAVED!", 150, 180, 20, raylib.RAYWHITE

            calling drawing.end_drawing
            # -------------------------------------------------------------

    return 0
