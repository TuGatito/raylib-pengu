## examples/shaders/shaders_basic_lighting.pengu
## raylib [shaders] example - basic lighting
##
## Example complexity rating: [★★★★] 4/4
##
## Example originally created with raylib 3.0, last time updated with raylib 4.2
##
## Example contributed by Chris Camacho (@chriscamacho) and reviewed by Ramon Santamaria (@raysan5)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2019-2025 Chris Camacho (@chriscamacho) and Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Port of `examples/shaders/shaders_basic_lighting.c` demonstrating a multi-light
## Phong lighting shader with four togglable colored point lights and orbital camera.
##
## Light data structures and shader location query functions are implemented directly
## in PenguScript using `omen LightType`, `rune Light`, and wrappers from `raylibx.shaders`,
## `raylibx.drawing`, `raylibx.shapes3d`, `raylibx.colors`, `rcamerax`, and `raylibx.input`.
##
## ## Example
## ```bash
## pengu run examples/shaders/shaders_basic_lighting.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shaders as shaders
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import rcamerax

# --- Constants ----------------------------------------------------------
## Screen width in pixels.
const SCREEN_WIDTH as int is 800

## Screen height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Maximum number of dynamic lights supported by the shader.
const MAX_LIGHTS as int is 4

# --- Types --------------------------------------------------------------
## Light source type classification.
omen LightType:
    Directional
    Point

## Dynamic light data for shader uniform binding.
rune Light:
    type as int
    enabled as bool
    position as raylib.Vector3
    target as raylib.Vector3
    color as raylib.Color
    attenuation as f32
    enabled_loc as int
    type_loc as int
    position_loc as int
    target_loc as int
    color_loc as int
    attenuation_loc as int

# --- Light Helpers ------------------------------------------------------
## Sends updated light properties to the lighting shader.
##
## ## Parameters
## - `shader`: The active lighting shader.
## - `light`: The light struct whose values will be updated in shader uniforms.
weave update_light_values with shader as raylib.Shader, light as Light into void:
    calling shader.set_int with light.enabled_loc, (if light.enabled then 1 else 0)
    calling shader.set_int with light.type_loc, light.type
    calling shader.set_vec3 with light.position_loc, light.position
    calling shader.set_vec3 with light.target_loc, light.target

    let col_vec as raylib.Vector4 is with:
        set .x is ((light.color.r to f32) / 255.0)
        set .y is ((light.color.g to f32) / 255.0)
        set .z is ((light.color.b to f32) / 255.0)
        set .w is ((light.color.a to f32) / 255.0)
    calling shader.set_vec4 with light.color_loc, col_vec

## Creates a dynamic light and queries its uniform locations within the shader.
##
## ## Parameters
## - `light_index`: Index of this light in the shader lights array.
## - `light_type`: Type of light (`LightType.Point` or `LightType.Directional`).
## - `position`: 3D position of the light source.
## - `target`: Target look-at direction for directional lights.
## - `color`: Emitted light color.
## - `shader`: The target shader.
##
## ## Returns
## Initialized `Light` struct with queried shader locations.
weave create_light with light_index as int, light_type as int, position as raylib.Vector3, target as raylib.Vector3, color as raylib.Color, shader as raylib.Shader into Light:
    var light as Light is with:
        set .enabled is true
        set .type is light_type
        set .position is position
        set .target is target
        set .color is color
        set .attenuation is 0.0
        set .enabled_loc is -1
        set .type_loc is -1
        set .position_loc is -1
        set .target_loc is -1
        set .color_loc is -1
        set .attenuation_loc is -1

    let s_en as string is "lights[{light_index}].enabled"
    let s_ty as string is "lights[{light_index}].type"
    let s_pos as string is "lights[{light_index}].position"
    let s_tar as string is "lights[{light_index}].target"
    let s_col as string is "lights[{light_index}].color"
    defer banish s_en
    defer banish s_ty
    defer banish s_pos
    defer banish s_tar
    defer banish s_col

    if loc as int is calling shader.location with s_en:
        set light.enabled_loc is loc
    if loc as int is calling shader.location with s_ty:
        set light.type_loc is loc
    if loc as int is calling shader.location with s_pos:
        set light.position_loc is loc
    if loc as int is calling shader.location with s_tar:
        set light.target_loc is loc
    if loc as int is calling shader.location with s_col:
        set light.color_loc is loc

    return light

# --- Entry Point --------------------------------------------------------
## Program main entry point.
##
## Sets up the 3D scene with orbital camera, loads vertex and fragment lighting
## shaders, configures 4 colored point lights, and handles user input to toggle
## each light individually.
##
## ## Returns
## Exit status code (`0` on clean shutdown, `1` if shader loading fails).
weave main into int:
    # Initialization
    calling raylib.SetConfigFlags with raylib.FLAG_MSAA_4X_HINT
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [shaders] example - basic lighting"
    defer calling raylib.CloseWindow

    # Define camera to look into our 3D world
    var camera as raylib.Camera3D is with:
        set .position is (with x is 2.0, y is 4.0, z is 6.0)
        set .target is (with x is 0.0, y is 0.5, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is 45.0
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    # Load basic lighting shader
    let vs_path as string is "examples/shaders/resources/shaders/glsl330/lighting.vs"
    let fs_path as string is "examples/shaders/resources/shaders/glsl330/lighting.fs"
    var shader as raylib.Shader is with id is 0
    let shader_opt as maybe raylib.Shader is calling shaders.load_shader with vs_path, fs_path
    if loaded_shader as raylib.Shader is shader_opt:
        set shader is loaded_shader
        defer calling shaders.unload_shader with shader

        # Get some required shader locations
        if loc as int is calling shader.location with "viewPos":
            set shader.locs at (raylib.SHADER_LOC_VECTOR_VIEW to int) is loc

        # Ambient light level (some basic lighting)
        if ambient_loc as int is calling shader.location with "ambient":
            let amb_vec as raylib.Vector4 is with x is 0.1, y is 0.1, z is 0.1, w is 1.0
            calling shader.set_vec4 with ambient_loc, amb_vec

        # Create lights
        var lights as list of Light is []
        defer banish lights

        var zero as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0
        calling lights.append with (calling create_light with 0, (LightType.Point to int), (with x is -2.0, y is 1.0, z is -2.0), zero, raylib.YELLOW, shader)
        calling lights.append with (calling create_light with 1, (LightType.Point to int), (with x is 2.0, y is 1.0, z is 2.0), zero, raylib.RED, shader)
        calling lights.append with (calling create_light with 2, (LightType.Point to int), (with x is -2.0, y is 1.0, z is 2.0), zero, raylib.GREEN, shader)
        calling lights.append with (calling create_light with 3, (LightType.Point to int), (with x is 2.0, y is 1.0, z is -2.0), zero, raylib.BLUE, shader)

        calling raylib.SetTargetFPS with TARGET_FPS

        # Main game loop
        while not calling raylib.WindowShouldClose:
            # Update
            calling raylib.UpdateCamera with (sigil of camera), (raylib.CAMERA_ORBITAL to int)

            # Update the shader with the camera view position
            let view_loc as int is shader.locs at (raylib.SHADER_LOC_VECTOR_VIEW to int)
            calling shader.set_vec3 with view_loc, camera.position

            # Check key inputs to enable/disable lights
            if calling input.is_key_pressed with raylib.KEY_Y:
                var l0 as Light is lights at 0
                set l0.enabled is not l0.enabled
                set lights at 0 is l0

            if calling input.is_key_pressed with raylib.KEY_R:
                var l1 as Light is lights at 1
                set l1.enabled is not l1.enabled
                set lights at 1 is l1

            if calling input.is_key_pressed with raylib.KEY_G:
                var l2 as Light is lights at 2
                set l2.enabled is not l2.enabled
                set lights at 2 is l2

            if calling input.is_key_pressed with raylib.KEY_B:
                var l3 as Light is lights at 3
                set l3.enabled is not l3.enabled
                set lights at 3 is l3

            # Update light values
            for i from 0 to MAX_LIGHTS:
                calling update_light_values with shader, (lights at i)

            # Draw
            calling drawing.begin_drawing
            calling drawing.clear_background with raylib.RAYWHITE

            calling drawing.begin_mode_3d with camera

            calling drawing.begin_shader_mode with shader
            let plane_extent as raylib.Vector2 is with x is 10.0, y is 10.0
            calling zero.draw_plane with plane_extent, raylib.WHITE
            let cube_extent as raylib.Vector3 is with x is 2.0, y is 4.0, z is 2.0
            calling zero.draw_cube with cube_extent, raylib.WHITE
            calling drawing.end_shader_mode

            # Draw spheres to show where the lights are
            for i from 0 to MAX_LIGHTS:
                let lt as Light is lights at i
                if lt.enabled:
                    calling raylib.DrawSphereEx with lt.position, 0.2, 8, 8, lt.color
                else:
                    calling shapes3d.draw_sphere_wires with lt.position, 0.2, 8, 8, (calling colors.fade with lt.color, 0.3)

            calling shapes3d.draw_grid with 10, 1.0

            calling drawing.end_mode_3d

            calling txt.draw_fps with 10, 10
            calling txt.draw_text with "Use keys [Y][R][G][B] to toggle lights", 10, 40, 20, raylib.DARKGRAY

            calling drawing.end_drawing

        return 0

    return 1
