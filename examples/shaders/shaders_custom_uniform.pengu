## examples/shaders/shaders_custom_uniform.pengu
## raylib [shaders] example - custom uniform
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.3, last time updated with raylib 4.0
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Port of `examples/shaders/shaders_custom_uniform.c` demonstrating how to pass
## custom uniforms (mouse swirl center vector) to a post-processing fragment shader
## processing a 3D scene rendered offscreen to a `RenderTexture2D`.
##
## Uses wrappers from `raylibx.models`, `raylibx.textures`, `raylibx.shaders`,
## `raylibx.drawing`, `raylibx.shapes3d`, `raylibx.input`, and `raylibx.text`.
##
## ## Example
## ```bash
## pengu run examples/shaders/shaders_custom_uniform.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.models as models
import raylibx.shaders as shaders
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import raylibx.textures as textures

# --- Constants ----------------------------------------------------------
## Screen width in pixels.
const SCREEN_WIDTH as int is 800

## Screen height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

# --- Entry Point --------------------------------------------------------
## Program main entry point.
##
## Initializes the window, loads a 3D OBJ model with diffuse texture, compiles
## the swirl post-processing shader, and runs the rendering loop tracking mouse
## coordinates as a uniform vector.
##
## ## Returns
## Exit status code (`0` for success, `1` if asset loading fails).
weave main into int:
    # Initialization
    calling raylib.SetConfigFlags with raylib.FLAG_MSAA_4X_HINT
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [shaders] example - custom uniform"
    defer calling raylib.CloseWindow

    # Define camera to look into our 3D world
    var camera as raylib.Camera3D is with:
        set .position is (with x is 8.0, y is 8.0, z is 8.0)
        set .target is (with x is 0.0, y is 1.5, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is 45.0
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    # Load 3D model
    let model_opt as maybe raylib.Model is calling models.load_model with "examples/shaders/resources/models/barracks.obj"
    let tex_opt as maybe raylib.Texture2D is calling textures.load_texture with "examples/shaders/resources/models/barracks_diffuse.png"

    if model_val as raylib.Model is model_opt:
        var model as raylib.Model is model_val
        defer calling models.unload_model with model

        if texture as raylib.Texture2D is tex_opt:
            defer calling textures.unload_texture with texture

            # Assign diffuse texture to model material
            var mat as ref to raylib.Material is sigil of (model.materials at 0)
            var diff_map as ref to raylib.MaterialMap is sigil of (mat->maps at (raylib.MATERIAL_MAP_DIFFUSE to int))
            set diff_map->texture is texture

            let position as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0

            # Load postprocessing shader
            let shdr_path as string is "examples/shaders/resources/shaders/glsl330/swirl.fs"
            let shdr_opt as maybe raylib.Shader is calling shaders.load_fragment_shader with shdr_path
            if shader as raylib.Shader is shdr_opt:
                defer calling shaders.unload_shader with shader

                var swirl_center_loc as int is -1
                if loc as int is calling shader.location with "center":
                    set swirl_center_loc is loc

                var swirl_center as raylib.Vector2 is with:
                    set .x is (SCREEN_WIDTH to f32) / 2.0
                    set .y is (SCREEN_HEIGHT to f32) / 2.0

                # Create render texture for offscreen rendering
                let target_opt as maybe raylib.RenderTexture2D is calling textures.load_render_texture with SCREEN_WIDTH, SCREEN_HEIGHT
                if target as raylib.RenderTexture2D is target_opt:
                    defer calling textures.unload_render_texture with target

                    calling raylib.SetTargetFPS with TARGET_FPS

                    # Main game loop
                    while not calling raylib.WindowShouldClose:
                        # Update
                        calling raylib.UpdateCamera with (sigil of camera), (raylib.CAMERA_ORBITAL to int)

                        let mouse_pos as raylib.Vector2 is calling raylib.GetMousePosition
                        set swirl_center.x is mouse_pos.x
                        set swirl_center.y is (SCREEN_HEIGHT to f32) - mouse_pos.y

                        # Send new uniform value to shader
                        calling shader.set_vec2 with swirl_center_loc, swirl_center

                        # Draw offscreen scene into render texture
                        calling drawing.begin_texture_mode with target
                        calling drawing.clear_background with raylib.RAYWHITE

                        calling drawing.begin_mode_3d with camera
                        calling model.draw with position, 0.5, raylib.WHITE
                        calling shapes3d.draw_grid with 10, 1.0
                        calling drawing.end_mode_3d

                        calling txt.draw_text with "TEXT DRAWN IN RENDER TEXTURE", 200, 10, 30, raylib.RED
                        calling drawing.end_texture_mode

                        # Draw postprocessed texture to screen
                        calling drawing.begin_drawing
                        calling drawing.clear_background with raylib.RAYWHITE

                        calling drawing.begin_shader_mode with shader
                        var src_rec as raylib.Rectangle is with:
                            set .x is 0.0
                            set .y is 0.0
                            set .width is target.texture.width to f32
                            set .height is -(target.texture.height to f32)
                        var dst_pos as raylib.Vector2 is with:
                            set .x is 0.0
                            set .y is 0.0
                        calling target.texture.draw_rec with src_rec, dst_pos, raylib.WHITE
                        calling drawing.end_shader_mode

                        calling txt.draw_text with "(c) Barracks 3D model by Alberto Cano", SCREEN_WIDTH - 220, SCREEN_HEIGHT - 20, 10, raylib.GRAY
                        calling txt.draw_fps with 10, 10

                        calling drawing.end_drawing

                    return 0

    return 1
