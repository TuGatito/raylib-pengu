## examples/shaders/shaders_deferred_rendering.pengu
## raylib [shaders] example - deferred rendering
##
## Example complexity rating: [★★★★] 4/4
##
## Example originally created with raylib 4.5, last time updated with raylib 4.5
##
## Example contributed by Justin Andreas Lacoste (@27justin) and reviewed by Ramon Santamaria (@raysan5)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2023-2025 Justin Andreas Lacoste (@27justin)
##
## ## PenguScript Port
## Port of `examples/shaders/shaders_deferred_rendering.c` demonstrating a deferred
## rendering pipeline using a multiple-render-target (MRT) Geometry Buffer (G-buffer)
## implemented via `rlgl` framebuffers and textures.
##
## The scene's positions, normals, and albedo/specular components are rendered in
## a single geometry pass, then resolved in a lighting pass with dynamic point lights.
##
## ## Example
## ```bash
## pengu run examples/shaders/shaders_deferred_rendering.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.models as models
import raylibx.random as random
import raylibx.shaders as shaders
import raylibx.shapes as shapes
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import raylibx.textures as textures
import rlgl
import std.ffi as ffi

# --- Constants ----------------------------------------------------------
## Screen width in pixels.
const SCREEN_WIDTH as int is 800

## Screen height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Total number of cubes scattered in the scene.
const MAX_CUBES as int is 30

## Maximum number of dynamic lights supported by shader.
const MAX_LIGHTS as int is 4

# --- Types --------------------------------------------------------------
## Geometry Buffer texture and framebuffer handles.
rune GBuffer:
    framebuffer_id as u32
    position_texture_id as u32
    normal_texture_id as u32
    albedo_spec_texture_id as u32
    depth_renderbuffer_id as u32

## Visualization modes for viewing individual G-buffer targets or final shading.
omen DeferredMode:
    Position
    Normal
    Albedo
    Shading

## Cube instance data.
rune CubeInstance:
    position as raylib.Vector3
    rotation as f32

## Light source type classification.
omen LightType:
    Directional
    Point

## Dynamic light parameters for uniform binding.
rune Light:
    type as int
    enabled as bool
    position as raylib.Vector3
    target as raylib.Vector3
    color as raylib.Color
    attenuation as f32
    enabled_loc as int
    type_loc as int
    position_loc as int
    target_loc as int
    color_loc as int
    attenuation_loc as int

# --- Light Helpers ------------------------------------------------------
## Uploads light parameters to the deferred lighting shader.
##
## ## Parameters
## - `shader`: The active deferred shader.
## - `light`: The light struct whose values will be updated in shader uniforms.
weave update_light_values with shader as raylib.Shader, light as Light into void:
    calling shader.set_int with light.enabled_loc, (if light.enabled then 1 else 0)
    calling shader.set_int with light.type_loc, light.type
    calling shader.set_vec3 with light.position_loc, light.position
    calling shader.set_vec3 with light.target_loc, light.target

    let col_vec as raylib.Vector4 is with:
        set .x is ((light.color.r to f32) / 255.0)
        set .y is ((light.color.g to f32) / 255.0)
        set .z is ((light.color.b to f32) / 255.0)
        set .w is ((light.color.a to f32) / 255.0)
    calling shader.set_vec4 with light.color_loc, col_vec

## Creates a dynamic light and queries uniform locations in the shader.
##
## ## Parameters
## - `light_index`: Index of this light in the shader lights array.
## - `light_type`: Classification of the light (`LightType.Point` or `LightType.Directional`).
## - `position`: 3D position of the light source.
## - `target`: Target look-at direction.
## - `color`: Emitted light color.
## - `shader`: The target deferred shader.
##
## ## Returns
## Initialized `Light` struct.
weave create_light with light_index as int, light_type as int, position as raylib.Vector3, target as raylib.Vector3, color as raylib.Color, shader as raylib.Shader into Light:
    var light as Light is with:
        set .enabled is true
        set .type is light_type
        set .position is position
        set .target is target
        set .color is color
        set .attenuation is 0.0
        set .enabled_loc is -1
        set .type_loc is -1
        set .position_loc is -1
        set .target_loc is -1
        set .color_loc is -1
        set .attenuation_loc is -1

    let s_en as string is "lights[{light_index}].enabled"
    let s_ty as string is "lights[{light_index}].type"
    let s_pos as string is "lights[{light_index}].position"
    let s_tar as string is "lights[{light_index}].target"
    let s_col as string is "lights[{light_index}].color"
    defer banish s_en
    defer banish s_ty
    defer banish s_pos
    defer banish s_tar
    defer banish s_col

    if loc as int is calling shader.location with s_en: set light.enabled_loc is loc
    if loc as int is calling shader.location with s_ty: set light.type_loc is loc
    if loc as int is calling shader.location with s_pos: set light.position_loc is loc
    if loc as int is calling shader.location with s_tar: set light.target_loc is loc
    if loc as int is calling shader.location with s_col: set light.color_loc is loc

    calling update_light_values with shader, light
    return light

# --- Entry Point --------------------------------------------------------
## Program main entry point.
##
## Allocates the G-Buffer with MRT (positions, normals, albedos, and depth),
## renders the 3D scene into the G-Buffer, resolves lighting via deferred shading,
## and copies depth for forward-rendered light gizmos.
##
## ## Returns
## Exit status code (`0` for success, `1` if shaders fail to load).
weave main into int:
    # Initialization
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [shaders] example - deferred rendering"
    defer calling raylib.CloseWindow

    var camera as raylib.Camera3D is with:
        set .position is (with x is 5.0, y is 4.0, z is 5.0)
        set .target is (with x is 0.0, y is 1.0, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is 60.0
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    # Load plane and cube models from generated meshes
    var model as raylib.Model is calling raylib.LoadModelFromMesh with (calling raylib.GenMeshPlane with 10.0, 10.0, 3, 3)
    defer calling models.unload_model with model

    var cube as raylib.Model is calling raylib.LoadModelFromMesh with (calling raylib.GenMeshCube with 2.0, 2.0, 2.0)
    defer calling models.unload_model with cube

    # Load G-buffer shader and deferred lighting shader
    let gb_vs as string is "examples/shaders/resources/shaders/glsl330/gbuffer.vs"
    let gb_fs as string is "examples/shaders/resources/shaders/glsl330/gbuffer.fs"
    let def_vs as string is "examples/shaders/resources/shaders/glsl330/deferred_shading.vs"
    let def_fs as string is "examples/shaders/resources/shaders/glsl330/deferred_shading.fs"

    var gbuffer_shader as raylib.Shader is with id is 0
    var deferred_shader as raylib.Shader is with id is 0

    let gb_opt as maybe raylib.Shader is calling shaders.load_shader with gb_vs, gb_fs
    let def_opt as maybe raylib.Shader is calling shaders.load_shader with def_vs, def_fs

    if gb_val as raylib.Shader is gb_opt:
        set gbuffer_shader is gb_val
        defer calling shaders.unload_shader with gbuffer_shader

        if def_val as raylib.Shader is def_opt:
            set deferred_shader is def_val
            defer calling shaders.unload_shader with deferred_shader

            if loc as int is calling deferred_shader.location with "viewPosition":
                set deferred_shader.locs at (raylib.SHADER_LOC_VECTOR_VIEW to int) is loc

            # Initialize G-Buffer
            var gbuffer as GBuffer is with:
                set .framebuffer_id is calling rlgl.rlLoadFramebuffer
                set .position_texture_id is 0
                set .normal_texture_id is 0
                set .albedo_spec_texture_id is 0
                set .depth_renderbuffer_id is 0

            calling rlgl.rlEnableFramebuffer with gbuffer.framebuffer_id

            let null_ptr as ref to frozen void is transmute (calling ffi.null_void) to ref to frozen void
            let fmt_r16 as int is rlgl.rlPixelFormat.RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16 to int
            let fmt_r8 as int is rlgl.rlPixelFormat.RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 to int

            set gbuffer.position_texture_id is calling rlgl.rlLoadTexture with null_ptr, SCREEN_WIDTH, SCREEN_HEIGHT, fmt_r16, 1
            set gbuffer.normal_texture_id is calling rlgl.rlLoadTexture with null_ptr, SCREEN_WIDTH, SCREEN_HEIGHT, fmt_r16, 1
            set gbuffer.albedo_spec_texture_id is calling rlgl.rlLoadTexture with null_ptr, SCREEN_WIDTH, SCREEN_HEIGHT, fmt_r8, 1

            # Activate 3 color draw buffers
            calling rlgl.rlActiveDrawBuffers with 3

            let att_ch0 as int is rlgl.rlFramebufferAttachType.RL_ATTACHMENT_COLOR_CHANNEL0 to int
            let att_ch1 as int is rlgl.rlFramebufferAttachType.RL_ATTACHMENT_COLOR_CHANNEL1 to int
            let att_ch2 as int is rlgl.rlFramebufferAttachType.RL_ATTACHMENT_COLOR_CHANNEL2 to int
            let att_depth as int is rlgl.rlFramebufferAttachType.RL_ATTACHMENT_DEPTH to int
            let att_tex2d as int is rlgl.rlFramebufferAttachTextureType.RL_ATTACHMENT_TEXTURE2D to int
            let att_rbo as int is rlgl.rlFramebufferAttachTextureType.RL_ATTACHMENT_RENDERBUFFER to int

            calling rlgl.rlFramebufferAttach with gbuffer.framebuffer_id, gbuffer.position_texture_id, att_ch0, att_tex2d, 0
            calling rlgl.rlFramebufferAttach with gbuffer.framebuffer_id, gbuffer.normal_texture_id, att_ch1, att_tex2d, 0
            calling rlgl.rlFramebufferAttach with gbuffer.framebuffer_id, gbuffer.albedo_spec_texture_id, att_ch2, att_tex2d, 0

            # Attach depth buffer
            set gbuffer.depth_renderbuffer_id is calling rlgl.rlLoadTextureDepth with SCREEN_WIDTH, SCREEN_HEIGHT, true
            calling rlgl.rlFramebufferAttach with gbuffer.framebuffer_id, gbuffer.depth_renderbuffer_id, att_depth, att_rbo, 0

            # Verify framebuffer completeness
            let _complete as bool is calling rlgl.rlFramebufferComplete with gbuffer.framebuffer_id

            # Bind sampler uniforms in deferred shader
            calling rlgl.rlEnableShader with deferred_shader.id
            let tex_unit_pos as int is 0
            let tex_unit_norm as int is 1
            let tex_unit_albedo as int is 2

            let smp_type as int is rlgl.rlShaderUniformDataType.RL_SHADER_UNIFORM_SAMPLER2D to int
            if loc as int is calling deferred_shader.location with "gPosition":
                calling raylib.SetShaderValue with deferred_shader, loc, (sigil of tex_unit_pos), smp_type
            if loc as int is calling deferred_shader.location with "gNormal":
                calling raylib.SetShaderValue with deferred_shader, loc, (sigil of tex_unit_norm), smp_type
            if loc as int is calling deferred_shader.location with "gAlbedoSpec":
                calling raylib.SetShaderValue with deferred_shader, loc, (sigil of tex_unit_albedo), smp_type
            calling rlgl.rlDisableShader

            # Assign G-buffer shader to model materials
            var model_mat as ref to raylib.Material is sigil of (model.materials at 0)
            set model_mat->shader is gbuffer_shader
            var cube_mat as ref to raylib.Material is sigil of (cube.materials at 0)
            set cube_mat->shader is gbuffer_shader

            # Create lights
            var lights as list of Light is []
            defer banish lights

            let zero as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0
            calling lights.append with (calling create_light with 0, (LightType.Point to int), (with x is -2.0, y is 1.0, z is -2.0), zero, raylib.YELLOW, deferred_shader)
            calling lights.append with (calling create_light with 1, (LightType.Point to int), (with x is 2.0, y is 1.0, z is 2.0), zero, raylib.RED, deferred_shader)
            calling lights.append with (calling create_light with 2, (LightType.Point to int), (with x is -2.0, y is 1.0, z is 2.0), zero, raylib.GREEN, deferred_shader)
            calling lights.append with (calling create_light with 3, (LightType.Point to int), (with x is 2.0, y is 1.0, z is -2.0), zero, raylib.BLUE, deferred_shader)

            # Generate cubes
            var cubes as list of CubeInstance is []
            defer banish cubes

            for i from 0 to MAX_CUBES:
                var pos as raylib.Vector3 is with:
                    set .x is ((calling random.between with 0, 10) to f32) - 5.0
                    set .y is ((calling random.between with 0, 5) to f32)
                    set .z is ((calling random.between with 0, 10) to f32) - 5.0
                var c as CubeInstance is with:
                    set .position is pos
                    set .rotation is (calling random.between with 0, 360) to f32
                calling cubes.append with c

            var mode as DeferredMode is DeferredMode.Shading
            calling rlgl.rlEnableDepthTest
            calling raylib.SetTargetFPS with TARGET_FPS

            # Main game loop
            while not calling raylib.WindowShouldClose:
                # Update
                calling raylib.UpdateCamera with (sigil of camera), (raylib.CAMERA_ORBITAL to int)

                let view_loc as int is deferred_shader.locs at (raylib.SHADER_LOC_VECTOR_VIEW to int)
                calling deferred_shader.set_vec3 with view_loc, camera.position

                # Toggle lights
                if calling input.is_key_pressed with raylib.KEY_Y:
                    var l0 as Light is lights at 0
                    set l0.enabled is not l0.enabled
                    set lights at 0 is l0

                if calling input.is_key_pressed with raylib.KEY_R:
                    var l1 as Light is lights at 1
                    set l1.enabled is not l1.enabled
                    set lights at 1 is l1

                if calling input.is_key_pressed with raylib.KEY_G:
                    var l2 as Light is lights at 2
                    set l2.enabled is not l2.enabled
                    set lights at 2 is l2

                if calling input.is_key_pressed with raylib.KEY_B:
                    var l3 as Light is lights at 3
                    set l3.enabled is not l3.enabled
                    set lights at 3 is l3

                # Switch G-buffer view modes
                if calling input.is_key_pressed with raylib.KEY_ONE: set mode is DeferredMode.Position
                if calling input.is_key_pressed with raylib.KEY_TWO: set mode is DeferredMode.Normal
                if calling input.is_key_pressed with raylib.KEY_THREE: set mode is DeferredMode.Albedo
                if calling input.is_key_pressed with raylib.KEY_FOUR: set mode is DeferredMode.Shading

                for i from 0 to MAX_LIGHTS:
                    calling update_light_values with deferred_shader, (lights at i)

                # Draw
                calling drawing.begin_drawing

                # Pass 1: Render scene into G-Buffer
                calling rlgl.rlEnableFramebuffer with gbuffer.framebuffer_id
                calling rlgl.rlClearColor with 0 to byte, 0 to byte, 0 to byte, 0 to byte
                calling rlgl.rlClearScreenBuffers
                calling rlgl.rlDisableColorBlend

                calling drawing.begin_mode_3d with camera
                calling rlgl.rlEnableShader with gbuffer_shader.id

                calling model.draw with zero, 1.0, raylib.WHITE
                let center_cube_pos as raylib.Vector3 is with x is 0.0, y is 1.0, z is 0.0
                calling cube.draw with center_cube_pos, 1.0, raylib.WHITE

                let cube_axis as raylib.Vector3 is with x is 1.0, y is 1.0, z is 1.0
                let cube_scale as raylib.Vector3 is with x is 0.25, y is 0.25, z is 0.25

                for i from 0 to MAX_CUBES:
                    let ci as CubeInstance is cubes at i
                    calling cube.draw_ex with ci.position, cube_axis, ci.rotation, cube_scale, raylib.WHITE

                calling rlgl.rlDisableShader
                calling drawing.end_mode_3d
                calling rlgl.rlEnableColorBlend

                # Return to default framebuffer
                calling rlgl.rlDisableFramebuffer
                calling rlgl.rlClearScreenBuffers

                judge mode:
                    when DeferredMode.Shading ->
                        calling drawing.begin_mode_3d with camera
                        calling rlgl.rlDisableColorBlend
                        calling rlgl.rlEnableShader with deferred_shader.id

                        calling rlgl.rlActiveTextureSlot with tex_unit_pos
                        calling rlgl.rlEnableTexture with gbuffer.position_texture_id
                        calling rlgl.rlActiveTextureSlot with tex_unit_norm
                        calling rlgl.rlEnableTexture with gbuffer.normal_texture_id
                        calling rlgl.rlActiveTextureSlot with tex_unit_albedo
                        calling rlgl.rlEnableTexture with gbuffer.albedo_spec_texture_id

                        calling rlgl.rlLoadDrawQuad
                        calling rlgl.rlDisableShader
                        calling rlgl.rlEnableColorBlend
                        calling drawing.end_mode_3d

                        # Blit depth buffer from G-buffer to default framebuffer
                        let read_fb as u32 is rlgl.RL_READ_FRAMEBUFFER to u32
                        let draw_fb as u32 is rlgl.RL_DRAW_FRAMEBUFFER to u32
                        calling rlgl.rlBindFramebuffer with read_fb, gbuffer.framebuffer_id
                        calling rlgl.rlBindFramebuffer with draw_fb, 0
                        calling rlgl.rlBlitFramebuffer with 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, 0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, 0x00000100
                        calling rlgl.rlDisableFramebuffer

                        # Forward pass: draw light gizmos
                        calling drawing.begin_mode_3d with camera
                        calling rlgl.rlEnableShader with (calling rlgl.rlGetShaderIdDefault)
                        for i from 0 to MAX_LIGHTS:
                            let lt as Light is lights at i
                            if lt.enabled:
                                calling raylib.DrawSphereEx with lt.position, 0.2, 8, 8, lt.color
                            else:
                                calling shapes3d.draw_sphere_wires with lt.position, 0.2, 8, 8, (calling colors.fade with lt.color, 0.3)
                        calling rlgl.rlDisableShader
                        calling drawing.end_mode_3d

                        calling txt.draw_text with "FINAL RESULT", 10, SCREEN_HEIGHT - 30, 20, raylib.DARKGREEN

                    when DeferredMode.Position ->
                        var pos_tex as raylib.Texture2D is with:
                            set .id is gbuffer.position_texture_id
                            set .width is SCREEN_WIDTH
                            set .height is SCREEN_HEIGHT
                            set .mipmaps is 1
                            set .format is fmt_r16
                        var src_rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is SCREEN_WIDTH to f32, height is -(SCREEN_HEIGHT to f32)
                        calling pos_tex.draw_rec with src_rec, (with x is 0.0, y is 0.0), raylib.RAYWHITE
                        calling txt.draw_text with "POSITION TEXTURE", 10, SCREEN_HEIGHT - 30, 20, raylib.DARKGREEN

                    when DeferredMode.Normal ->
                        var norm_tex as raylib.Texture2D is with:
                            set .id is gbuffer.normal_texture_id
                            set .width is SCREEN_WIDTH
                            set .height is SCREEN_HEIGHT
                            set .mipmaps is 1
                            set .format is fmt_r16
                        var src_rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is SCREEN_WIDTH to f32, height is -(SCREEN_HEIGHT to f32)
                        calling norm_tex.draw_rec with src_rec, (with x is 0.0, y is 0.0), raylib.RAYWHITE
                        calling txt.draw_text with "NORMAL TEXTURE", 10, SCREEN_HEIGHT - 30, 20, raylib.DARKGREEN

                    when DeferredMode.Albedo ->
                        var alb_tex as raylib.Texture2D is with:
                            set .id is gbuffer.albedo_spec_texture_id
                            set .width is SCREEN_WIDTH
                            set .height is SCREEN_HEIGHT
                            set .mipmaps is 1
                            set .format is fmt_r8
                        var src_rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is SCREEN_WIDTH to f32, height is -(SCREEN_HEIGHT to f32)
                        calling alb_tex.draw_rec with src_rec, (with x is 0.0, y is 0.0), raylib.RAYWHITE
                        calling txt.draw_text with "ALBEDO TEXTURE", 10, SCREEN_HEIGHT - 30, 20, raylib.DARKGREEN

                calling txt.draw_text with "Toggle lights keys: [Y][R][G][B]", 10, 40, 20, raylib.DARKGRAY
                calling txt.draw_text with "Switch G-buffer textures: [1][2][3][4]", 10, 70, 20, raylib.DARKGRAY
                calling txt.draw_fps with 10, 10

                calling drawing.end_drawing

            # Cleanup
            calling rlgl.rlUnloadFramebuffer with gbuffer.framebuffer_id
            calling rlgl.rlUnloadTexture with gbuffer.position_texture_id
            calling rlgl.rlUnloadTexture with gbuffer.normal_texture_id
            calling rlgl.rlUnloadTexture with gbuffer.albedo_spec_texture_id
            calling rlgl.rlUnloadTexture with gbuffer.depth_renderbuffer_id

            return 0

    return 1
