## examples/shaders/shaders_cel_shading.pengu
## raylib [shaders] example - cel shading
##
## Example complexity rating: [★★★☆] 3/4
##
## Example originally created with raylib 6.0, last time updated with raylib 6.0
##
## Example contributed by Gleb A (@ggrizzly) and reviewed by Ramon Santamaria (@raysan5)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2026 Gleb A (@ggrizzly)
##
## ## PenguScript Port
## Port of `examples/shaders/shaders_cel_shading.c` demonstrating toon / cel shading
## with quantized lighting bands and an inverted-hull silhouette outline pass.
##
## Uses wrappers from `raylibx.models`, `raylibx.shaders`, `raylibx.drawing`,
## `raylibx.shapes3d`, `raylibx.input`, `raylibx.text`, `rlgl`, and `std.fractio`.
##
## ## Example
## ```bash
## pengu run examples/shaders/shaders_cel_shading.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.models as models
import raylibx.shaders as shaders
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import raymath
import rlgl
import std.fractio as fractio

# --- Constants ----------------------------------------------------------
## Screen width in pixels.
const SCREEN_WIDTH as int is 800

## Screen height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

## Maximum dynamic lights supported by the shader.
const MAX_LIGHTS as int is 4

# --- Types --------------------------------------------------------------
## Light source type classification.
omen LightType:
    Directional
    Point

## Dynamic light parameters for uniform binding.
rune Light:
    type as int
    enabled as bool
    position as raylib.Vector3
    target as raylib.Vector3
    color as raylib.Color
    attenuation as f32
    enabled_loc as int
    type_loc as int
    position_loc as int
    target_loc as int
    color_loc as int
    attenuation_loc as int

# --- Light Helpers ------------------------------------------------------
## Uploads light values to the cel shader.
##
## ## Parameters
## - `shader`: The active shader program.
## - `light`: The light struct to upload.
weave update_light_values with shader as raylib.Shader, light as Light into void:
    calling shader.set_int with light.enabled_loc, (if light.enabled then 1 else 0)
    calling shader.set_int with light.type_loc, light.type
    calling shader.set_vec3 with light.position_loc, light.position
    calling shader.set_vec3 with light.target_loc, light.target

    let col_vec as raylib.Vector4 is with:
        set .x is ((light.color.r to f32) / 255.0)
        set .y is ((light.color.g to f32) / 255.0)
        set .z is ((light.color.b to f32) / 255.0)
        set .w is ((light.color.a to f32) / 255.0)
    calling shader.set_vec4 with light.color_loc, col_vec

## Creates a dynamic light and queries uniform locations in the shader.
##
## ## Parameters
## - `light_index`: Index of this light in the shader lights array.
## - `light_type`: Classification of the light (`LightType.Point` or `LightType.Directional`).
## - `position`: 3D position of the light source.
## - `target`: Target look-at direction.
## - `color`: Emitted light color.
## - `shader`: The target shader.
##
## ## Returns
## Initialized `Light` struct.
weave create_light with light_index as int, light_type as int, position as raylib.Vector3, target as raylib.Vector3, color as raylib.Color, shader as raylib.Shader into Light:
    var light as Light is with:
        set .enabled is true
        set .type is light_type
        set .position is position
        set .target is target
        set .color is color
        set .attenuation is 0.0
        set .enabled_loc is -1
        set .type_loc is -1
        set .position_loc is -1
        set .target_loc is -1
        set .color_loc is -1
        set .attenuation_loc is -1

    let s_en as string is "lights[{light_index}].enabled"
    let s_ty as string is "lights[{light_index}].type"
    let s_pos as string is "lights[{light_index}].position"
    let s_tar as string is "lights[{light_index}].target"
    let s_col as string is "lights[{light_index}].color"
    defer banish s_en
    defer banish s_ty
    defer banish s_pos
    defer banish s_tar
    defer banish s_col

    if loc as int is calling shader.location with s_en: set light.enabled_loc is loc
    if loc as int is calling shader.location with s_ty: set light.type_loc is loc
    if loc as int is calling shader.location with s_pos: set light.position_loc is loc
    if loc as int is calling shader.location with s_tar: set light.target_loc is loc
    if loc as int is calling shader.location with s_col: set light.color_loc is loc

    calling update_light_values with shader, light
    return light

# --- Entry Point --------------------------------------------------------
## Program main entry point.
##
## Initializes the window, loads the 3D car model, compiles cel and inverted-hull
## outline shaders, configures a rotating directional light, and runs the orbital
## camera animation loop with interactive toggles.
##
## ## Returns
## Exit status code (`0` for success, `1` if asset loading fails).
weave main into int:
    # Initialization
    calling raylib.SetConfigFlags with raylib.FLAG_MSAA_4X_HINT
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [shaders] example - cel shading"
    defer calling raylib.CloseWindow

    var camera as raylib.Camera3D is with:
        set .position is (with x is 9.0, y is 6.0, z is 9.0)
        set .target is (with x is 0.0, y is 1.0, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is 45.0
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    # Load model
    let model_opt as maybe raylib.Model is calling models.load_model with "examples/shaders/resources/models/old_car_new.glb"
    if model_val as raylib.Model is model_opt:
        var model as raylib.Model is model_val
        defer calling models.unload_model with model

        # Load cel shader
        let cel_vs as string is "examples/shaders/resources/shaders/glsl330/cel.vs"
        let cel_fs as string is "examples/shaders/resources/shaders/glsl330/cel.fs"
        var cel_shader as raylib.Shader is with id is 0
        let cel_opt as maybe raylib.Shader is calling shaders.load_shader with cel_vs, cel_fs
        if loaded_cel as raylib.Shader is cel_opt:
            set cel_shader is loaded_cel
            defer calling shaders.unload_shader with cel_shader

            if loc as int is calling cel_shader.location with "viewPos":
                set cel_shader.locs at (raylib.SHADER_LOC_VECTOR_VIEW to int) is loc

            # Apply cel shader to model, keep copy of default shader
            var mat as ref to raylib.Material is sigil of (model.materials at 0)
            let default_shader as raylib.Shader is mat->shader
            set mat->shader is cel_shader

            # numBands: controls toon quantization steps
            var num_bands as f32 is 10.0
            var num_bands_loc as int is -1
            if loc as int is calling cel_shader.location with "numBands":
                set num_bands_loc is loc
                calling cel_shader.set_float with loc, num_bands

            # Inverted-hull outline shader
            let out_vs as string is "examples/shaders/resources/shaders/glsl330/outline_hull.vs"
            let out_fs as string is "examples/shaders/resources/shaders/glsl330/outline_hull.fs"
            var outline_shader as raylib.Shader is with id is 0
            let out_opt as maybe raylib.Shader is calling shaders.load_shader with out_vs, out_fs
            if loaded_out as raylib.Shader is out_opt:
                set outline_shader is loaded_out
                defer calling shaders.unload_shader with outline_shader

                var outline_thickness_loc as int is -1
                if loc as int is calling outline_shader.location with "outlineThickness":
                    set outline_thickness_loc is loc

                # Single directional white light
                var lights as list of Light is []
                defer banish lights

                let zero as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0
                calling lights.append with (calling create_light with 0, (LightType.Directional to int), (with x is 50.0, y is 50.0, z is 50.0), zero, raylib.WHITE, cel_shader)

                var cel_enabled as bool is true
                var outline_enabled as bool is true

                calling raylib.SetTargetFPS with TARGET_FPS

                # Main game loop
                while not calling raylib.WindowShouldClose:
                    # Update
                    calling raylib.UpdateCamera with (sigil of camera), (raylib.CAMERA_ORBITAL to int)

                    let view_loc as int is cel_shader.locs at (raylib.SHADER_LOC_VECTOR_VIEW to int)
                    calling cel_shader.set_vec3 with view_loc, camera.position

                    # [Z] Toggle cel shading on/off
                    if calling input.is_key_pressed with raylib.KEY_Z:
                        set cel_enabled is not cel_enabled
                        if cel_enabled:
                            set mat->shader is cel_shader
                        else:
                            set mat->shader is default_shader

                    # [C] Toggle outline on/off
                    if calling input.is_key_pressed with raylib.KEY_C:
                        set outline_enabled is not outline_enabled

                    # [Q/E] Decrease/increase toon band count
                    if (calling input.is_key_pressed with raylib.KEY_E) or (calling input.is_key_pressed_repeat with raylib.KEY_E):
                        set num_bands is calling raymath.Clamp with num_bands + 1.0, 2.0, 20.0
                    if (calling input.is_key_pressed with raylib.KEY_Q) or (calling input.is_key_pressed_repeat with raylib.KEY_Q):
                        set num_bands is calling raymath.Clamp with num_bands - 1.0, 2.0, 20.0
                    calling cel_shader.set_float with num_bands_loc, num_bands

                    # Spin light opposite to CAMERA_ORBITAL
                    let t as f32 is (calling raylib.GetTime to f32) * -0.3
                    let sin_t as f32 is calling t.get_sin
                    let cos_t as f32 is calling t.get_cos

                    var l0 as Light is lights at 0
                    set l0.position.x is sin_t * 5.0
                    set l0.position.y is 5.0
                    set l0.position.z is cos_t * 5.0
                    set lights at 0 is l0

                    calling update_light_values with cel_shader, l0

                    # Draw
                    calling drawing.begin_drawing
                    calling drawing.clear_background with raylib.RAYWHITE

                    calling drawing.begin_mode_3d with camera

                    if outline_enabled:
                        # Outline pass: cull front faces, draw extruded back faces
                        calling outline_shader.set_float with outline_thickness_loc, 0.005
                        calling rlgl.rlSetCullFace with (rlgl.RL_CULL_FACE_FRONT to int)
                        set mat->shader is outline_shader

                        calling model.draw with zero, 0.75, raylib.WHITE

                        if cel_enabled:
                            set mat->shader is cel_shader
                        else:
                            set mat->shader is default_shader

                        calling rlgl.rlSetCullFace with (rlgl.RL_CULL_FACE_BACK to int)

                    calling model.draw with zero, 0.75, raylib.WHITE
                    calling raylib.DrawSphereEx with l0.position, 0.2, 50, 50, raylib.YELLOW
                    calling shapes3d.draw_grid with 10, 10.0

                    calling drawing.end_mode_3d

                    calling txt.draw_fps with 10, 10

                    let cel_str as string is if cel_enabled then "Cel: ON  [Z]" else "Cel: OFF  [Z]"
                    let cel_col as raylib.Color is if cel_enabled then raylib.DARKGREEN else raylib.DARKGRAY
                    calling txt.draw_text with cel_str, 10, 65, 20, cel_col

                    let out_str as string is if outline_enabled then "Outline: ON  [C]" else "Outline: OFF  [C]"
                    let out_col as raylib.Color is if outline_enabled then raylib.DARKGREEN else raylib.DARKGRAY
                    calling txt.draw_text with out_str, 10, 90, 20, out_col

                    let bands_str as string is "Bands: {(num_bands to int)}  [Q/E]"
                    defer banish bands_str
                    calling txt.draw_text with bands_str, 10, 115, 20, raylib.DARKGRAY

                    calling drawing.end_drawing

                # Restore default shader before unloading model
                set mat->shader is default_shader
                return 0

    return 1
