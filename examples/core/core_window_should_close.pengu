## examples/core/core_window_should_close.pengu
## raylib [core] example - window should close
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 4.2, last time updated with raylib 4.2
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2013-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/core/core_window_should_close.c` on top of the
## `raylibx` wrapper layer. `SetExitKey` is called through `raylib` with
## `KEY_NULL` to disable automatic `ESC` closing while keeping the window close
## button active, and confirmation input is polled through `raylibx.input`.
##
## ## Example
## ```bash
## pengu run examples/core/core_window_should_close.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.text as txt

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main loop.
const TARGET_FPS as int is 60

# --- Entry point --------------------------------------------------------
## Opens a window that intercepts close requests (`ESC` or the window close
## button) and asks the user for `[Y/N]` confirmation before exiting.
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - window should close"
    defer calling raylib.CloseWindow

    # Disable KEY_ESCAPE to close window, X-button still works
    calling raylib.SetExitKey with (raylib.KEY_NULL to int)

    var is_exit_requested as bool is false
    var is_exit_confirmed as bool is false

    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not is_exit_confirmed:
        # Update
        # -----------------------------------------------------------------
        # Detect if X-button or KEY_ESCAPE have been pressed to close window
        if (calling raylib.WindowShouldClose) or (calling input.is_key_pressed with raylib.KEY_ESCAPE):
            set is_exit_requested is true

        if is_exit_requested:
            # A request for close window has been issued, we can save data before closing
            # or just show a message asking for confirmation
            if calling input.is_key_pressed with raylib.KEY_Y:
                set is_exit_confirmed is true
            else if calling input.is_key_pressed with raylib.KEY_N:
                set is_exit_requested is false
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        if is_exit_requested:
            calling shapes.draw_rectangle with 0, 100, SCREEN_WIDTH, 200, raylib.BLACK
            calling txt.draw_text with "Are you sure you want to exit program? [Y/N]", 40, 180, 30, raylib.WHITE
        else:
            calling txt.draw_text with "Try to close the window to get confirmation message!", 120, 200, 20, raylib.LIGHTGRAY

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
