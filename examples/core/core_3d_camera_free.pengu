## examples/core/core_3d_camera_free.pengu
## raylib [core] example - 3d camera free
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 1.3, last time updated with raylib 1.3
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/core/core_3d_camera_free.c` on top of the
## `raylibx` wrapper layer. The window is opened with `raylib.InitWindow` because
## the wrapper does not wrap `InitWindow`/`CloseWindow` (contract §9, row 8), and
## the rest of the example uses the methods and functions from `raylibx`:
## `Camera3D` is constructed with a `with:` block, the cube is drawn with
## `shapes3d.draw_cube`, and the help panel uses `shapes` + `text` + `colors`.
##
## ## Example
## ```bash
## pengu run examples/core/core_3d_camera_free.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.shapes3d as shapes3d
import raylibx.text as txt

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main game loop.
const TARGET_FPS as int is 60

## Vertical field-of-view of the camera, in degrees.
const CAMERA_FOVY as f32 is 45.0

# --- Entry point --------------------------------------------------------
## Opens the window, draws a cube on a grid, and updates the free camera until
## the user closes the window (close button or ESC key).
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - 3d camera free"
    defer calling raylib.CloseWindow

    # Define the camera to look into our 3D world
    var camera as raylib.Camera3D with:
        set .position is (with x is 10.0, y is 10.0, z is 10.0)  # Camera position
        set .target is (with x is 0.0, y is 0.0, z is 0.0)       # Camera looking at point
        set .up is (with x is 0.0, y is 1.0, z is 0.0)           # Camera up vector (rotation towards target)
        set .fovy is CAMERA_FOVY                                # Camera field-of-view Y
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)    # Camera projection type

    var cube_position as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0

    calling raylib.DisableCursor          # Limit cursor to relative movement inside the window
    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        calling raylib.UpdateCamera with (sigil of camera), raylib.CAMERA_FREE

        if calling input.is_key_pressed with raylib.KEY_Z:
            set camera.target is with x is 0.0, y is 0.0, z is 0.0
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        calling shapes3d.draw_cube with cube_position, 2.0, 2.0, 2.0, raylib.RED
        calling shapes3d.draw_cube_wires with cube_position, 2.0, 2.0, 2.0, raylib.MAROON

        calling shapes3d.draw_grid with 10, 1.0

        calling drawing.end_mode_3d

        let panel_color as raylib.Color is calling colors.fade with raylib.SKYBLUE, 0.5
        calling shapes.draw_rectangle with 10, 10, 320, 93, panel_color
        calling shapes.draw_rectangle_lines with 10, 10, 320, 93, raylib.BLUE

        calling txt.draw_text with "Free camera default controls:", 20, 20, 10, raylib.BLACK
        calling txt.draw_text with "- Mouse Wheel to Zoom in-out", 40, 40, 10, raylib.DARKGRAY
        calling txt.draw_text with "- Mouse Wheel Pressed to Pan", 40, 60, 10, raylib.DARKGRAY
        calling txt.draw_text with "- Z to zoom to (0, 0, 0)", 40, 80, 10, raylib.DARKGRAY

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
