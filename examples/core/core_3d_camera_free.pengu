## examples/core/core_3d_camera_free.pengu
## raylib [core] example - 3d camera free
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 1.3, last time updated with raylib 1.3
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## Port a PenguScript
## Traducción 1:1 de `examples/core/core_3d_camera_free.c` sobre la capa de
## wrappers `raylibx`. La ventana se abre con `raylib.InitWindow` porque el
## wrapper no envuelve `InitWindow`/`CloseWindow` (contrato §9, fila 8), y el
## resto del ejemplo usa los métodos y funciones de `raylibx`:
## `Camera3D` se construye con un bloque `with:`, el cubo se dibuja con
## `shapes3d.draw_cube` y el panel de ayuda con `shapes` + `text` + `colors`.
##
## ## Ejemplo
## ```bash
## pengu run examples/core/core_3d_camera_free.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.shapes as shapes
import raylibx.shapes3d as shapes3d
import raylibx.text as txt

# --- Constantes ---------------------------------------------------------
## Ancho de la ventana, en píxeles.
const SCREEN_WIDTH as int is 800

## Alto de la ventana, en píxeles.
const SCREEN_HEIGHT as int is 450

## Fotogramas por segundo a los que corre el bucle principal.
const TARGET_FPS as int is 60

## Campo de visión vertical de la cámara, en grados.
const CAMERA_FOVY as f32 is 45.0

# --- Punto de entrada ---------------------------------------------------
## Abre la ventana, dibuja un cubo sobre una rejilla y mueve la cámara libre
## hasta que el usuario cierre la ventana (botón de cerrar o tecla ESC).
##
## ## Retorno
## Código de salida del proceso: `0` cuando la ventana se cierra con normalidad.
weave main into int:
    # Inicialización
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - 3d camera free"
    defer calling raylib.CloseWindow

    # Cámara que mira al mundo 3D
    var camera as raylib.Camera3D with:
        set .position is (with x is 10.0, y is 10.0, z is 10.0)  # Posición de la cámara
        set .target is (with x is 0.0, y is 0.0, z is 0.0)       # Punto al que mira
        set .up is (with x is 0.0, y is 1.0, z is 0.0)           # Vector «arriba»
        set .fovy is CAMERA_FOVY                                # Campo de visión Y
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)    # Proyección en perspectiva

    var cube_position as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0

    calling raylib.DisableCursor          # Limita el cursor al movimiento relativo
    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Bucle principal
    while not calling raylib.WindowShouldClose:
        # Actualización
        # -----------------------------------------------------------------
        calling raylib.UpdateCamera with (sigil of camera), raylib.CAMERA_FREE

        if calling input.is_key_pressed with raylib.KEY_Z:
            set camera.target is with x is 0.0, y is 0.0, z is 0.0
        # -----------------------------------------------------------------

        # Dibujo
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        calling shapes3d.draw_cube with cube_position, 2.0, 2.0, 2.0, raylib.RED
        calling shapes3d.draw_cube_wires with cube_position, 2.0, 2.0, 2.0, raylib.MAROON

        calling shapes3d.draw_grid with 10, 1.0

        calling drawing.end_mode_3d

        let panel_color as raylib.Color is calling colors.fade with raylib.SKYBLUE, 0.5
        calling shapes.draw_rectangle with 10, 10, 320, 93, panel_color
        calling shapes.draw_rectangle_lines with 10, 10, 320, 93, raylib.BLUE

        calling txt.draw_text with "Free camera default controls:", 20, 20, 10, raylib.BLACK
        calling txt.draw_text with "- Mouse Wheel to Zoom in-out", 40, 40, 10, raylib.DARKGRAY
        calling txt.draw_text with "- Mouse Wheel Pressed to Pan", 40, 60, 10, raylib.DARKGRAY
        calling txt.draw_text with "- Z to zoom to (0, 0, 0)", 40, 80, 10, raylib.DARKGRAY

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
