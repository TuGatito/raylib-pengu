## examples/core/core_2d_camera.pengu
## raylib [core] example - 2d camera
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.5, last time updated with raylib 3.0
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2016-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/core/core_2d_camera.c` on top of the `raylibx`
## wrapper layer. The C arrays (`buildings`, `buildColors`) become `list of T`
## with `defer banish`, since their length is known only at runtime; the drawing
## loops use the indexed form `for i, item in buildings` to pair each building
## with its color. Zoom uses the pure pair from `std.fractio`
## (`get_ln` / `get_exp`) and `raymathx.clamp`, matching the logarithmic scaling
## of the original.
##
## ## Example
## ```bash
## pengu run examples/core/core_2d_camera.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.random as random
import raylibx.shapes as shapes
import raylibx.text as txt
import raymathx
import std.fractio

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main game loop.
const TARGET_FPS as int is 60

## Number of buildings generated in the city.
const MAX_BUILDINGS as int is 100

## Camera rotation bounds, in degrees.
const MIN_ROTATION as f32 is -40.0
const MAX_ROTATION as f32 is 40.0

## Camera zoom bounds.
const MIN_ZOOM as f32 is 0.1
const MAX_ZOOM as f32 is 3.0

# --- Helpers ------------------------------------------------------------
## Generates a random opaque gray within the original example's range.
##
## ## Returns
## A new `raylib.Color`; allocates no memory, nothing to free.
weave make_random_gray into raylib.Color:
    return with:
        set .r is ((calling random.between with 200, 240) to byte)
        set .g is ((calling random.between with 200, 240) to byte)
        set .b is ((calling random.between with 200, 250) to byte)
        set .a is 255

## Builds a rectangular building from its position and size.
##
## ## Parameters
## - `x`, `y`: top-left corner, in world coordinates.
## - `width`, `height`: building size.
##
## ## Returns
## A new `raylib.Rectangle`; allocates no memory.
weave make_building_rect with x as f32, y as f32, width as f32, height as f32 into raylib.Rectangle:
    return with x is x, y is y, width is width, height is height

# --- Entry point --------------------------------------------------------
## Displays a randomly generated city, a player moving through it, and a free
## 2D camera until the user closes the window.
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - 2d camera"
    defer calling raylib.CloseWindow

    var player as raylib.Rectangle is with x is 400.0, y is 280.0, width is 40.0, height is 40.0

    var buildings as list of raylib.Rectangle is list of raylib.Rectangle
    defer banish buildings
    var build_colors as list of raylib.Color is list of raylib.Color
    defer banish build_colors

    var spacing as int is 0
    for _ from 0 to MAX_BUILDINGS:
        let width as f32 is ((calling random.between with 50, 200) to f32)
        let height as f32 is ((calling random.between with 100, 800) to f32)
        let build_y as f32 is (SCREEN_HEIGHT to f32) - 130.0 - height
        let build_x as f32 is -6000.0 + (spacing to f32)

        calling buildings.push with (calling make_building_rect with build_x, build_y, width, height)
        set spacing is spacing + (width to int)
        calling build_colors.push with (calling make_random_gray)

    var camera as raylib.Camera2D with:
        set .target is with x is (player.x + 20.0), y is (player.y + 20.0)
        set .offset is with:
            set .x is ((calling raylib.GetRenderWidth) to f32) / 2.0
            set .y is ((calling raylib.GetRenderHeight) to f32) / 2.0
        set .rotation is 0.0
        set .zoom is 1.0

    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        # Player movement
        if calling input.is_key_down with raylib.KEY_RIGHT:
            set player.x += 2.0
        else if calling input.is_key_down with raylib.KEY_LEFT:
            set player.x -= 2.0

        # Camera target follows player
        set camera.target is with x is (player.x + 20.0), y is (player.y + 20.0)

        # Camera rotation controls
        if calling input.is_key_down with raylib.KEY_A:
            set camera.rotation is (calling raymathx.clamp with (camera.rotation - 1.0), MIN_ROTATION, MAX_ROTATION)
        else if calling input.is_key_down with raylib.KEY_S:
            set camera.rotation is (calling raymathx.clamp with (camera.rotation + 1.0), MIN_ROTATION, MAX_ROTATION)

        # Camera zoom controls (logarithmic scaling for consistent zoom speed)
        let wheel as f32 is calling raylib.GetMouseWheelMove
        let log_zoom as f32 is calling camera.zoom.get_ln
        let grown_zoom as f32 is log_zoom + (wheel * 0.1)
        set camera.zoom is (calling raymathx.clamp with (calling grown_zoom.get_exp), MIN_ZOOM, MAX_ZOOM)

        # Camera reset (zoom and rotation)
        if calling input.is_key_pressed with raylib.KEY_R:
            set camera.zoom is 1.0
            set camera.rotation is 0.0
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_2d with camera

        calling shapes.draw_rectangle with -6000, 320, 13000, 8000, raylib.DARKGRAY

        for i, building in buildings:
            calling building.draw with (build_colors at i)

        calling player.draw with raylib.RED

        calling shapes.draw_line with (camera.target.x to int), (-SCREEN_HEIGHT * 10), (camera.target.x to int), (SCREEN_HEIGHT * 10), raylib.GREEN
        calling shapes.draw_line with (-SCREEN_WIDTH * 10), (camera.target.y to int), (SCREEN_WIDTH * 10), (camera.target.y to int), raylib.GREEN

        calling drawing.end_mode_2d

        calling txt.draw_text with "SCREEN AREA", 640, 10, 20, raylib.RED

        calling shapes.draw_rectangle with 0, 0, SCREEN_WIDTH, 5, raylib.RED
        calling shapes.draw_rectangle with 0, 5, 5, SCREEN_HEIGHT - 10, raylib.RED
        calling shapes.draw_rectangle with SCREEN_WIDTH - 5, 5, 5, SCREEN_HEIGHT - 10, raylib.RED
        calling shapes.draw_rectangle with 0, SCREEN_HEIGHT - 5, SCREEN_WIDTH, 5, raylib.RED

        calling shapes.draw_rectangle with 10, 10, 250, 113, (calling colors.fade with raylib.SKYBLUE, 0.5)
        calling shapes.draw_rectangle_lines with 10, 10, 250, 113, raylib.BLUE

        calling txt.draw_text with "Free 2D camera controls:", 20, 20, 10, raylib.BLACK
        calling txt.draw_text with "- Right/Left to move player", 40, 40, 10, raylib.DARKGRAY
        calling txt.draw_text with "- Mouse Wheel to Zoom in-out", 40, 60, 10, raylib.DARKGRAY
        calling txt.draw_text with "- A / S to Rotate", 40, 80, 10, raylib.DARKGRAY
        calling txt.draw_text with "- R to reset Zoom and Rotation", 40, 100, 10, raylib.DARKGRAY

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
