## examples/core/core_world_screen.pengu
## raylib [core] example - world screen
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.3, last time updated with raylib 1.4
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/core/core_world_screen.c` on top of the
## `raylibx` and `rcamerax` wrapper layers. World-to-screen projection uses
## `Camera3D.to_screen` from `rcamerax`, 3D primitives use `raylibx.shapes3d`,
## and string formatting uses PenguScript string interpolation with explicit
## `banish` per frame.
##
## ## Example
## ```bash
## pengu run examples/core/core_world_screen.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import rcamerax

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main loop.
const TARGET_FPS as int is 60

## Vertical field-of-view of the 3D camera, in degrees.
const CAMERA_FOVY as f32 is 45.0

# --- Entry point --------------------------------------------------------
## Opens a 3D scene with a cube and projects the point above the cube into 2D
## screen coordinates so a health label tracks it on top.
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - world screen"
    defer calling raylib.CloseWindow

    # Define the camera to look into our 3d world
    var camera as raylib.Camera3D with:
        set .position is (with x is 10.0, y is 10.0, z is 10.0)
        set .target is (with x is 0.0, y is 0.0, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is CAMERA_FOVY
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    let cube_position as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0
    var cube_screen_position as raylib.Vector2 is with x is 0.0, y is 0.0

    calling raylib.DisableCursor
    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        calling raylib.UpdateCamera with (sigil of camera), (raylib.CAMERA_THIRD_PERSON to int)

        # Calculate cube screen space position (with a little offset to be on top)
        let label_world_pos as raylib.Vector3 is with x is cube_position.x, y is (cube_position.y + 2.5), z is cube_position.z
        set cube_screen_position is calling camera.to_screen with label_world_pos
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        calling shapes3d.draw_cube with cube_position, 2.0, 2.0, 2.0, raylib.RED
        calling shapes3d.draw_cube_wires with cube_position, 2.0, 2.0, 2.0, raylib.MAROON

        calling shapes3d.draw_grid with 10, 1.0

        calling drawing.end_mode_3d

        let enemy_label as string is "Enemy: 100/100"
        let label_width as int is calling txt.measure_text with enemy_label, 20
        let screen_x as int is (cube_screen_position.x to int)
        let screen_y as int is (cube_screen_position.y to int)
        calling txt.draw_text with enemy_label, (screen_x - (label_width / 2)), screen_y, 20, raylib.BLACK

        let coords_text as string is "Cube position in screen space coordinates: [{screen_x}, {screen_y}]"
        calling txt.draw_text with coords_text, 10, 10, 20, raylib.LIME
        banish coords_text

        calling txt.draw_text with "Text 2d should be always on top of the cube", 10, 40, 20, raylib.GRAY

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
