## examples/core/core_3d_camera_first_person.pengu
## raylib [core] example - 3d camera first person
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.3, last time updated with raylib 1.3
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/core/core_3d_camera_first_person.c` on top of the
## `raylibx` + `rcamerax` wrapper layer. `CameraYaw`/`CameraPitch` become
## `camera.yaw` and `camera.pitch`; `UpdateCamera` remains a binding function call,
## which is where `raylib` declares it. The random C column arrays (`heights`,
## `positions`, `colors`) are stored in three lists released with `defer banish`,
## and the camera status panel uses string interpolation instead of `TextFormat`.
##
## ## Example
## ```bash
## pengu run examples/core/core_3d_camera_first_person.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.colors as colors
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.random as random
import raylibx.shapes as shapes
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import raymathx
import rcamerax

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main game loop.
const TARGET_FPS as int is 60

## Number of random columns generated in the scene.
const MAX_COLUMNS as int is 20

# --- Helpers ------------------------------------------------------------
## Translates a raylib camera mode to its human-readable name.
##
## ## Parameters
## - `mode`: current camera mode.
##
## ## Returns
## The mode name. Returned string literals do not own heap memory.
weave describe_camera_mode with mode as raylib.CameraMode into string:
    judge mode:
        when CAMERA_FREE -> "FREE"
        when CAMERA_FIRST_PERSON -> "FIRST_PERSON"
        when CAMERA_THIRD_PERSON -> "THIRD_PERSON"
        when CAMERA_ORBITAL -> "ORBITAL"
        when CAMERA_CUSTOM -> "CUSTOM"

## Translates a raylib projection type to its human-readable name.
##
## ## Parameters
## - `projection`: value of the `Camera3D.projection` field.
##
## ## Returns
## The projection name. Returned string literals do not own heap memory.
weave describe_projection with projection as int into string:
    if projection == (raylib.CAMERA_PERSPECTIVE to int):
        return "PERSPECTIVE"
    if projection == (raylib.CAMERA_ORTHOGRAPHIC to int):
        return "ORTHOGRAPHIC"
    return "CUSTOM"

# --- Entry point --------------------------------------------------------
## Explores a 3D world with a first-person camera that can switch camera modes
## (`1`–`4`) and projection (`P`).
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - 3d camera first person"
    defer calling raylib.CloseWindow

    # Define the camera to look into our 3D world (position, target, up vector)
    var camera as raylib.Camera3D with:
        set .position is (with x is 0.0, y is 2.0, z is 4.0)   # Camera position
        set .target is (with x is 0.0, y is 2.0, z is 0.0)      # Camera looking at point
        set .up is (with x is 0.0, y is 1.0, z is 0.0)          # Camera up vector (rotation towards target)
        set .fovy is 60.0                                       # Camera field-of-view Y
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)   # Camera projection type

    var camera_mode as raylib.CameraMode is raylib.CAMERA_FIRST_PERSON
    let deg2rad as f32 is (raylib.DEG2RAD to f32)

    # Generate random columns
    var heights as list of f32 is list of f32
    defer banish heights
    var positions as list of raylib.Vector3 is list of raylib.Vector3
    defer banish positions
    var column_colors as list of raylib.Color is list of raylib.Color
    defer banish column_colors

    for _ from 0 to MAX_COLUMNS:
        let height as f32 is ((calling random.between with 1, 12) to f32)
        calling heights.push with height
        let position as raylib.Vector3 is with:
            set .x is ((calling random.between with -15, 15) to f32)
            set .y is height / 2.0
            set .z is ((calling random.between with -15, 15) to f32)
        calling positions.push with position

        let column_color as raylib.Color is with:
            set .r is ((calling random.between with 20, 255) to byte)
            set .g is ((calling random.between with 10, 55) to byte)
            set .b is 30
            set .a is 255
        calling column_colors.push with column_color

    calling raylib.DisableCursor          # Limit cursor to relative movement inside the window
    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        # Switch camera mode
        if calling input.is_key_pressed with raylib.KEY_ONE:
            set camera_mode is raylib.CAMERA_FREE
            set camera.up is with x is 0.0, y is 1.0, z is 0.0
        if calling input.is_key_pressed with raylib.KEY_TWO:
            set camera_mode is raylib.CAMERA_FIRST_PERSON
            set camera.up is with x is 0.0, y is 1.0, z is 0.0
        if calling input.is_key_pressed with raylib.KEY_THREE:
            set camera_mode is raylib.CAMERA_THIRD_PERSON
            set camera.up is with x is 0.0, y is 1.0, z is 0.0
        if calling input.is_key_pressed with raylib.KEY_FOUR:
            set camera_mode is raylib.CAMERA_ORBITAL
            set camera.up is with x is 0.0, y is 1.0, z is 0.0

        # Switch camera projection
        if calling input.is_key_pressed with raylib.KEY_P:
            if camera.projection == (raylib.CAMERA_PERSPECTIVE to int):
                # Create isometric view
                set camera_mode is raylib.CAMERA_THIRD_PERSON
                set camera.position is with x is 0.0, y is 2.0, z is -100.0
                set camera.target is with x is 0.0, y is 2.0, z is 0.0
                set camera.up is with x is 0.0, y is 1.0, z is 0.0
                set camera.projection is (raylib.CAMERA_ORTHOGRAPHIC to int)
                set camera.fovy is 20.0
                calling camera.yaw with (-135.0 * deg2rad), true
                calling camera.pitch with (-45.0 * deg2rad), true, true, false
            else if camera.projection == (raylib.CAMERA_ORTHOGRAPHIC to int):
                # Reset to default view
                set camera_mode is raylib.CAMERA_THIRD_PERSON
                set camera.position is with x is 0.0, y is 2.0, z is 10.0
                set camera.target is with x is 0.0, y is 2.0, z is 0.0
                set camera.up is with x is 0.0, y is 1.0, z is 0.0
                set camera.projection is (raylib.CAMERA_PERSPECTIVE to int)
                set camera.fovy is 60.0

        # Update camera computes movement internally depending on the camera mode
        calling raylib.UpdateCamera with (sigil of camera), camera_mode
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        let ground as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0
        calling ground.draw_plane with (with x is 32.0, y is 32.0), raylib.LIGHTGRAY  # Draw ground
        calling shapes3d.draw_cube with (with x is -16.0, y is 2.5, z is 0.0), 1.0, 5.0, 32.0, raylib.BLUE         # Draw a blue wall
        calling shapes3d.draw_cube with (with x is 16.0, y is 2.5, z is 0.0), 1.0, 5.0, 32.0, raylib.LIME          # Draw a green wall
        calling shapes3d.draw_cube with (with x is 0.0, y is 2.5, z is 16.0), 32.0, 5.0, 1.0, raylib.GOLD          # Draw a yellow wall

        # Draw some cubes around
        for i, position in positions:
            calling shapes3d.draw_cube with position, 2.0, (heights at i), 2.0, (column_colors at i)
            calling shapes3d.draw_cube_wires with position, 2.0, (heights at i), 2.0, raylib.MAROON

        # Draw player cube
        if camera_mode == raylib.CAMERA_THIRD_PERSON:
            calling shapes3d.draw_cube with camera.target, 0.5, 0.5, 0.5, raylib.PURPLE
            calling shapes3d.draw_cube_wires with camera.target, 0.5, 0.5, 0.5, raylib.DARKPURPLE

        calling drawing.end_mode_3d

        # Draw info boxes
        let panel_color as raylib.Color is calling colors.fade with raylib.SKYBLUE, 0.5
        calling shapes.draw_rectangle with 5, 5, 330, 100, panel_color
        calling shapes.draw_rectangle_lines with 5, 5, 330, 100, raylib.BLUE

        calling txt.draw_text with "Camera controls:", 15, 15, 10, raylib.BLACK
        calling txt.draw_text with "- Move keys: W, A, S, D, Space, Left-Ctrl", 15, 30, 10, raylib.BLACK
        calling txt.draw_text with "- Look around: arrow keys or mouse", 15, 45, 10, raylib.BLACK
        calling txt.draw_text with "- Camera mode keys: 1, 2, 3, 4", 15, 60, 10, raylib.BLACK
        calling txt.draw_text with "- Zoom keys: num-plus, num-minus or mouse scroll", 15, 75, 10, raylib.BLACK
        calling txt.draw_text with "- Camera projection key: P", 15, 90, 10, raylib.BLACK

        calling shapes.draw_rectangle with 600, 5, 195, 100, panel_color
        calling shapes.draw_rectangle_lines with 600, 5, 195, 100, raylib.BLUE

        calling txt.draw_text with "Camera status:", 610, 15, 10, raylib.BLACK

        let mode_text as string is "- Mode: {calling describe_camera_mode with camera_mode}"
        defer banish mode_text
        calling txt.draw_text with mode_text, 610, 30, 10, raylib.BLACK

        let projection_text as string is "- Projection: {calling describe_projection with camera.projection}"
        defer banish projection_text
        calling txt.draw_text with projection_text, 610, 45, 10, raylib.BLACK

        let position_text as string is "- Position: ({camera.position.x}, {camera.position.y}, {camera.position.z})"
        defer banish position_text
        calling txt.draw_text with position_text, 610, 60, 10, raylib.BLACK

        let target_text as string is "- Target: ({camera.target.x}, {camera.target.y}, {camera.target.z})"
        defer banish target_text
        calling txt.draw_text with target_text, 610, 75, 10, raylib.BLACK

        let up_text as string is "- Up: ({camera.up.x}, {camera.up.y}, {camera.up.z})"
        defer banish up_text
        calling txt.draw_text with up_text, 610, 90, 10, raylib.BLACK

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
