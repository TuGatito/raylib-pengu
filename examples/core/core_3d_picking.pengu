## examples/core/core_3d_picking.pengu
## raylib [core] example - 3d picking
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.3, last time updated with raylib 4.0
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## 1:1 translation of `examples/core/core_3d_picking.c` on top of the `raylibx`
## and `rcamerax` wrapper layers. Screen-to-world ray casting uses the camera
## method `camera.to_world_ray`, box intersection uses `models.ray_box_hit`, and
## 3D primitives and UI overlays go through `shapes3d` and `txt`.
##
## ## Example
## ```bash
## pengu run examples/core/core_3d_picking.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.models as models
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import rcamerax

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main game loop.
const TARGET_FPS as int is 60

## Vertical field-of-view of the 3D camera, in degrees.
const CAMERA_FOVY as f32 is 45.0

# --- Helpers ------------------------------------------------------------
## Builds an axis-aligned bounding box centered at `position` with dimensions `extent`.
##
## ## Parameters
## - `position`: center of the box in world coordinates.
## - `extent`: width, height, and length of the box.
##
## ## Returns
## A new `raylib.BoundingBox`; allocates no memory.
weave make_cube_box with position as raylib.Vector3, extent as raylib.Vector3 into raylib.BoundingBox:
    return with:
        set .min is with:
            set .x is position.x - (extent.x / 2.0)
            set .y is position.y - (extent.y / 2.0)
            set .z is position.z - (extent.z / 2.0)
        set .max is with:
            set .x is position.x + (extent.x / 2.0)
            set .y is position.y + (extent.y / 2.0)
            set .z is position.z + (extent.z / 2.0)

# --- Entry point --------------------------------------------------------
## Casts a picking ray from the mouse cursor into a 3D scene and highlights a
## cube when selected.
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [core] example - 3d picking"
    defer calling raylib.CloseWindow

    # Define the camera to look into our 3D world
    var camera as raylib.Camera3D with:
        set .position is (with x is 10.0, y is 10.0, z is 10.0)  # Camera position
        set .target is (with x is 0.0, y is 0.0, z is 0.0)       # Camera looking at point
        set .up is (with x is 0.0, y is 1.0, z is 0.0)           # Camera up vector (rotation towards target)
        set .fovy is CAMERA_FOVY                                # Camera field-of-view Y
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)    # Camera projection type

    let cube_position as raylib.Vector3 is with x is 0.0, y is 1.0, z is 0.0
    let cube_size as raylib.Vector3 is with x is 2.0, y is 2.0, z is 2.0

    var ray as raylib.Ray with:             # Picking line ray
        set .position is with x is 0.0, y is 0.0, z is 0.0
        set .direction is with x is 0.0, y is 0.0, z is 0.0

    var collision as raylib.RayCollision with:  # Ray collision hit info
        set .hit is false
        set .distance is 0.0
        set .point is with x is 0.0, y is 0.0, z is 0.0
        set .normal is with x is 0.0, y is 0.0, z is 0.0

    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        if calling raylib.IsCursorHidden:
            calling raylib.UpdateCamera with (sigil of camera), raylib.CAMERA_FIRST_PERSON

        # Toggle camera controls
        if calling input.is_mouse_button_pressed with raylib.MOUSE_BUTTON_RIGHT:
            if calling raylib.IsCursorHidden:
                calling raylib.EnableCursor
            else:
                calling raylib.DisableCursor

        if calling input.is_mouse_button_pressed with raylib.MOUSE_BUTTON_LEFT:
            if not collision.hit:
                let mouse_pos as raylib.Vector2 is calling raylib.GetMousePosition
                set ray is (calling camera.to_world_ray with mouse_pos)

                # Check collision between ray and box
                let box as raylib.BoundingBox is calling make_cube_box with cube_position, cube_size
                set collision is (calling models.ray_box_hit with ray, box)
            else:
                set collision.hit is false
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        if collision.hit:
            calling shapes3d.draw_cube with cube_position, cube_size.x, cube_size.y, cube_size.z, raylib.RED
            calling shapes3d.draw_cube_wires with cube_position, cube_size.x, cube_size.y, cube_size.z, raylib.MAROON

            calling shapes3d.draw_cube_wires with cube_position, (cube_size.x + 0.2), (cube_size.y + 0.2), (cube_size.z + 0.2), raylib.GREEN
        else:
            calling shapes3d.draw_cube with cube_position, cube_size.x, cube_size.y, cube_size.z, raylib.GRAY
            calling shapes3d.draw_cube_wires with cube_position, cube_size.x, cube_size.y, cube_size.z, raylib.DARKGRAY

        calling shapes3d.draw_ray with ray, raylib.MAROON
        calling shapes3d.draw_grid with 10, 1.0

        calling drawing.end_mode_3d

        calling txt.draw_text with "Try clicking on the box with your mouse!", 240, 10, 20, raylib.DARKGRAY

        if collision.hit:
            let box_text_width as int is calling txt.measure_text with "BOX SELECTED", 30
            let box_text_x as int is (SCREEN_WIDTH - box_text_width) / 2
            let box_text_y as int is ((SCREEN_HEIGHT to f32) * 0.1) to int
            calling txt.draw_text with "BOX SELECTED", box_text_x, box_text_y, 30, raylib.GREEN

        calling txt.draw_text with "Right click mouse to toggle camera controls", 10, 430, 10, raylib.GRAY

        calling txt.draw_fps with 10, 10

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
