##
## ## PenguScript Port
## Ported to idiomatic PenguScript with raylibx wrappers and rayguix.
##
## ## Example
## ```shell
## pengu run examples/shapes/shapes_outlines_thickness.pengu
## ```

import pengu.raylib as raylib
import pengu.raylibx.drawing as drawing
import pengu.raylibx.shapes as shapes
import pengu.raylibx.text as txt
import pengu.rayguix as rayguix

# --- Helpers ---

## Formats a float to two decimal places
##
## ## Parameters
## - `val`: float value to format
##
## ## Returns
## Formatted string representation
weave format_float_2 with val as f32 into string:
    var sign as string is if val < 0.0 then "-" else ""
    var abs_val as f32 is if val < 0.0 then -val else val
    var int_part as int is abs_val to int
    var frac_part as int is ((abs_val - (int_part to f32)) * 100.0) to int
    var frac_str as string is if frac_part < 10 then "0{frac_part}" else "{frac_part}"
    defer banish frac_str
    return "{sign}{int_part}.{frac_str}"

# --- Entry point ---

## Application main entry point
weave main into int:
    # Initialization
    # --------------------------------------------------------------------------------------
    let screen_width as int is 800
    let screen_height as int is 450

    calling raylib.InitWindow with screen_width, screen_height, "raylib [shapes] example - outlines thickness"
    defer calling raylib.CloseWindow

    var thick as f32 is 5.0

    let slider_rec as raylib.Rectangle is with:
        set .x is 290.0
        set .y is 50.0
        set .width is 220.0
        set .height is 24.0

    let rec_plain as raylib.Rectangle is with:
        set .x is 35.0
        set .y is 180.0
        set .width is 220.0
        set .height is 220.0

    let rec_rounded as raylib.Rectangle is with:
        set .x is 290.0
        set .y is 180.0
        set .width is 220.0
        set .height is 220.0

    let circle_center as raylib.Vector2 is with:
        set .x is 655.0
        set .y is 290.0

    calling raylib.SetTargetFPS with 60
    # --------------------------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # ----------------------------------------------------------------------------------
        # No additional update logic needed
        # ----------------------------------------------------------------------------------

        # Draw
        # ----------------------------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        var thick_str as string is calling format_float_2 with thick
        calling rayguix.slider_bar with slider_rec, "Thickness", thick_str, (sigil of thick), -30.0, 30.0
        banish thick_str

        calling shapes.draw_rectangle with 35, 180, 220, 220, raylib.LIGHTGRAY
        calling rec_plain.draw_outline with thick, raylib.BLUE
        calling txt.draw_text with "DrawRectangleLinesEx()", 35, 160, 10, raylib.BLACK

        calling rec_rounded.draw_rounded with 0.2, 9, raylib.LIGHTGRAY
        calling rec_rounded.draw_rounded_outline with 0.2, 9, thick, raylib.BLUE
        calling txt.draw_text with "DrawRectangleRoundedLinesEx()", 290, 160, 10, raylib.BLACK

        calling shapes.draw_circle with 655, 290, 110.0, raylib.LIGHTGRAY
        calling raylib.DrawCircleLinesEx with circle_center, 110.0, thick, raylib.BLUE
        calling txt.draw_text with "DrawCircleLinesEx()", 545, 160, 10, raylib.BLACK

        calling drawing.end_drawing
        # ----------------------------------------------------------------------------------

    return 0
