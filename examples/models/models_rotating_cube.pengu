## examples/models/models_rotating_cube.pengu
## raylib [models] example - rotating cube
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 6.0, last time updated with raylib 6.0
##
## Example contributed by Jopestpe (@jopestpe)
##
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2025 Jopestpe (@jopestpe)
##
## ## PenguScript Port
## 1:1 translation of `examples/models/models_rotating_cube.c` on top of the
## `raylibx` wrapper layers (`drawing`, `images`, `models`, `shapes3d`, `text`,
## and `textures`). Generates a unit cube mesh, crops the bottom-left quadrant of
## `cubicmap_atlas.png` via `Image.region`, binds the resulting texture to the
## cube's diffuse/albedo map with `Material.set_texture`, and rotates the cube
## around an oblique axis each frame with `Model.draw_ex`.
##
## ## Example
## ```bash
## pengu run examples/models/models_rotating_cube.pengu
## ```

# --- Imports ------------------------------------------------------------
import raylib
import raylibx.drawing as drawing
import raylibx.images as images
import raylibx.models as models
import raylibx.shapes3d as shapes3d
import raylibx.text as txt
import raylibx.textures as textures

# --- Constants ----------------------------------------------------------
## Window width, in pixels.
const SCREEN_WIDTH as int is 800

## Window height, in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second for the main game loop.
const TARGET_FPS as int is 60

## Vertical field-of-view of the 3D camera, in degrees.
const CAMERA_FOVY as f32 is 45.0

## Angular increment added to the cube's rotation each frame, in degrees.
const ROTATION_STEP as f32 is 1.0

# --- Entry point --------------------------------------------------------
## Initializes a 3D scene with a textured cube model and rotates it around an
## oblique axis every frame.
##
## ## Returns
## Process exit code: `0` when the window closes normally.
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [models] example - rotating cube"
    defer calling raylib.CloseWindow

    # Define the camera to look into our 3D world
    var camera as raylib.Camera3D with:
        set .position is (with x is 0.0, y is 3.0, z is 3.0)
        set .target is (with x is 0.0, y is 0.0, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is CAMERA_FOVY
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    # Load image to create texture for the cube
    let cube_mesh as raylib.Mesh is calling raylib.GenMeshCube with 1.0, 1.0, 1.0
    var model as raylib.Model is calling models.load_model_from_mesh with cube_mesh
    defer calling models.unload_model with model

    var texture as raylib.Texture2D is with id is 0, width is 0, height is 0, mipmaps is 0, format is 0
    if loaded_img as raylib.Image is calling images.load_image with "resources/cubicmap_atlas.png":
        var img as raylib.Image is loaded_img
        let half_w as f32 is (img.width to f32) / 2.0
        let half_h as f32 is (img.height to f32) / 2.0
        let crop_rect as raylib.Rectangle is with x is 0.0, y is half_h, width is half_w, height is half_h
        var crop as raylib.Image is calling img.region with crop_rect
        if loaded_tex as raylib.Texture is calling textures.load_texture_from_image with crop:
            set texture is loaded_tex
        calling images.unload_image with img
        calling images.unload_image with crop
    defer calling textures.unload_texture with texture

    var mat0 as ref to raylib.Material is sigil of (model.materials at 0)
    calling mat0.set_texture with raylib.MATERIAL_MAP_ALBEDO, texture

    let model_pos as raylib.Vector3 is with x is 0.0, y is 0.0, z is 0.0
    let rotation_axis as raylib.Vector3 is with x is 0.5, y is 1.0, z is 0.0
    let model_scale as raylib.Vector3 is with x is 1.0, y is 1.0, z is 1.0
    var rotation as f32 is 0.0

    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        set rotation += ROTATION_STEP
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        # Draw model defining: position, rotation-axis, rotation (degrees), scale, and tint-color
        calling model.draw_ex with model_pos, rotation_axis, rotation, model_scale, raylib.WHITE
        calling shapes3d.draw_grid with 10, 1.0

        calling drawing.end_mode_3d

        calling txt.draw_fps with 10, 10

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
