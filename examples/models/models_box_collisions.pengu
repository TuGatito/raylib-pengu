## raylib [models] example - box collisions
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 1.3, last time updated with raylib 3.5
## Example licensed under an unmodified zlib/libpng license.
##
## ## PenguScript Port
## - Uses `raylibx.drawing` for frame and 3D mode scopes
## - Uses `raylibx.input` for arrow key controls
## - Uses `raylibx.models` for `boxes_collide` and `box_sphere_collide` checks
## - Uses `raylibx.shapes3d` for rendering cubes, spheres, wireframes, and grid
## - Uses `raylibx.text` for UI instructions and FPS display
##
## ## Example
## ```pengu
## pengu run examples/models/models_box_collisions.pengu
## ```

import raylib
import raylibx.drawing as drawing
import raylibx.input as input
import raylibx.models as models
import raylibx.shapes3d as shapes3d
import raylibx.text as txt

# --- Constants ---

## Target window width in pixels.
const SCREEN_WIDTH as int is 800

## Target window height in pixels.
const SCREEN_HEIGHT as int is 450

## Target frames per second.
const TARGET_FPS as int is 60

# --- Entry point ---

## Program main entry point.
##
## ## Returns
## Exit status code (0 for success).
weave main into int:
    # Initialization
    # ---------------------------------------------------------------------
    calling raylib.InitWindow with SCREEN_WIDTH, SCREEN_HEIGHT, "raylib [models] example - box collisions"
    defer calling raylib.CloseWindow

    var camera as raylib.Camera3D with:
        set .position is (with x is 0.0, y is 10.0, z is 10.0)
        set .target is (with x is 0.0, y is 0.0, z is 0.0)
        set .up is (with x is 0.0, y is 1.0, z is 0.0)
        set .fovy is 45.0
        set .projection is (raylib.CAMERA_PERSPECTIVE to int)

    var player_pos as raylib.Vector3 is with x is 0.0, y is 1.0, z is 2.0
    let player_size as raylib.Vector3 is with x is 1.0, y is 2.0, z is 1.0
    var player_color as raylib.Color is raylib.GREEN

    let enemy_box_pos as raylib.Vector3 is with x is -4.0, y is 1.0, z is 0.0
    let enemy_box_size as raylib.Vector3 is with x is 2.0, y is 2.0, z is 2.0

    let enemy_sphere_pos as raylib.Vector3 is with x is 4.0, y is 0.0, z is 0.0
    const ENEMY_SPHERE_SIZE as f32 is 1.5

    calling raylib.SetTargetFPS with TARGET_FPS
    # ---------------------------------------------------------------------

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        # -----------------------------------------------------------------
        if calling input.is_key_down with raylib.KEY_RIGHT:
            set player_pos.x += 0.2
        else if calling input.is_key_down with raylib.KEY_LEFT:
            set player_pos.x -= 0.2
        else if calling input.is_key_down with raylib.KEY_DOWN:
            set player_pos.z += 0.2
        else if calling input.is_key_down with raylib.KEY_UP:
            set player_pos.z -= 0.2

        var collision as bool is false

        # Player bounding box
        var player_box as raylib.BoundingBox with:
            set .min is (with x is player_pos.x - player_size.x/2.0, y is player_pos.y - player_size.y/2.0, z is player_pos.z - player_size.z/2.0)
            set .max is (with x is player_pos.x + player_size.x/2.0, y is player_pos.y + player_size.y/2.0, z is player_pos.z + player_size.z/2.0)

        # Enemy box bounding box
        var enemy_box as raylib.BoundingBox with:
            set .min is (with x is enemy_box_pos.x - enemy_box_size.x/2.0, y is enemy_box_pos.y - enemy_box_size.y/2.0, z is enemy_box_pos.z - enemy_box_size.z/2.0)
            set .max is (with x is enemy_box_pos.x + enemy_box_size.x/2.0, y is enemy_box_pos.y + enemy_box_size.y/2.0, z is enemy_box_pos.z + enemy_box_size.z/2.0)

        # Check collisions player vs enemy-box
        if calling models.boxes_collide with player_box, enemy_box:
            set collision is true

        # Check collisions player vs enemy-sphere
        if calling models.box_sphere_collide with player_box, enemy_sphere_pos, ENEMY_SPHERE_SIZE:
            set collision is true

        if collision:
            set player_color is raylib.RED
        else:
            set player_color is raylib.GREEN
        # -----------------------------------------------------------------

        # Draw
        # -----------------------------------------------------------------
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling drawing.begin_mode_3d with camera

        # Draw enemy box
        calling shapes3d.draw_cube with enemy_box_pos, enemy_box_size.x, enemy_box_size.y, enemy_box_size.z, raylib.GRAY
        calling shapes3d.draw_cube_wires with enemy_box_pos, enemy_box_size.x, enemy_box_size.y, enemy_box_size.z, raylib.DARKGRAY

        # Draw enemy sphere
        calling shapes3d.draw_sphere with enemy_sphere_pos, ENEMY_SPHERE_SIZE, raylib.GRAY
        calling shapes3d.draw_sphere_wires with enemy_sphere_pos, ENEMY_SPHERE_SIZE, 16, 16, raylib.DARKGRAY

        # Draw player
        calling player_pos.draw_cube with player_size, player_color

        calling shapes3d.draw_grid with 10, 1.0

        calling drawing.end_mode_3d

        calling txt.draw_text with "Move player with arrow keys to collide", 220, 40, 20, raylib.GRAY
        calling txt.draw_fps with 10, 10

        calling drawing.end_drawing
        # -----------------------------------------------------------------

    return 0
