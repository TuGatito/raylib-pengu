## raylib [text] example - font filters
##
## Example complexity rating: [★★☆☆] 2/4
##
## Example originally created with raylib 1.3, last time updated with raylib 4.2
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to idiomatic PenguScript using raylibx wrappers.
##
## ## Example
## ```shell
## pengu run examples/text/text_font_filters.pengu
## ```

import pengu.raylib as raylib
import pengu.raylibx.drawing as drawing
import pengu.raylibx.input as input
import pengu.raylibx.shapes as shapes
import pengu.raylibx.text as txt
import pengu.raylibx.textures as textures
import pengu.raylibx.files as files
import pengu.raylibx.colors as colors

# --- Helpers ---

## Formats a float value to two decimal places with 2-digit zero padding on integer part
##
## ## Parameters
## - `val`: float value to format
##
## ## Returns
## Formatted string with two decimals
weave format_float_2dp with val as f32 into string:
    let centis as int is (val * 100.0) to int
    let whole as int is centis / 100
    let frac as int is centis % 100
    let abs_frac as int is if frac < 0 then -frac else frac
    let frac_str as string is if abs_frac < 10 then "0{abs_frac}" else "{abs_frac}"
    defer banish frac_str
    let whole_str as string is if (whole >= 0 and whole < 10) then "0{whole}" else "{whole}"
    defer banish whole_str
    return "{whole_str}.{frac_str}"

# --- Main entry point ---

weave main into int:
    # Initialization
    const screen_width as int is 800
    const screen_height as int is 450

    calling raylib.InitWindow with screen_width, screen_height, "raylib [text] example - font filters"
    defer calling raylib.CloseWindow

    let msg as string is "Loaded Font"

    # Empty slice for default 95 ASCII codepoints
    let empty_cps as list of int is list of int
    defer banish empty_cps

    # TTF Font loading with custom generation parameters
    var font as raylib.Font is calling txt.default_font
    let maybe_font as maybe raylib.Font is calling txt.load_font_ex with "examples/text/resources/KAISG.ttf", 96, (empty_cps at 0 to 0)
    if loaded as raylib.Font is maybe_font:
        set font is loaded

    # Generate mipmap levels to use trilinear filtering
    calling raylib.GenTextureMipmaps with (sigil of font.texture)

    var font_size as f32 is font.baseSize to f32
    var font_position as raylib.Vector2 is with:
        set .x is 40.0
        set .y is ((screen_height to f32) / 2.0) - 80.0

    var text_size as raylib.Vector2 is with:
        set .x is 0.0
        set .y is 0.0

    # Setup initial texture scaling filter
    calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_POINT
    var current_font_filter as int is 0 # 0: POINT, 1: BILINEAR, 2: TRILINEAR

    calling raylib.SetTargetFPS with 60

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        let wheel_move as f32 is calling raylib.GetMouseWheelMove
        set font_size is font_size + (wheel_move * 4.0)

        # Choose font texture filter method
        if calling input.is_key_pressed with raylib.KEY_ONE:
            calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_POINT
            set current_font_filter is 0
        else if calling input.is_key_pressed with raylib.KEY_TWO:
            calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_BILINEAR
            set current_font_filter is 1
        else if calling input.is_key_pressed with raylib.KEY_THREE:
            calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_TRILINEAR
            set current_font_filter is 2

        set text_size is calling font.measure with msg, font_size, 0.0

        if calling input.is_key_down with raylib.KEY_LEFT:
            set font_position.x is font_position.x - 10.0
        else if calling input.is_key_down with raylib.KEY_RIGHT:
            set font_position.x is font_position.x + 10.0

        # Load a dropped TTF file dynamically (at current fontSize)
        if calling raylib.IsFileDropped:
            var dropped as list of string is calling files.dropped_files
            defer banish dropped
            if (dropped.length > 0) and (calling files.is_file_extension with (dropped at 0), ".ttf"):
                calling txt.unload_font with font
                let maybe_dropped_font as maybe raylib.Font is calling txt.load_font_ex with (dropped at 0), (font_size to int), (empty_cps at 0 to 0)
                if loaded_dropped as raylib.Font is maybe_dropped_font:
                    set font is loaded_dropped
                    calling raylib.GenTextureMipmaps with (sigil of font.texture)
                    if current_font_filter == 0:
                        calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_POINT
                    else if current_font_filter == 1:
                        calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_BILINEAR
                    else:
                        calling raylib.SetTextureFilter with font.texture, raylib.TEXTURE_FILTER_TRILINEAR

        # Draw
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling txt.draw_text with "Use mouse wheel to change font size", 20, 20, 10, raylib.GRAY
        calling txt.draw_text with "Use KEY_RIGHT and KEY_LEFT to move text", 20, 40, 10, raylib.GRAY
        calling txt.draw_text with "Use 1, 2, 3 to change texture filter", 20, 60, 10, raylib.GRAY
        calling txt.draw_text with "Drop a new TTF font for dynamic loading", 20, 80, 10, raylib.DARKGRAY

        calling font.draw with msg, font_position, font_size, 0.0, raylib.BLACK

        let sh as int is screen_height
        let sw as int is screen_width
        calling shapes.draw_rectangle with 0, sh - 80, sw, 80, raylib.LIGHTGRAY

        var size_val_str as string is calling format_float_2dp with font_size
        defer banish size_val_str
        var font_size_str as string is "Font size: {size_val_str}"
        defer banish font_size_str
        calling txt.draw_text with font_size_str, 20, sh - 50, 10, raylib.DARKGRAY

        var sx_str as string is calling format_float_2dp with text_size.x
        defer banish sx_str
        var sy_str as string is calling format_float_2dp with text_size.y
        defer banish sy_str
        var text_size_str as string is "Text size: [{sx_str}, {sy_str}]"
        defer banish text_size_str
        calling txt.draw_text with text_size_str, 20, sh - 30, 10, raylib.DARKGRAY

        calling txt.draw_text with "CURRENT TEXTURE FILTER:", 250, 400, 20, raylib.GRAY

        if current_font_filter == 0:
            calling txt.draw_text with "POINT", 570, 400, 20, raylib.BLACK
        else if current_font_filter == 1:
            calling txt.draw_text with "BILINEAR", 570, 400, 20, raylib.BLACK
        else if current_font_filter == 2:
            calling txt.draw_text with "TRILINEAR", 570, 400, 20, raylib.BLACK

        calling drawing.end_drawing

    # Unload font
    calling txt.unload_font with font

    return 0
