## raylib [text] example - font spritefont
##
## Example complexity rating: [★☆☆☆] 1/4
##
## Example originally created with raylib 1.0, last time updated with raylib 1.0
## Example licensed under an unmodified zlib/libpng license, which is an OSI-certified,
## BSD-like license that allows static linking with closed source software
##
## Copyright (c) 2014-2025 Ramon Santamaria (@raysan5)
##
## ## PenguScript Port
## Ported to idiomatic PenguScript using raylibx wrappers.
##
## ## Example
## ```shell
## pengu run examples/text/text_font_spritefont.pengu
## ```

import pengu.raylib as raylib
import pengu.raylibx.drawing as drawing
import pengu.raylibx.text as txt
import pengu.raylibx.colors as colors

# --- Main entry point ---

weave main into int:
    # Initialization
    const screen_width as int is 800
    const screen_height as int is 450

    calling raylib.InitWindow with screen_width, screen_height, "raylib [text] example - font spritefont"
    defer calling raylib.CloseWindow

    let msg1 as string is "THIS IS A custom SPRITE FONT..."
    let msg2 as string is "...and this is ANOTHER CUSTOM font..."
    let msg3 as string is "...and a THIRD one! GREAT! :D"

    # NOTE: Textures/Fonts MUST be loaded after Window initialization (OpenGL context is required)
    var font1 as raylib.Font is calling txt.default_font
    let maybe1 as maybe raylib.Font is calling txt.load_font with "examples/text/resources/custom_mecha.png"
    if loaded1 as raylib.Font is maybe1:
        set font1 is loaded1
    defer calling txt.unload_font with font1

    var font2 as raylib.Font is calling txt.default_font
    let maybe2 as maybe raylib.Font is calling txt.load_font with "examples/text/resources/custom_alagard.png"
    if loaded2 as raylib.Font is maybe2:
        set font2 is loaded2
    defer calling txt.unload_font with font2

    var font3 as raylib.Font is calling txt.default_font
    let maybe3 as maybe raylib.Font is calling txt.load_font with "examples/text/resources/custom_jupiter_crash.png"
    if loaded3 as raylib.Font is maybe3:
        set font3 is loaded3
    defer calling txt.unload_font with font3

    let m1 as raylib.Vector2 is calling font1.measure with msg1, (font1.baseSize to f32), -3.0
    let font_position1 as raylib.Vector2 is with:
        set .x is ((screen_width to f32) / 2.0) - (m1.x / 2.0)
        set .y is ((screen_height to f32) / 2.0) - ((font1.baseSize to f32) / 2.0) - 80.0

    let m2 as raylib.Vector2 is calling font2.measure with msg2, (font2.baseSize to f32), -2.0
    let font_position2 as raylib.Vector2 is with:
        set .x is ((screen_width to f32) / 2.0) - (m2.x / 2.0)
        set .y is ((screen_height to f32) / 2.0) - ((font2.baseSize to f32) / 2.0) - 10.0

    let m3 as raylib.Vector2 is calling font3.measure with msg3, (font3.baseSize to f32), 2.0
    let font_position3 as raylib.Vector2 is with:
        set .x is ((screen_width to f32) / 2.0) - (m3.x / 2.0)
        set .y is ((screen_height to f32) / 2.0) - ((font3.baseSize to f32) / 2.0) + 50.0

    calling raylib.SetTargetFPS with 60

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Draw
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        calling font1.draw with msg1, font_position1, (font1.baseSize to f32), -3.0, raylib.WHITE
        calling font2.draw with msg2, font_position2, (font2.baseSize to f32), -2.0, raylib.WHITE
        calling font3.draw with msg3, font_position3, (font3.baseSize to f32), 2.0, raylib.WHITE

        calling drawing.end_drawing

    return 0
