        "\xF0\x9F\xA4\xA2\x00\xF0\x9F\xA4\xAE\x00\xF0\x9F\xA4\xA7\x00\xF0\x9F\x98\x87\x00\xF0\x9F\xA4\xA0\x00\xF0\x9F\xA4\xAB\x00\xF0\x9F\xA4\xAD\x00\xF0\x9F\xA7\x90\x00"
        "\xF0\x9F\xA4\x93\x00\xF0\x9F\x98\x88\x00\xF0\x9F\x91\xBF\x00\xF0\x9F\x91\xB9\x00\xF0\x9F\x91\xBA\x00\xF0\x9F\x92\x80\x00\xF0\x9F\x91\xBB\x00\xF0\x9F\x91\xBD\x00"
        "\xF0\x9F\x91\xBE\x00\xF0\x9F\xA4\x96\x00\xF0\x9F\x92\xA9\x00\xF0\x9F\x98\xBA\x00\xF0\x9F\x98\xB8\x00\xF0\x9F\x98\xB9\x00\xF0\x9F\x98\xBB\x00\xF0\x9F\x98\xBD\x00"
        "\xF0\x9F\x99\x80\x00\xF0\x9F\x98\xBF\x00\xF0\x9F\x8C\xBE\x00\xF0\x9F\x8C\xBF\x00\xF0\x9F\x8D\x80\x00\xF0\x9F\x8D\x83\x00\xF0\x9F\x8D\x87\x00\xF0\x9F\x8D\x93\x00"
        "\xF0\x9F\xA5\x9D\x00\xF0\x9F\x8D\x85\x00\xF0\x9F\xA5\xA5\x00\xF0\x9F\xA5\x91\x00\xF0\x9F\x8D\x86\x00\xF0\x9F\xA5\x94\x00\xF0\x9F\xA5\x95\x00\xF0\x9F\x8C\xBD\x00"
        "\xF0\x9F\x8C\xB6\x00\xF0\x9F\xA5\x92\x00\xF0\x9F\xA5\xA6\x00\xF0\x9F\x8D\x84\x00\xF0\x9F\xA5\x9C\x00\xF0\x9F\x8C\xB0\x00\xF0\x9F\x8D\x9E\x00\xF0\x9F\xA5\x90\x00"
        "\xF0\x9F\xA5\x96\x00\xF0\x9F\xA5\xA8\x00\xF0\x9F\xA5\x9E\x00\xF0\x9F\xA7\x80\x00\xF0\x9F\x8D\x96\x00\xF0\x9F\x8D\x97\x00\xF0\x9F\xA5\xA9\x00\xF0\x9F\xA5\x93\x00"
        "\xF0\x9F\x8D\x94\x00\xF0\x9F\x8D\x9F\x00\xF0\x9F\x8D\x95\x00\xF0\x9F\x8C\xAD\x00\xF0\x9F\xA5\xAA\x00\xF0\x9F\x8C\xAE\x00\xF0\x9F\x8C\xAF\x00\xF0\x9F\xA5\x99\x00"
        "\xF0\x9F\xA5\x9A\x00\xF0\x9F\x8D\xB3\x00\xF0\x9F\xA5\x98\x00\xF0\x9F\x8D\xB2\x00\xF0\x9F\xA5\xA3\x00\xF0\x9F\xA5\x97\x00\xF0\x9F\x8D\xBF\x00\xF0\x9F\xA5\xAB\x00"
        "\xF0\x9F\x8D\xB1\x00\xF0\x9F\x8D\x98\x00\xF0\x9F\x8D\x9D\x00\xF0\x9F\x8D\xA0\x00\xF0\x9F\x8D\xA2\x00\xF0\x9F\x8D\xA5\x00\xF0\x9F\x8D\xA1\x00\xF0\x9F\xA5\x9F\x00"
        "\xF0\x9F\xA5\xA1\x00\xF0\x9F\x8D\xA6\x00\xF0\x9F\x8D\xAA\x00\xF0\x9F\x8E\x82\x00\xF0\x9F\x8D\xB0\x00\xF0\x9F\xA5\xA7\x00\xF0\x9F\x8D\xAB\x00\xF0\x9F\x8D\xAF\x00"
        "\xF0\x9F\x8D\xBC\x00\xF0\x9F\xA5\x9B\x00\xF0\x9F\x8D\xB5\x00\xF0\x9F\x8D\xB6\x00\xF0\x9F\x8D\xBE\x00\xF0\x9F\x8D\xB7\x00\xF0\x9F\x8D\xBB\x00\xF0\x9F\xA5\x82\x00"
        "\xF0\x9F\xA5\x83\x00\xF0\x9F\xA5\xA4\x00\xF0\x9F\xA5\xA2\x00\xF0\x9F\x91\x81\x00\xF0\x9F\x91\x85\x00\xF0\x9F\x91\x84\x00\xF0\x9F\x92\x8B\x00\xF0\x9F\x92\x98\x00"
        "\xF0\x9F\x92\x93\x00\xF0\x9F\x92\x97\x00\xF0\x9F\x92\x99\x00\xF0\x9F\x92\x9B\x00\xF0\x9F\xA7\xA1\x00\xF0\x9F\x92\x9C\x00\xF0\x9F\x96\xA4\x00\xF0\x9F\x92\x9D\x00"
        "\xF0\x9F\x92\x9F\x00\xF0\x9F\x92\x8C\x00\xF0\x9F\x92\xA4\x00\xF0\x9F\x92\xA2\x00\xF0\x9F\x92\xA3\x00";
    return &emojiCodepoints[idx];
    """

## Returns the text of a message by index
antiquus get_message_text with idx as int into ref to frozen char:
    r"""
    static const char *const msgs[] = {
        "Falsches Üben von Xylophonmusik quält jeden größeren Zwerg",
        "Beiß nicht in die Hand, die dich füttert.",
        "Außerordentliche Übel erfordern außerordentliche Mittel.",
        "\xD4\xBF\xD6\x80\xD5\xB6\xD5\xA1\xD5\xB4\x20\xD5\xA1\xD5\xBA\xD5\xA1\xD5\xAF\xD5\xAB\x20\xD5\xB8\xD6\x82\xD5\xBF\xD5\xA5\xD5\xAC\x20\xD6\x87\x20\xD5\xAB\xD5\xB6\xD5\xAE\xD5\xAB\x20\xD5\xA1\xD5\xB6\xD5\xB0\xD5\xA1\xD5\xB6\xD5\xA3\xD5\xAB\xD5\xBD\xD5\xBF\x20\xD5\xB9\xD5\xA8\xD5\xB6\xD5\xA5\xD6\x80",
        "\xD4\xB5\xD6\x80\xD5\xA2\x20\xD5\xB8\xD6\x82\x20\xD5\xAF\xD5\xA1\xD6\x81\xD5\xAB\xD5\xB6\xD5\xA8\x20\xD5\xA5\xD5\xAF\xD5\xA1\xD6\x82\x20\xD5\xA1\xD5\xB6\xD5\xBF\xD5\xA1\xD5\xBC\x2C\x20\xD5\xAE\xD5\xA1\xD5\xBC\xD5\xA5\xD6\x80\xD5\xA8\x20\xD5\xA1\xD5\xBD\xD5\xA1\xD6\x81\xD5\xAB\xD5\xB6\x2E\x2E\x2E\x20\xC2\xAB\xD4\xBF\xD5\xB8\xD5\xBF\xD5\xA8\x20\xD5\xB4\xD5\xA5\xD6\x80\xD5\xB8\xD5\xB6\xD6\x81\xD5\xAB\xD6\x81\x20\xD5\xA7\x3A\xC2\xBB",
        "\xD4\xB3\xD5\xA1\xD5\xBC\xD5\xA8\xD5\x9D\x20\xD5\xA3\xD5\xA1\xD6\x80\xD5\xB6\xD5\xA1\xD5\xB6\x2C\x20\xD5\xB1\xD5\xAB\xD6\x82\xD5\xB6\xD5\xA8\xD5\x9D\x20\xD5\xB1\xD5\xB4\xD5\xBC\xD5\xA1\xD5\xB6",
        "Jeżu klątw, spłódź Finom część gry hańb!",
        "Dobrymi chęciami jest piekło wybrukowane.",
        "Îți mulțumesc că ai ales raylib.\nȘi sper să ai o zi bună!",
        "Эх, чужак, общий съём цен шляп (юфть) вдрызг!",
        "Я люблю raylib!",
        "Молчи, скрывайся и таи\nИ чувства и мечты свои –\nПускай в душевной глубине\nИ всходят и зайдут оне\nКак звезды ясные в ночи-\nЛюбуйся ими – и молчи.",
        "Voix ambiguë d’un cœur qui au zéphyr préfère les jattes de kiwi",
        "Benjamín pidió una bebida de kiwi y fresa; Noé, sin vergüenza, la más exquisita champaña del menú.",
        "Ταχίστη αλώπηξ βαφής ψημένη γη, δρασκελίζει υπέρ νωθρού κυνός",
        "Η καλύτερη άμυνα είναι η επίθεση.",
        "Χρόνια και ζαμάνια!",
        "Πώς τα πας σήμερα;",
        "我能吞下玻璃而不伤身体。",
        "你吃了吗？",
        "不作不死。",
        "最近好吗？",
        "塞翁失马，焉知非福。",
        "千军易得, 一将难求",
        "万事开头难。",
        "风无常顺，兵无常胜。",
        "活到老，学到老。",
        "一言既出，驷马难追。",
        "路遥知马力，日久见人心",
        "有理走遍天下，无理寸步难行。",
        "猿も木から落ちる",
        "亀の甲より年の功",
        "うらやまし  思い切る時  猫の恋",
        "虎穴に入らずんば虎子を得ず。",
        "二兎を追う者は一兎をも得ず。",
        "馬鹿は死ななきゃ治らない。",
        "枯野路に 影かさなりて わかれけり",
        "繰り返し麦の畝縫ふ胡蝶哉",
        "아득한 바다 위에 갈매기 두엇 날아 돈다.\n너훌너훌 시를 쓴다. 모르는 나라 글자다.\n널따란 하늘 복판에 나도 같이 시를 쓴다.",
        "제 눈에 안경이다",
        "꿩 먹고 알 먹는다",
        "로마는 하루아침에 이루어진 것이 아니다",
        "고생 끝에 낙이 온다",
        "개천에서 용 난다",
        "안녕하세요?",
        "만나서 반갑습니다",
        "한국말 하실 줄 아세요?"
    };
    return msgs[idx];
    """

## Returns the language name of a message by index
antiquus get_message_lang with idx as int into ref to frozen char:
    r"""
    static const char *const langs[] = {
        "German", "German", "German",
        "Armenian", "Armenian", "Armenian",
        "Polish", "Polish",
        "Romanian",
        "Russian", "Russian", "Russian",
        "French",
        "Spanish",
        "Greek", "Greek", "Greek", "Greek",
        "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese", "Chinese",
        "Japanese", "Japanese", "Japanese", "Japanese", "Japanese", "Japanese", "Japanese", "Japanese",
        "Korean", "Korean", "Korean", "Korean", "Korean", "Korean", "Korean", "Korean", "Korean"
    };
    return langs[idx];
    """

## Returns the total count of messages
antiquus get_message_count into int:
    r"""
    return 47;
    """

# --- Helpers ---

## Draws text using font inside rectangle limits with word wrapping
weave draw_text_boxed with font as raylib.Font, text_ptr as ref to frozen char, rec as raylib.Rectangle, font_size as f32, spacing as f32, word_wrap as bool, tint as raylib.Color into void:
    let length as int is calling raylib.TextLength with text_ptr
    if length == 0:
        return

    var text_offset_y as f32 is 0.0
    var text_offset_x as f32 is 0.0
    let scale_factor as f32 is font_size / (font.baseSize to f32)

    var state as int is if word_wrap then 0 else 1
    var start_line as int is -1
    var end_line as int is -1

    var i as int is 0

    while i < length:
        var codepoint_byte_count as int is 0
        let ptr as ref to frozen char is sigil of (text_ptr at i)
        var codepoint as int is calling raylib.GetCodepoint with ptr, sigil of codepoint_byte_count
        let index as int is calling raylib.GetGlyphIndex with font, codepoint

        if codepoint == 63:
            set codepoint_byte_count is 1
        set i is i + (codepoint_byte_count - 1)

        let glyph as raylib.GlyphInfo is font.glyphs at index
        let glyph_rec as raylib.Rectangle is font.recs at index

        var glyph_width as f32 is 0.0
        if codepoint != 10:
            if glyph.advanceX == 0:
                set glyph_width is glyph_rec.width * scale_factor
            else:
                set glyph_width is (glyph.advanceX to f32) * scale_factor

            if (i + 1) < length:
                set glyph_width is glyph_width + spacing

        if state == 0:
            if (codepoint == 32) or (codepoint == 9) or (codepoint == 10):
                set end_line is i

            if (text_offset_x + glyph_width) > rec.width:
                set end_line is if end_line < 1 then i else end_line
                if i == end_line:
                    set end_line is end_line - codepoint_byte_count
                if (start_line + codepoint_byte_count) == end_line:
                    set end_line is i - codepoint_byte_count

                set state is 1
            else:
                if (i + 1) == length:
                    set end_line is i
                    set state is 1
                else:
                    if codepoint == 10:
                        set state is 1

            if state == 1:
                set text_offset_x is 0.0
                set i is start_line
                set glyph_width is 0.0
        else:
            let line_height as f32 is ((font.baseSize to f32) + ((font.baseSize to f32) / 2.0)) * scale_factor
            if codepoint == 10:
                if not word_wrap:
                    set text_offset_y is text_offset_y + line_height
                    set text_offset_x is 0.0
            else:
                if (not word_wrap) and ((text_offset_x + glyph_width) > rec.width):
                    set text_offset_y is text_offset_y + line_height
                    set text_offset_x is 0.0

                if (text_offset_y + ((font.baseSize to f32) * scale_factor)) > rec.height:
                    return

                if (codepoint != 32) and (codepoint != 9):
                    calling font.draw_codepoint with codepoint, (with x is (rec.x + text_offset_x), y is (rec.y + text_offset_y)), font_size, tint

            if word_wrap and (i == end_line):
                set text_offset_y is text_offset_y + line_height
                set text_offset_x is 0.0
                set start_line is end_line
                set end_line is -1
                set glyph_width is 0.0
                set state is 0

        if (text_offset_x != 0.0) or (codepoint != 32):
            set text_offset_x is text_offset_x + glyph_width

        set i is i + 1

## Randomizes the list of emojis with random colors, icons, and messages
weave randomize_emojis with msg_count as int into list of EmojiItem:
    var items as list of EmojiItem is []
    let start as int is calling random.between with 45, 360
    for i from 0 to TOTAL_EMOJIS:
        let emo_idx as int is (calling random.between with 0, 179) * 5
        let hue as f32 is ((start * (i + 1)) % 360) to f32
        let base_col as raylib.Color is calling raylib.ColorFromHSV with hue, 0.6, 0.85
        let col as raylib.Color is calling colors.fade with base_col, 0.8
        let msg_idx as int is calling random.between with 0, msg_count - 1
        var item as EmojiItem with:
            set .index is emo_idx
            set .message is msg_idx
            set .color is col
        calling items.push with item
    return items

# --- Entry point ---

## Program main entry point
weave entry into int:
    # Initialization
    let screen_width as int is 800
    let screen_height as int is 450

    calling raylib.SetConfigFlags with ((raylib.FLAG_MSAA_4X_HINT to int) | (raylib.FLAG_VSYNC_HINT to int))
    calling raylib.InitWindow with screen_width, screen_height, "raylib [text] example - unicode emojis"
    defer calling raylib.CloseWindow

    # Load font resources
    var font_default as raylib.Font is calling txt.default_font
    if loaded_def as raylib.Font is calling txt.load_font with "examples/text/resources/dejavu.fnt":
        set font_default is loaded_def
    defer calling raylib.UnloadFont with font_default

    var font_asian as raylib.Font is calling txt.default_font
    if loaded_asia as raylib.Font is calling txt.load_font with "examples/text/resources/noto_cjk.fnt":
        set font_asian is loaded_asia
    defer calling raylib.UnloadFont with font_asian

    var font_emoji as raylib.Font is calling txt.default_font
    if loaded_emo as raylib.Font is calling txt.load_font with "examples/text/resources/symbola.fnt":
        set font_emoji is loaded_emo
    defer calling raylib.UnloadFont with font_emoji

    let total_messages as int is calling get_message_count
    var emojis as list of EmojiItem is calling randomize_emojis with total_messages
    defer banish emojis

    var hovered as int is -1
    var selected as int is -1
    var hovered_pos as raylib.Vector2 is with x is 0.0, y is 0.0
    var selected_pos as raylib.Vector2 is with x is 0.0, y is 0.0

    calling raylib.SetTargetFPS with 60

    # Main game loop
    while not calling raylib.WindowShouldClose:
        # Update
        if calling input.is_key_pressed with raylib.KEY_SPACE:
            banish emojis
            set emojis is calling randomize_emojis with total_messages
            set hovered is -1
            set selected is -1

        if (calling input.is_mouse_button_pressed with raylib.MOUSE_BUTTON_LEFT) and (hovered != -1) and (hovered != selected):
            set selected is hovered
            set selected_pos is hovered_pos

        let mouse as raylib.Vector2 is calling raylib.GetMousePosition
        var position as raylib.Vector2 is with x is 28.8, y is 10.0
        set hovered is -1

        # Draw
        calling drawing.begin_drawing
        calling drawing.clear_background with raylib.RAYWHITE

        # Draw random emojis in the background
        for i from 0 to TOTAL_EMOJIS:
            let item as EmojiItem is emojis at i
            let txt_ptr as ref to frozen char is calling get_emoji_ptr with item.index
            let emo_size as f32 is font_emoji.baseSize to f32
            let emoji_rect as raylib.Rectangle is with x is position.x, y is position.y, width is emo_size, height is emo_size

            let emo_c_str as string is calling ffi.string_from_cstr with (transmute txt_ptr to ref to char)
            if not (calling raylib.CheckCollisionPointRec with mouse, emoji_rect):
                let tint_col as raylib.Color is if selected == i then item.color else (calling colors.fade with raylib.LIGHTGRAY, 0.4)
                calling font_emoji.draw with emo_c_str, position, emo_size, 1.0, tint_col
            else:
                calling font_emoji.draw with emo_c_str, position, emo_size, 1.0, item.color
                set hovered is i
                set hovered_pos is position
            banish emo_c_str

            if (i != 0) and ((i % EMOJI_PER_WIDTH) == 0):
                set position.y is position.y + (font_emoji.baseSize to f32) + 24.25
                set position.x is 28.8
            else:
                set position.x is position.x + (font_emoji.baseSize to f32) + 28.8

        # Draw the message when an emoji is selected
        if selected != -1:
            let sel_item as EmojiItem is emojis at selected
            let msg_idx as int is sel_item.message
            let horizontal_padding as f32 is 20.0
            let vertical_padding as f32 is 30.0

            let msg_ptr as ref to frozen char is calling get_message_text with msg_idx
            let lang_ptr as ref to frozen char is calling get_message_lang with msg_idx
            let lang_str as string is calling ffi.string_from_cstr with (transmute lang_ptr to ref to char)
            defer banish lang_str

            var font_active as raylib.Font is font_default
            if (lang_str == "Chinese") or (lang_str == "Korean") or (lang_str == "Japanese"):
                set font_active is font_asian

            let msg_text_str as string is calling ffi.string_from_cstr with (transmute msg_ptr to ref to char)
            defer banish msg_text_str

            var sz as raylib.Vector2 is calling raylib.MeasureTextEx with font_active, msg_ptr, (font_active.baseSize to f32), 1.0
            if sz.x > 300.0:
                set sz.y is sz.y * (sz.x / 300.0)
                set sz.x is 300.0
            else:
                if sz.x < 160.0:
                    set sz.x is 160.0

            var msg_rect as raylib.Rectangle is with x is (selected_pos.x - 38.8), y is (selected_pos.y - ((2.0 * vertical_padding) + sz.y)), width is ((2.0 * horizontal_padding) + sz.x), height is ((2.0 * vertical_padding) + sz.y)

            var a as raylib.Vector2 is with x is selected_pos.x, y is (msg_rect.y + msg_rect.height)
            var b as raylib.Vector2 is with x is (a.x + 8.0), y is (a.y + 10.0)
            var c as raylib.Vector2 is with x is (a.x + 10.0), y is a.y

            if msg_rect.x < 10.0:
                set msg_rect.x is msg_rect.x + 28.0
            if msg_rect.y < 10.0:
                set msg_rect.y is selected_pos.y + 84.0
                set a.y is msg_rect.y
                set c.y is a.y
                set b.y is a.y - 10.0
                let tmp as raylib.Vector2 is a
                set a is b
                set b is tmp

            if (msg_rect.x + msg_rect.width) > (screen_width to f32):
                set msg_rect.x is msg_rect.x - ((msg_rect.x + msg_rect.width) - (screen_width to f32) + 10.0)

            # Draw chat bubble
            calling msg_rect.draw with sel_item.color
            calling a.draw_triangle with b, c, sel_item.color

            # Draw the main text message
            let text_rect as raylib.Rectangle is with x is (msg_rect.x + (horizontal_padding / 2.0)), y is (msg_rect.y + (vertical_padding / 2.0)), width is (msg_rect.width - horizontal_padding), height is msg_rect.height
            calling draw_text_boxed with font_active, msg_ptr, text_rect, (font_active.baseSize to f32), 1.0, true, raylib.WHITE

            # Draw info text below message
            let byte_count as int is calling raylib.TextLength with msg_ptr
            let cp_count as int is calling raylib.GetCodepointCount with msg_ptr
            let info as string is "{lang_str} {cp_count} characters {byte_count} bytes"
            defer banish info
            let c_info as ref to frozen char is calling ffi.cstr_from_string with info
            defer calling ffi.cstr_free with (transmute c_info to ref to char)
            let def_font as raylib.Font is calling txt.default_font
            let info_sz as raylib.Vector2 is calling raylib.MeasureTextEx with def_font, c_info, 10.0, 1.0

            let info_x as int is (text_rect.x + text_rect.width - info_sz.x) to int
            let info_y as int is (msg_rect.y + msg_rect.height - info_sz.y - 2.0) to int
            calling txt.draw_text with info, info_x, info_y, 10, raylib.RAYWHITE

        # Draw the bottom info text
        calling txt.draw_text with "These emojis have something to tell you, click each to find out!", (screen_width - 650) / 2, screen_height - 40, 20, raylib.GRAY
        calling txt.draw_text with "Each emoji is a unicode character from a font, not a texture... Press [SPACEBAR] to refresh", (screen_width - 484) / 2, screen_height - 16, 10, raylib.GRAY

        calling drawing.end_drawing

    return 0
