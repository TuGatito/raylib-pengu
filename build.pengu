## build.pengu -- parte nativa de raylib-pengu.
##
## Se ejecuta solo con `psc add ... --trust` / `psc update --trust`.
## Manualmente: `psc run build.pengu -- --force`.
##
## Orden de busqueda del arbol de raylib:
##   1. $RAYLIB_SRC (checkout ya compilado o por compilar)
##   2. build/raylib-src (cache local de una ejecucion anterior)
##   3. clonar https://github.com/raysan5/raylib.git en build/raylib-src
##
## El resultado se copia a lib/libraylib.a. El binding enlaza con `link
## "raylib"`, y el driver anade automaticamente `<paquete>/lib` a -L.
## Si no hay git/make/red, el script falla: no se acepta silenciosamente una
## raylib del sistema porque los headers del binding son la fuente de verdad.

import std.archivum
import std.compass
import std.rites
import std.spark

const RAYLIB_REPO as string is "https://github.com/raysan5/raylib.git"

weave log with msg as string into void:
    calling spark.println with "[raylib-pengu] {msg}"

weave forced into bool:
    var args as list of string is calling rites.get_args
    var i as int is 0
    var out as bool is false
    while i < args.len:
        if (args at i) == "--force" or (args at i) == "--rebuild":
            set out is true
        banish args at i
        set i is i + 1
    banish args
    return out

weave main into int:
    var lib as string is "lib/libraylib.a"
    if (not calling forced) and calling archivum.is_file with lib:
        calling log with "libraylib.a already present; nothing to do"
        return 0

    var src as string is calling rites.getenv_or with "RAYLIB_SRC", ""
    if src length > 0 and not calling archivum.is_file with "{src}/src/Makefile":
        calling spark.eprintln with "[raylib-pengu] RAYLIB_SRC does not look like a raylib checkout: {src}"
        banish src
        return 1
    if src length == 0:
        var cached as string is "build/raylib-src"
        if calling archivum.is_file with "{cached}/src/Makefile":
            set src is cached
        else:
            banish cached
    if src length == 0:
        var ref as string is calling rites.getenv_or with "RAYLIB_REF", "master"
        calling archivum.create_dir with "build", true
        calling log with "cloning raylib {ref}"
        var cmd as string is "git clone --depth 1 --branch {ref} {RAYLIB_REPO} build/raylib-src"
        var rc as int is calling rites.run_shell with cmd
        banish cmd
        banish ref
        if rc != 0:
            calling spark.eprintln with "[raylib-pengu] git clone failed"
            banish src
            return 1
        var parts as list of string is ["build", "raylib-src"]
        set src is calling compass.join with parts
        banish parts

    var jobs as string is calling rites.getenv_or with "RAYLIB_JOBS", ""
    var jflag as string is ""
    if jobs length > 0:
        set jflag is " -j{jobs}"
    banish jobs
    calling log with "building {src}"
    var make as string is "make -C {src}/src PLATFORM=PLATFORM_DESKTOP{jflag}"
    var mrc as int is calling rites.run_shell with make
    banish make
    banish jflag
    if mrc != 0:
        calling spark.eprintln with "[raylib-pengu] make failed"
        banish src
        return 1
    if not calling archivum.is_file with "{src}/src/libraylib.a":
        calling spark.eprintln with "[raylib-pengu] make did not produce src/libraylib.a"
        banish src
        return 1
    calling archivum.create_dir with "lib", true
    var ok as bool is calling archivum.copy_file with "{src}/src/libraylib.a", lib, true
    banish src
    if not ok:
        calling spark.eprintln with "[raylib-pengu] cannot copy libraylib.a"
        return 1
    calling log with "wrote lib/libraylib.a"
    var emcc as maybe string is calling rites.which with "emcc"
    if emcc.is_present:
        calling log with "building wasm archive"
        var wmake as string is "make -C build/raylib-src/src PLATFORM=PLATFORM_WEB"
        var wrc as int is calling rites.run_shell with wmake
        banish wmake
        if wrc == 0 and calling archivum.is_file with "build/raylib-src/src/libraylib.web.a":
            calling archivum.create_dir with "lib/wasm", true
            var wok as bool is calling archivum.copy_file with "build/raylib-src/src/libraylib.web.a", "lib/wasm/libraylib.a", true
            if wok:
                calling log with "wrote lib/wasm/libraylib.a"
    banish emcc
    return 0
