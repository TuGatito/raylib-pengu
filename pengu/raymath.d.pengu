## PenguScript declaration binding generated by 'pengu bind'.
## Source header: raymath.h
include "raymath.h"

# raymath.h is header-only: every function is an `inline` definition in the
# header, and it reuses raylib's Vector2/Vector3/Vector4/Quaternion/Matrix. So
# this binding shares the types with `raylib` instead of declaring its own copy
# (a second `Matrix` would be a different PenguScript type).
#
# `pengu bind` drops function *definitions*, so the declarations below were
# generated from a prototype-only copy of the header. At the C level the
# out-of-line definitions come from libraylib itself: rcore.c defines
# RAYMATH_IMPLEMENTATION before including raymath.h, so every one of these
# functions is an exported symbol of the library.
import raylib

link "m"

# -- Constants (#define) ------------------------------

const PI as f64 is 3.14159265358979323846
const EPSILON as f64 is 0.000001

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

# Vector2, Vector3, Vector4, Quaternion and Matrix come from `import raylib`.

# Vector3 with 3 float lanes used by the matrix helpers below
rune float3:
    v as f32

# Matrix with 16 float lanes used by the matrix helpers below
rune float16:
    v as f32

# Clamp float value
declare Clamp with value as f32, min as f32, max as f32 into f32

# Calculate linear interpolation between two floats
declare Lerp with start as f32, end as f32, amount as f32 into f32

# Normalize input value within input range
declare Normalize with value as f32, start as f32, end as f32 into f32

# Remap input value within input range to output range
declare Remap with value as f32, inputStart as f32, inputEnd as f32, outputStart as f32, outputEnd as f32 into f32

# Wrap input value from min to max
declare Wrap with value as f32, min as f32, max as f32 into f32

# Check whether two given floats are almost equal
declare FloatEquals with x as f32, y as f32 into int

# Vector with components value 0.0f
declare Vector2Zero into Vector2

# Vector with components value 1.0f
declare Vector2One into Vector2

# Add two vectors (v1 + v2)
declare Vector2Add with v1 as Vector2, v2 as Vector2 into Vector2

# Add vector and float value
declare Vector2AddValue with v as Vector2, add as f32 into Vector2

# Subtract two vectors (v1 - v2)
declare Vector2Subtract with v1 as Vector2, v2 as Vector2 into Vector2

# Subtract vector by float value
declare Vector2SubtractValue with v as Vector2, sub as f32 into Vector2

# Calculate vector length
declare Vector2Length with v as Vector2 into f32

# Calculate vector square length
declare Vector2LengthSqr with v as Vector2 into f32

# Calculate two vectors dot product
declare Vector2DotProduct with v1 as Vector2, v2 as Vector2 into f32

# Calculate two vectors cross product
declare Vector2CrossProduct with v1 as Vector2, v2 as Vector2 into f32

# Calculate distance between two vectors
declare Vector2Distance with v1 as Vector2, v2 as Vector2 into f32

# Calculate square distance between two vectors
declare Vector2DistanceSqr with v1 as Vector2, v2 as Vector2 into f32

# Calculate the signed angle from v1 to v2, relative to the origin (0, 0)
# NOTE: Coordinate system convention: positive X right, positive Y down
# positive angles appear clockwise, and negative angles appear counterclockwise
declare Vector2Angle with v1 as Vector2, v2 as Vector2 into f32

# Calculate angle defined by a two vectors line
# NOTE: Parameters need to be normalized
# Current implementation should be aligned with glm::angle
declare Vector2LineAngle with start as Vector2, end as Vector2 into f32

# Scale vector (multiply by value)
declare Vector2Scale with v as Vector2, scale as f32 into Vector2

# Multiply vector by vector
declare Vector2Multiply with v1 as Vector2, v2 as Vector2 into Vector2

# Negate vector
declare Vector2Negate with v as Vector2 into Vector2

# Divide vector by vector
declare Vector2Divide with v1 as Vector2, v2 as Vector2 into Vector2

# Normalize provided vector
declare Vector2Normalize with v as Vector2 into Vector2

# Transforms a Vector2 by a given Matrix
declare Vector2Transform with v as Vector2, mat as Matrix into Vector2

# Calculate linear interpolation between two vectors
declare Vector2Lerp with v1 as Vector2, v2 as Vector2, amount as f32 into Vector2

# Calculate reflected vector to normal
declare Vector2Reflect with v as Vector2, normal as Vector2 into Vector2

# Get min value for each pair of components
declare Vector2Min with v1 as Vector2, v2 as Vector2 into Vector2

# Get max value for each pair of components
declare Vector2Max with v1 as Vector2, v2 as Vector2 into Vector2

# Rotate vector by angle
declare Vector2Rotate with v as Vector2, angle as f32 into Vector2

# Move Vector towards target
declare Vector2MoveTowards with v as Vector2, target as Vector2, maxDistance as f32 into Vector2

# Invert the given vector
declare Vector2Invert with v as Vector2 into Vector2

# Clamp the components of the vector between
# min and max values specified by the given vectors
declare Vector2Clamp with v as Vector2, min as Vector2, max as Vector2 into Vector2

# Clamp the magnitude of the vector between two min and max values
declare Vector2ClampValue with v as Vector2, min as f32, max as f32 into Vector2

# Check whether two given vectors are almost equal
declare Vector2Equals with p as Vector2, q as Vector2 into int

# Compute the direction of a refracted ray
# v: normalized direction of the incoming ray
# n: normalized normal vector of the interface of two optical media
# r: ratio of the refractive index of the medium from where the ray comes
# to the refractive index of the medium on the other side of the surface
declare Vector2Refract with v as Vector2, n as Vector2, r as f32 into Vector2

# Vector with components value 0.0f
declare Vector3Zero into Vector3

# Vector with components value 1.0f
declare Vector3One into Vector3

# Add two vectors
declare Vector3Add with v1 as Vector3, v2 as Vector3 into Vector3

# Add vector and float value
declare Vector3AddValue with v as Vector3, add as f32 into Vector3

# Subtract two vectors
declare Vector3Subtract with v1 as Vector3, v2 as Vector3 into Vector3

# Subtract vector by float value
declare Vector3SubtractValue with v as Vector3, sub as f32 into Vector3

# Multiply vector by scalar
declare Vector3Scale with v as Vector3, scalar as f32 into Vector3

# Multiply vector by vector
declare Vector3Multiply with v1 as Vector3, v2 as Vector3 into Vector3

# Calculate two vectors cross product
declare Vector3CrossProduct with v1 as Vector3, v2 as Vector3 into Vector3

# Calculate one vector perpendicular vector
declare Vector3Perpendicular with v as Vector3 into Vector3

# Calculate vector length
declare Vector3Length with v as frozen Vector3 into f32

# Calculate vector square length
declare Vector3LengthSqr with v as frozen Vector3 into f32

# Calculate two vectors dot product
declare Vector3DotProduct with v1 as Vector3, v2 as Vector3 into f32

# Calculate distance between two vectors
declare Vector3Distance with v1 as Vector3, v2 as Vector3 into f32

# Calculate square distance between two vectors
declare Vector3DistanceSqr with v1 as Vector3, v2 as Vector3 into f32

# Calculate angle between two vectors
declare Vector3Angle with v1 as Vector3, v2 as Vector3 into f32

# Negate provided vector (invert direction)
declare Vector3Negate with v as Vector3 into Vector3

# Divide vector by vector
declare Vector3Divide with v1 as Vector3, v2 as Vector3 into Vector3

# Normalize provided vector
declare Vector3Normalize with v as Vector3 into Vector3

# Calculate the projection of the vector v1 on to v2
declare Vector3Project with v1 as Vector3, v2 as Vector3 into Vector3

# Calculate the rejection of the vector v1 on to v2
declare Vector3Reject with v1 as Vector3, v2 as Vector3 into Vector3

# Orthonormalize provided vectors
# Makes vectors normalized and orthogonal to each other
# Gram-Schmidt function implementation
declare Vector3OrthoNormalize with v1 as ref to Vector3, v2 as ref to Vector3 into void

# Transforms a Vector3 by a given Matrix
declare Vector3Transform with v as Vector3, mat as Matrix into Vector3

# Transform a vector by quaternion rotation
declare Vector3RotateByQuaternion with v as Vector3, q as Quaternion into Vector3

# Rotates a vector around an axis
declare Vector3RotateByAxisAngle with v as Vector3, axis as Vector3, angle as f32 into Vector3

# Move Vector towards target
declare Vector3MoveTowards with v as Vector3, target as Vector3, maxDistance as f32 into Vector3

# Calculate linear interpolation between two vectors
declare Vector3Lerp with v1 as Vector3, v2 as Vector3, amount as f32 into Vector3

# Calculate cubic hermite interpolation between two vectors and their tangents
# as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
declare Vector3CubicHermite with v1 as Vector3, tangent1 as Vector3, v2 as Vector3, tangent2 as Vector3, amount as f32 into Vector3

# Calculate reflected vector to normal
declare Vector3Reflect with v as Vector3, normal as Vector3 into Vector3

# Get min value for each pair of components
declare Vector3Min with v1 as Vector3, v2 as Vector3 into Vector3

# Get max value for each pair of components
declare Vector3Max with v1 as Vector3, v2 as Vector3 into Vector3

# Compute barycenter coordinates (u, v, w) for point p with respect to triangle (a, b, c)
# NOTE: Assumes P is on the plane of the triangle
declare Vector3Barycenter with p as Vector3, a as Vector3, b as Vector3, c as Vector3 into Vector3

# Projects a Vector3 from screen space into object space
# NOTE: Self-contained function, no other raymath functions are called
declare Vector3Unproject with source as Vector3, projection as Matrix, view as Matrix into Vector3

# Get Vector3 as float array
declare Vector3ToFloatV with v as Vector3 into float3

# Invert the given vector
declare Vector3Invert with v as Vector3 into Vector3

# Clamp the components of the vector between
# min and max values specified by the given vectors
declare Vector3Clamp with v as Vector3, min as Vector3, max as Vector3 into Vector3

# Clamp the magnitude of the vector between two values
declare Vector3ClampValue with v as Vector3, min as f32, max as f32 into Vector3

# Check whether two given vectors are almost equal
declare Vector3Equals with p as Vector3, q as Vector3 into int

# Compute the direction of a refracted ray
# v: normalized direction of the incoming ray
# n: normalized normal vector of the interface of two optical media
# r: ratio of the refractive index of the medium from where the ray comes
# to the refractive index of the medium on the other side of the surface
declare Vector3Refract with v as Vector3, n as Vector3, r as f32 into Vector3

# ----------------------------------------------------------------------------------
# Module Functions Definition - Vector4 math
# ----------------------------------------------------------------------------------
# Get  vector zero
declare Vector4Zero into Vector4

# Get vector one
declare Vector4One into Vector4

# Add two vectors
declare Vector4Add with v1 as Vector4, v2 as Vector4 into Vector4

# Add value to vector components
declare Vector4AddValue with v as Vector4, add as f32 into Vector4

# Substract vectors
declare Vector4Subtract with v1 as Vector4, v2 as Vector4 into Vector4

# Substract value from vector components
declare Vector4SubtractValue with v as Vector4, add as f32 into Vector4

# Vector length
declare Vector4Length with v as Vector4 into f32

# Vector square length
declare Vector4LengthSqr with v as Vector4 into f32

# Vectors dot product
declare Vector4DotProduct with v1 as Vector4, v2 as Vector4 into f32

# Calculate distance between two vectors
declare Vector4Distance with v1 as Vector4, v2 as Vector4 into f32

# Calculate square distance between two vectors
declare Vector4DistanceSqr with v1 as Vector4, v2 as Vector4 into f32

# Scale vector components by value (multiply)
declare Vector4Scale with v as Vector4, scale as f32 into Vector4

# Multiply vector by vector
declare Vector4Multiply with v1 as Vector4, v2 as Vector4 into Vector4

# Negate vector
declare Vector4Negate with v as Vector4 into Vector4

# Divide vector by vector
declare Vector4Divide with v1 as Vector4, v2 as Vector4 into Vector4

# Normalize provided vector
declare Vector4Normalize with v as Vector4 into Vector4

# Get min value for each pair of components
declare Vector4Min with v1 as Vector4, v2 as Vector4 into Vector4

# Get max value for each pair of components
declare Vector4Max with v1 as Vector4, v2 as Vector4 into Vector4

# Calculate linear interpolation between two vectors
declare Vector4Lerp with v1 as Vector4, v2 as Vector4, amount as f32 into Vector4

# Move Vector towards target
declare Vector4MoveTowards with v as Vector4, target as Vector4, maxDistance as f32 into Vector4

# Invert the given vector
declare Vector4Invert with v as Vector4 into Vector4

# Check whether two given vectors are almost equal
declare Vector4Equals with p as Vector4, q as Vector4 into int

# Compute matrix determinant
declare MatrixDeterminant with mat as Matrix into f32

# Get the trace of the matrix (sum of the values along the diagonal)
declare MatrixTrace with mat as Matrix into f32

# Transposes provided matrix
declare MatrixTranspose with mat as Matrix into Matrix

# Invert provided matrix
declare MatrixInvert with mat as Matrix into Matrix

# Get identity matrix
declare MatrixIdentity into Matrix

# Add two matrices
declare MatrixAdd with left as Matrix, right as Matrix into Matrix

# Subtract two matrices (left - right)
declare MatrixSubtract with left as Matrix, right as Matrix into Matrix

# Get two matrix multiplication
# NOTE: When multiplying matrices... the order matters!
declare MatrixMultiply with left as Matrix, right as Matrix into Matrix

# Multiply matrix components by value
declare MatrixMultiplyValue with left as Matrix, value as f32 into Matrix

# Get translation matrix
declare MatrixTranslate with x as f32, y as f32, z as f32 into Matrix

# Create rotation matrix from axis and angle
# NOTE: Angle should be provided in radians
declare MatrixRotate with axis as Vector3, angle as f32 into Matrix

# Get x-rotation matrix
# NOTE: Angle must be provided in radians
declare MatrixRotateX with angle as f32 into Matrix

# Get y-rotation matrix
# NOTE: Angle must be provided in radians
declare MatrixRotateY with angle as f32 into Matrix

# Get z-rotation matrix
# NOTE: Angle must be provided in radians
declare MatrixRotateZ with angle as f32 into Matrix

# Get xyz-rotation matrix
# NOTE: Angle must be provided in radians
declare MatrixRotateXYZ with angle as Vector3 into Matrix

# Get zyx-rotation matrix
# NOTE: Angle must be provided in radians
declare MatrixRotateZYX with angle as Vector3 into Matrix

# Get scaling matrix
declare MatrixScale with x as f32, y as f32, z as f32 into Matrix

# Get perspective projection matrix
declare MatrixFrustum with left as f64, right as f64, bottom as f64, top as f64, nearPlane as f64, farPlane as f64 into Matrix

# Get perspective projection matrix
# NOTE: Fovy angle must be provided in radians
declare MatrixPerspective with fovY as f64, aspect as f64, nearPlane as f64, farPlane as f64 into Matrix

# Get orthographic projection matrix
declare MatrixOrtho with left as f64, right as f64, bottom as f64, top as f64, nearPlane as f64, farPlane as f64 into Matrix

# Get camera look-at matrix (view matrix)
declare MatrixLookAt with eye as Vector3, target as Vector3, up as Vector3 into Matrix

# Get float array of matrix data
declare MatrixToFloatV with mat as Matrix into float16

# Add two quaternions
declare QuaternionAdd with q1 as Quaternion, q2 as Quaternion into Quaternion

# Add quaternion and float value
declare QuaternionAddValue with q as Quaternion, add as f32 into Quaternion

# Subtract two quaternions
declare QuaternionSubtract with q1 as Quaternion, q2 as Quaternion into Quaternion

# Subtract quaternion and float value
declare QuaternionSubtractValue with q as Quaternion, sub as f32 into Quaternion

# Get identity quaternion
declare QuaternionIdentity into Quaternion

# Computes the length of a quaternion
declare QuaternionLength with q as Quaternion into f32

# Normalize provided quaternion
declare QuaternionNormalize with q as Quaternion into Quaternion

# Invert provided quaternion
declare QuaternionInvert with q as Quaternion into Quaternion

# Calculate two quaternion multiplication
declare QuaternionMultiply with q1 as Quaternion, q2 as Quaternion into Quaternion

# Scale quaternion by float value
declare QuaternionScale with q as Quaternion, mul as f32 into Quaternion

# Divide two quaternions
declare QuaternionDivide with q1 as Quaternion, q2 as Quaternion into Quaternion

# Calculate linear interpolation between two quaternions
declare QuaternionLerp with q1 as Quaternion, q2 as Quaternion, amount as f32 into Quaternion

# Calculate slerp-optimized interpolation between two quaternions
declare QuaternionNlerp with q1 as Quaternion, q2 as Quaternion, amount as f32 into Quaternion

# Calculates spherical linear interpolation between two quaternions
declare QuaternionSlerp with q1 as Quaternion, q2 as Quaternion, amount as f32 into Quaternion

# Calculate quaternion cubic spline interpolation using Cubic Hermite Spline algorithm
# as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
declare QuaternionCubicHermiteSpline with q1 as Quaternion, outTangent1 as Quaternion, q2 as Quaternion, inTangent2 as Quaternion, t as f32 into Quaternion

# Calculate quaternion based on the rotation from one vector to another
declare QuaternionFromVector3ToVector3 with from as Vector3, to as Vector3 into Quaternion

# Get a quaternion for a given rotation matrix
declare QuaternionFromMatrix with mat as Matrix into Quaternion

# Get a matrix for a given quaternion
declare QuaternionToMatrix with q as Quaternion into Matrix

# Get rotation quaternion for an angle and axis
# NOTE: Angle must be provided in radians
declare QuaternionFromAxisAngle with axis as Vector3, angle as f32 into Quaternion

# Get the rotation angle and axis for a given quaternion
declare QuaternionToAxisAngle with q as Quaternion, outAxis as ref to Vector3, outAngle as ref to f32 into void

# Get the quaternion equivalent to Euler angles
# NOTE: Rotation order is ZYX
declare QuaternionFromEuler with pitch as f32, yaw as f32, roll as f32 into Quaternion

# Get the Euler angles equivalent to quaternion (roll, pitch, yaw)
# NOTE: Angles are returned in a Vector3 struct in radians
declare QuaternionToEuler with q as Quaternion into Vector3

# Transform a quaternion given a transformation matrix
declare QuaternionTransform with q as Quaternion, mat as Matrix into Quaternion

# Check whether two given quaternions are almost equal
declare QuaternionEquals with p as Quaternion, q as Quaternion into int

# Compose a transformation matrix from rotational, translational and scaling components
declare MatrixCompose with translation as Vector3, rotation as Quaternion, scale as Vector3 into Matrix

# Decompose a transformation matrix into its rotational, translational and scaling components and remove shear
# TODO: WARNING: Following raymath convention and make the function self-contained
declare MatrixDecompose with mat as Matrix, translation as ref to Vector3, rotation as ref to Quaternion, scale as ref to Vector3 into void
