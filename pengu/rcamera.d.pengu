## PenguScript declaration binding generated by 'pengu bind'.
## Source header: rcamera.h
include "rcamera.h"

# rcamera.h expects raylib.h to have been included first (it only defines
# Camera3D/Vector3/Matrix itself under RCAMERA_STANDALONE), so share raylib's
# types instead of redeclaring them. At the C level raylib.h is included by
# pengu/raylib.d.pengu, which this import pulls in.
import raylib

# Camera, Vector3 and Matrix come from `import raylib`.
# rcamera.h exports no constants: CAMERA_CULL_DISTANCE_NEAR/FAR expand to
# RL_CULL_DISTANCE_* (undefined unless rlgl.h is also included) and
# CAMERA_MOVE_SPEED & co. only exist inside the RCAMERA_IMPLEMENTATION block.

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

declare GetCameraForward with camera as ref to Camera into Vector3

declare GetCameraUp with camera as ref to Camera into Vector3

declare GetCameraRight with camera as ref to Camera into Vector3

# Camera movement
declare CameraMoveForward with camera as ref to Camera, distance as f32, moveInWorldPlane as bool into void

declare CameraMoveUp with camera as ref to Camera, distance as f32 into void

declare CameraMoveRight with camera as ref to Camera, distance as f32, moveInWorldPlane as bool into void

declare CameraMoveToTarget with camera as ref to Camera, delta as f32 into void

# Camera rotation
declare CameraYaw with camera as ref to Camera, angle as f32, rotateAroundTarget as bool into void

declare CameraPitch with camera as ref to Camera, angle as f32, lockView as bool, rotateAroundTarget as bool, rotateUp as bool into void

declare CameraRoll with camera as ref to Camera, angle as f32 into void

declare GetCameraViewMatrix with camera as ref to Camera into Matrix

declare GetCameraProjectionMatrix with camera as ref to Camera, aspect as f32 into Matrix
