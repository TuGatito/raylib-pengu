## PenguScript declaration binding generated by 'pengu bind'.
## Source header: rgestures.h
include "rgestures.h"

# rgestures.h reuses raylib's Vector2 whenever RL_VECTOR2_TYPE is already
# defined (raylib.h defines it), so this binding imports raylib and drops the
# standalone copy of the rune: two `Vector2` declarations would be two
# different PenguScript types.
import raylib

# -- Constants (#define) ------------------------------
# FORCE_TO_SWIPE, MINIMUM_DRAG, DRAG_TIMEOUT, MINIMUM_PINCH, TAP_TIMEOUT,
# PINCH_TIMEOUT and DOUBLETAP_RANGE live inside the RGESTURES_IMPLEMENTATION
# block of the header: they do not exist in a consumer translation unit, so
# they are not exported here.

const PI as f64 is 3.14159265358979323846
const MAX_TOUCH_POINTS as i64 is 8

# ------------------------------------------------------------------
# Types (structs, unions, enums, aliases)
# ------------------------------------------------------------------

# Vector2 comes from `import raylib`.

omen TouchAction:
    TOUCH_ACTION_UP is 0
    TOUCH_ACTION_DOWN is 1
    TOUCH_ACTION_MOVE is 2
    TOUCH_ACTION_CANCEL is 3

rune GestureEvent:
    touchAction as int
    pointCount as int
    pointId as int
    position as Vector2

declare ProcessGestureEvent with event as GestureEvent into void

declare UpdateGestures into void
