##
## ## Returns
## raygui's widget state as an `int`: measured, `0` is idle and `1` is the press or change signal, so a click test is `state == 1`. The wrapper does not translate it into a `bool` because raygui distinguishes more states than two.
##
## ## Notes
## Three strings, a managed buffer and two out-parameters: the widest surface in the family.
## `secret` is read and written, so a password prompt can be toggled by the user.
##
## ## Memory
## The wrapper owns the C buffer and frees it; the caller's `string` is replaced by an owned copy of the edited text.
##
## ## Example
## ```pengu
## calling rayguix.text_input_box with bounds, "Login", "Password:", (sigil of text), 64, "OK;Cancel", (sigil of button), (sigil of hidden)
## ```

weave text_input_box with bounds as raylib.Rectangle, title as string, message as string, text as ref to string, capacity as int, button_text as string, button_active as ref to int, secret as ref to bool into int:
    let c_title as ref to frozen char is calling ffi.cstr_from_string with title
    defer calling ffi.cstr_free with (transmute c_title to ref to char)
    let c_message as ref to frozen char is calling ffi.cstr_from_string with message
    defer calling ffi.cstr_free with (transmute c_message to ref to char)
    let c_button as ref to frozen char is calling ffi.cstr_from_string with button_text
    defer calling ffi.cstr_free with (transmute c_button to ref to char)
    let raw as ref to void is calling raylib.MemAlloc with (capacity to u32)
    defer calling raylib.MemFree with raw
    var buffer as slice of byte is calling ffi.slice_of_bytes_from_ptr with raw, capacity
    calling _seed_buffer with buffer, (essence of text), capacity
    var state as int is calling raygui.GuiTextInputBox with bounds, c_title, c_message, (transmute raw to ref to char), capacity, c_button, button_active, secret
    set essence of text is (calling _read_buffer with buffer)
    return state

# --- Tests ---

# Every widget draws, so every test opens a window and calls raygui inside a drawing frame.
# raygui reports an `int` state, and with no mouse input an untouched widget reports 0
# (GUI_STATE_NORMAL), which is what makes these assertions deterministic.

test "the string-only widgets draw and answer with a state":
    calling raylib.InitWindow with 320, 240, "rayguix widgets"
    defer calling raylib.CloseWindow
    # raygui keeps its font in a global; recreating a window leaves it pointing at the dead
    # context, so it is rebound explicitly
    calling raygui.GuiSetFont with (calling raylib.GetFontDefault)
    var bounds as raylib.Rectangle is with x is 8.0, y is 8.0, width is 120.0, height is 22.0
    calling raylib.BeginDrawing
    calling raylib.ClearBackground with raylib.RAYWHITE
    calling ward.assert_true with ((calling window_box with bounds, "Window") >= 0)
    var second as raylib.Rectangle is with x is 8.0, y is 34.0, width is 120.0, height is 60.0
    calling ward.assert_true with ((calling group_box with second, "Group") >= 0)
    calling ward.assert_true with ((calling line with second, "Line") >= 0)
    calling ward.assert_true with ((calling panel with second, "") >= 0)
    calling ward.assert_true with ((calling label with bounds, "Label") >= 0)
    calling ward.assert_true with ((calling button with bounds, "Save") >= 0)
    calling ward.assert_true with ((calling label_button with bounds, "Details") >= 0)
    calling ward.assert_true with ((calling status_bar with bounds, "Ready") >= 0)
    calling ward.assert_true with ((calling dummy_rec with bounds, "") >= 0)
    calling raylib.EndDrawing

test "the out-parameter widgets leave an untouched value alone and keep raygui honest":
    calling raylib.InitWindow with 320, 240, "rayguix out params"
    defer calling raylib.CloseWindow
    # raygui keeps its font in a global; recreating a window leaves it pointing at the dead
    # context, so it is rebound explicitly
    calling raygui.GuiSetFont with (calling raylib.GetFontDefault)
    var bounds as raylib.Rectangle is with x is 8.0, y is 8.0, width is 140.0, height is 22.0
    var enabled as bool is false
    var checked as bool is true
    var count as int is 7
    var level as int is 1
    var volume as f32 is 0.5
    var hue as f32 is 0.25
    var tint as raylib.Color is raylib.RED
    var hsv as raylib.Vector3 is with x is 0.0, y is 1.0, z is 1.0
    var cell as raylib.Vector2 is with x is 0.0, y is 0.0
    var scroll as raylib.Vector2 is with x is 0.0, y is 0.0
    var view as raylib.Rectangle is with x is 0.0, y is 0.0, width is 0.0, height is 0.0
    var first as int is 0
    var selected as int is 0
    var h_scroll as int is 0
    var tab as int is 0
    var button as int is 0
    calling raylib.BeginDrawing
    calling raylib.ClearBackground with raylib.RAYWHITE
    calling ward.assert_true with ((calling toggle with bounds, "Mute", (sigil of enabled)) >= 0)
    calling ward.assert_true with ((calling toggle_group with bounds, "Low;High", (sigil of level)) >= 0)
    calling ward.assert_true with ((calling toggle_slider with bounds, "0;1;2", (sigil of level)) >= 0)
    calling ward.assert_true with ((calling check_box with bounds, "Fullscreen", (sigil of checked)) >= 0)
    calling ward.assert_true with ((calling spinner with bounds, "Count", (sigil of count), 0, 99, false) >= 0)
    calling ward.assert_true with ((calling value_box with bounds, "Port", (sigil of count), 1, 65535, false) >= 0)
    calling ward.assert_true with ((calling slider with bounds, "0", "100", (sigil of volume), 0.0, 100.0) >= 0)
    calling ward.assert_true with ((calling slider_bar with bounds, "0", "100", (sigil of volume), 0.0, 100.0) >= 0)
    calling ward.assert_true with ((calling progress_bar with bounds, "0%", "100%", (sigil of volume), 0.0, 100.0) >= 0)
    calling ward.assert_true with ((calling grid with bounds, "", 20.0, 4, (sigil of cell)) >= 0)
    calling ward.assert_true with ((calling list_view with bounds, "One;Two;Three", (sigil of first), (sigil of selected)) >= 0)
    calling ward.assert_true with ((calling tab_bar with bounds, "General;Audio", (sigil of h_scroll), (sigil of tab)) >= 0)
    var content as raylib.Rectangle is with x is 0.0, y is 0.0, width is 200.0, height is 300.0
    calling ward.assert_true with ((calling scroll_panel with bounds, "Settings", content, (sigil of scroll), (sigil of view)) >= 0)
    calling ward.assert_true with ((calling color_picker with bounds, "Tint", (sigil of tint)) >= 0)
    calling ward.assert_true with ((calling color_panel with bounds, "Tint", (sigil of tint)) >= 0)
    calling ward.assert_true with ((calling color_bar_alpha with bounds, "Alpha", (sigil of hue)) >= 0)
    calling ward.assert_true with ((calling color_bar_hue with bounds, "Hue", (sigil of hue)) >= 0)
    calling ward.assert_true with ((calling color_picker_hsv with bounds, "Tint", (sigil of hsv)) >= 0)
    calling ward.assert_true with ((calling color_panel_hsv with bounds, "Tint", (sigil of hsv)) >= 0)
    calling ward.assert_true with ((calling message_box with bounds, "Quit", "Save?", "Save;Discard", (sigil of button)) >= 0)
    calling raylib.EndDrawing
    # with no mouse input every widget must leave the caller's values untouched
    calling ward.assert_false with enabled
    calling ward.assert_true with checked
    calling ward.assert_eq_int with count, 7
    calling ward.assert_almost_eq with volume, 0.5, 0.001
    calling ward.assert_eq_int with (tint.r to int), 230

test "the three text fields seed, draw and hand the text back":
    calling raylib.InitWindow with 320, 240, "rayguix text fields"
    defer calling raylib.CloseWindow
    # raygui keeps its font in a global; recreating a window leaves it pointing at the dead
    # context, so it is rebound explicitly
    calling raygui.GuiSetFont with (calling raylib.GetFontDefault)
    var bounds as raylib.Rectangle is with x is 8.0, y is 8.0, width is 160.0, height is 24.0
    var text as string is "editable"
    var typed as string is "3.5"
    var gain as f32 is 0.0
    var secret as bool is false
    var button as int is 0
    calling raylib.BeginDrawing
    calling raylib.ClearBackground with raylib.RAYWHITE
    calling ward.assert_true with ((calling text_box with bounds, (sigil of text), 64, false) >= 0)
    calling ward.assert_true with ((calling value_box_float with bounds, "Gain", (sigil of typed), (sigil of gain), 32, false) >= 0)
    calling ward.assert_true with ((calling text_input_box with bounds, "Login", "Password:", (sigil of text), 64, "OK;Cancel", (sigil of button), (sigil of secret)) >= 0)
    calling raylib.EndDrawing
    # without input the fields are not edited, so the text must survive the round trip intact
    calling ward.assert_eq_string with text, "editable"
    calling ward.assert_eq_string with typed, "3.5"

test "the utilities measure, build labels and load nothing harmful":
    calling raylib.InitWindow with 320, 240, "rayguix utilities"
    defer calling raylib.CloseWindow
    # raygui keeps its font in a global; recreating a window leaves it pointing at the dead
    # context, so it is rebound explicitly
    calling raygui.GuiSetFont with (calling raylib.GetFontDefault)
    # measured: raygui caches its font in a global, so in a process that has already destroyed
    # one window the cached font is stale and this measures 0 until a widget is drawn again in
    # the new window. A real program draws first and measures afterwards, so the test does too.
    var bounds as raylib.Rectangle is with x is 8.0, y is 8.0, width is 120.0, height is 22.0
    calling raylib.BeginDrawing
    calling raylib.ClearBackground with raylib.RAYWHITE
    calling label with bounds, "warm up"
    calling raylib.EndDrawing
    var width as int is calling text_width with "Save"
    calling ward.assert_true with (width > 0)
    var label as string is calling icon_text with 1, "Save"
    calling ward.assert_false with (label == "")
    # measured: raygui returns a static buffer, so this only holds because the wrapper copied it
    var second as string is calling icon_text with 2, "Load"
    calling ward.assert_false with (second == "")
    calling ward.assert_false with (label == second)
    calling set_tooltip with "Saves the file"
    calling set_tooltip with ""
    # a missing style file and junk bytes must both be survivable no-ops
    calling load_style with "/tmp/rayguix_absent_style.rgs"
