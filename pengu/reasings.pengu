## ## reasings - raylib easings library in pure PenguScript
##
## Based on Robert Penner's easing equations.
## Useful easing functions for value and motion animations.
##
## All functions take four parameters:
## - `t`: current time / step
## - `b`: beginning value
## - `c`: change in value (final - start)
## - `d`: duration / total steps

import std.fractio

# --- Constants ---

const PI as f32 is 3.14159265358979323846

# --- Linear Easing ---

## ## Linear easing (no acceleration)
weave ease_linear_none with t as f32, b as f32, c as f32, d as f32 into f32:
    return ((c * t) / d) + b

## ## Linear easing in
weave ease_linear_in with t as f32, b as f32, c as f32, d as f32 into f32:
    return ((c * t) / d) + b

## ## Linear easing out
weave ease_linear_out with t as f32, b as f32, c as f32, d as f32 into f32:
    return ((c * t) / d) + b

## ## Linear easing in-out
weave ease_linear_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    return ((c * t) / d) + b

# --- Sine Easing ---

## ## Sine easing in
weave ease_sine_in with t as f32, b as f32, c as f32, d as f32 into f32:
    var angle as f32 is (t / d) * (PI / 2.0)
    return (-c * (calling angle.get_cos)) + c + b

## ## Sine easing out
weave ease_sine_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var angle as f32 is (t / d) * (PI / 2.0)
    return (c * (calling angle.get_sin)) + b

## ## Sine easing in-out
weave ease_sine_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var angle as f32 is (PI * t) / d
    return ((-c / 2.0) * ((calling angle.get_cos) - 1.0)) + b

# --- Circular Easing ---

## ## Circular easing in
weave ease_circ_in with t as f32, b as f32, c as f32, d as f32 into f32:
    let st as f32 is t / d
    var term as f32 is 1.0 - (st * st)
    return (-c * ((calling term.get_sqrt) - 1.0)) + b

## ## Circular easing out
weave ease_circ_out with t as f32, b as f32, c as f32, d as f32 into f32:
    let st as f32 is (t / d) - 1.0
    var term as f32 is 1.0 - (st * st)
    return (c * (calling term.get_sqrt)) + b

## ## Circular easing in-out
weave ease_circ_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var st as f32 is t / (d / 2.0)
    if st < 1.0:
        var term as f32 is 1.0 - (st * st)
        return ((-c / 2.0) * ((calling term.get_sqrt) - 1.0)) + b
    set st is st - 2.0
    var term as f32 is 1.0 - (st * st)
    return ((c / 2.0) * ((calling term.get_sqrt) + 1.0)) + b

# --- Cubic Easing ---

## ## Cubic easing in
weave ease_cubic_in with t as f32, b as f32, c as f32, d as f32 into f32:
    let st as f32 is t / d
    return (c * st * st * st) + b

## ## Cubic easing out
weave ease_cubic_out with t as f32, b as f32, c as f32, d as f32 into f32:
    let st as f32 is (t / d) - 1.0
    return (c * ((st * st * st) + 1.0)) + b

## ## Cubic easing in-out
weave ease_cubic_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var st as f32 is t / (d / 2.0)
    if st < 1.0:
        return ((c / 2.0) * st * st * st) + b
    set st is st - 2.0
    return ((c / 2.0) * ((st * st * st) + 2.0)) + b

# --- Quadratic Easing ---

## ## Quadratic easing in
weave ease_quad_in with t as f32, b as f32, c as f32, d as f32 into f32:
    let st as f32 is t / d
    return (c * st * st) + b

## ## Quadratic easing out
weave ease_quad_out with t as f32, b as f32, c as f32, d as f32 into f32:
    let st as f32 is t / d
    return (-c * st * (st - 2.0)) + b

## ## Quadratic easing in-out
weave ease_quad_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var st as f32 is t / (d / 2.0)
    if st < 1.0:
        return ((c / 2.0) * st * st) + b
    return ((-c / 2.0) * (((st - 1.0) * (st - 3.0)) - 1.0)) + b

# --- Exponential Easing ---

## ## Exponential easing in
weave ease_expo_in with t as f32, b as f32, c as f32, d as f32 into f32:
    if t == 0.0:
        return b
    var base as f32 is 2.0
    let exp_term as f32 is calling base.get_pow with (10.0 * ((t / d) - 1.0))
    return (c * exp_term) + b

## ## Exponential easing out
weave ease_expo_out with t as f32, b as f32, c as f32, d as f32 into f32:
    if t == d:
        return b + c
    var base as f32 is 2.0
    let exp_term as f32 is calling base.get_pow with (-10.0 * (t / d))
    return (c * (-exp_term + 1.0)) + b

## ## Exponential easing in-out
weave ease_expo_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    if t == 0.0:
        return b
    if t == d:
        return b + c
    var st as f32 is t / (d / 2.0)
    var base as f32 is 2.0
    if st < 1.0:
        let exp_term as f32 is calling base.get_pow with (10.0 * (st - 1.0))
        return ((c / 2.0) * exp_term) + b
    let exp_term as f32 is calling base.get_pow with (-10.0 * (st - 1.0))
    return ((c / 2.0) * (-exp_term + 2.0)) + b

# --- Back Easing ---

## ## Back easing in
weave ease_back_in with t as f32, b as f32, c as f32, d as f32 into f32:
    let s as f32 is 1.70158
    let st as f32 is t / d
    return (c * st * st * (((s + 1.0) * st) - s)) + b

## ## Back easing out
weave ease_back_out with t as f32, b as f32, c as f32, d as f32 into f32:
    let s as f32 is 1.70158
    let st as f32 is (t / d) - 1.0
    return (c * ((st * st * (((s + 1.0) * st) + s)) + 1.0)) + b

## ## Back easing in-out
weave ease_back_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var s as f32 is 1.70158
    var st as f32 is t / (d / 2.0)
    if st < 1.0:
        set s is s * 1.525
        return ((c / 2.0) * (st * st * (((s + 1.0) * st) - s))) + b
    set st is st - 2.0
    set s is s * 1.525
    return ((c / 2.0) * ((st * st * (((s + 1.0) * st) + s)) + 2.0)) + b

# --- Bounce Easing ---

## ## Bounce easing out
weave ease_bounce_out with t as f32, b as f32, c as f32, d as f32 into f32:
    var st as f32 is t / d
    if st < (1.0 / 2.75):
        return (c * (7.5625 * st * st)) + b
    if st < (2.0 / 2.75):
        set st is st - (1.5 / 2.75)
        return (c * ((7.5625 * st * st) + 0.75)) + b
    if st < (2.5 / 2.75):
        set st is st - (2.25 / 2.75)
        return (c * ((7.5625 * st * st) + 0.9375)) + b
    set st is st - (2.625 / 2.75)
    return (c * ((7.5625 * st * st) + 0.984375)) + b

## ## Bounce easing in
weave ease_bounce_in with t as f32, b as f32, c as f32, d as f32 into f32:
    return (c - (calling ease_bounce_out with d - t, 0.0, c, d)) + b

## ## Bounce easing in-out
weave ease_bounce_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    if t < (d / 2.0):
        return ((calling ease_bounce_in with t * 2.0, 0.0, c, d) * 0.5) + b
    return ((calling ease_bounce_out with (t * 2.0) - d, 0.0, c, d) * 0.5) + (c * 0.5) + b

# --- Elastic Easing ---

## ## Elastic easing in
weave ease_elastic_in with t as f32, b as f32, c as f32, d as f32 into f32:
    if t == 0.0:
        return b
    var st as f32 is t / d
    if st == 1.0:
        return b + c

    let p as f32 is d * 0.3
    let a as f32 is c
    let s as f32 is p / 4.0
    set st is st - 1.0
    var base as f32 is 2.0
    let post_fix as f32 is a * (calling base.get_pow with (10.0 * st))
    var sin_ang as f32 is (((st * d) - s) * (2.0 * PI)) / p
    return (-(post_fix * (calling sin_ang.get_sin))) + b

## ## Elastic easing out
weave ease_elastic_out with t as f32, b as f32, c as f32, d as f32 into f32:
    if t == 0.0:
        return b
    let st as f32 is t / d
    if st == 1.0:
        return b + c

    let p as f32 is d * 0.3
    let a as f32 is c
    let s as f32 is p / 4.0
    var base as f32 is 2.0
    let exp_term as f32 is calling base.get_pow with (-10.0 * st)
    var sin_ang as f32 is (((st * d) - s) * (2.0 * PI)) / p
    return (a * exp_term * (calling sin_ang.get_sin)) + c + b

## ## Elastic easing in-out
weave ease_elastic_in_out with t as f32, b as f32, c as f32, d as f32 into f32:
    if t == 0.0:
        return b
    var st as f32 is t / (d / 2.0)
    if st == 2.0:
        return b + c

    let p as f32 is d * 0.3 * 1.5
    let a as f32 is c
    let s as f32 is p / 4.0
    var base as f32 is 2.0

    if st < 1.0:
        set st is st - 1.0
        let post_fix as f32 is a * (calling base.get_pow with (10.0 * st))
        var sin_ang as f32 is (((st * d) - s) * (2.0 * PI)) / p
        return (-0.5 * (post_fix * (calling sin_ang.get_sin))) + b

    set st is st - 1.0
    let post_fix as f32 is a * (calling base.get_pow with (-10.0 * st))
    var sin_ang as f32 is (((st * d) - s) * (2.0 * PI)) / p
    return (post_fix * (calling sin_ang.get_sin) * 0.5) + c + b
