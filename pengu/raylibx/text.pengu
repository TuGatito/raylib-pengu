## Joins a list of strings with a delimiter.
##
## ## Parameters
## - `parts`: the strings to join.
## - `delimiter`: the separator placed between them.
##
## ## Returns
## The joined text, or an empty string for an empty slice.
##
## ## Notes
## Each element of `parts` must be a NUL-terminated C string, which is what a PenguScript `string` already is; the slice is passed as raylib's `char**`.
## raylib returns a **static buffer**; the wrapper copies it.
##
## ## Memory
## No allocation by the wrapper; any raylib buffer is copied and released before returning.
##
## ## Example
## ```pengu
## var s as string is calling text_join with (parts at 0 to 3), "-"
## ```

weave text_join with parts as slice of string, delimiter as string into string:
    if (parts.length) == 0:
        return ""
    let c_delim as ref to frozen char is calling ffi.cstr_from_string with delimiter
    var ptrs as list of (ref to char) is list of (ref to char)
    defer banish ptrs
    var i as int is 0
    while i < (parts.length):
        calling ptrs.push with (calling ffi.cstr_from_string with (parts at i))
        set i is i + 1
    let raw as ref to void is transmute (sigil of (ptrs at 0)) to (ref to void)
    return calling ffi.string_from_cstr with (calling raylib.TextJoin with (transmute raw to ref to ref to char), (parts.length), c_delim)

## Splits text into parts around a delimiter.
##
## ## Parameters
## - `text`: the text to split.
## - `delimiter`: the separator, as a single `char` (for example `44` for a comma).
##
## ## Returns
## An owned list of the parts; empty when raylib fails.
##
## ## Notes
## raylib stores the parts in its own static storage (`MAX_TEXTSPLIT_COUNT` entries), so the wrapper copies every element into an owned list before returning.
## The delimiter is a `char`, not a `string`: pass the ordinal value (`44` is `,`).
##
## ## Memory
## No allocation by the wrapper; any raylib buffer is copied and released before returning.
##
## ## Example
## ```pengu
## var parts as list of string is calling split_text with "a,b,c", 44
## ```

weave split_text with text as string, delimiter as char into list of string:
    let c_text as ref to frozen char is calling ffi.cstr_from_string with text
    var n as int is 0
    var parts as ref to ref to char is calling raylib.TextSplit with c_text, delimiter, sigil of n
    var out as list of string is list of string
    if calling ffi.is_null with (transmute parts to ref to void):
        return out
    let as_void as ref to void is transmute parts to ref to void
    var ptrs as slice of (ref to char) is calling ffi.slice_from_ptr of (ref to char) with as_void, n
    var i as int is 0
    while i < n:
        var raw as ref to char is (ptrs at i)
        calling out.push with (calling ffi.string_from_cstr with raw)
        set i is i + 1
    return out

## Splits text into lines on `'\n'`.
##
## ## Parameters
## - `text`: the text to split.
##
## ## Returns
## An owned list with one entry per line; empty when raylib fails.
##
## ## Notes
## raylib allocates both the array and each line, so the wrapper copies the array and releases everything with `UnloadTextLines` before returning.
##
## ## Memory
## No allocation by the wrapper; any raylib buffer is copied and released before returning.
##
## ## Example
## ```pengu
## var lines as list of string is calling split_lines with "one\ntwo"
## ```

weave split_lines with text as string into list of string:
    let c_text as ref to frozen char is calling ffi.cstr_from_string with text
    var n as int is 0
    var lines as ref to ref to char is calling raylib.LoadTextLines with c_text, sigil of n
    var out as list of string is list of string
    if calling ffi.is_null with (transmute lines to ref to void):
        return out
    let as_void as ref to void is transmute lines to ref to void
    var ptrs as slice of (ref to char) is calling ffi.slice_from_ptr of (ref to char) with as_void, n
    var i as int is 0
    while i < n:
        var raw as ref to char is (ptrs at i)
        calling out.push with (calling ffi.string_from_cstr with raw)
        set i is i + 1
    calling raylib.UnloadTextLines with lines, n
    return out

