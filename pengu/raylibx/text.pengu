## ## Notes
## This is a global side effect with no failure channel, kept module-level because it has no subject.
##
## ## Memory
## No allocation by the wrapper; any raylib buffer is copied and released before returning.
##
## ## Example
## ```pengu
## calling set_text_line_spacing with 2
## ```

weave set_text_line_spacing with spacing as int into void:
    calling raylib.SetTextLineSpacing with spacing

## Measures a run of codepoints in a given font.
##
## ## Parameters
## - `font`: the font to measure with.
## - `codepoints`: the codepoints to measure.
## - `font_size`: the font size in pixels.
## - `spacing`: the extra spacing between characters.
##
## ## Returns
## A `raylib.Vector2` with the width and height in pixels; a zero vector for an empty slice.
##
## ## Notes
## An empty `codepoints` slice is answered with an empty measurement instead of calling into raylib, because the C function would read a null codepoint pointer.
## **Window-bound**, like the rest of the glyph-table queries (family plan D16).
##
## ## Memory
## No allocation by the wrapper; any raylib buffer is copied and released before returning.
##
## ## Example
## ```pengu
## var m as raylib.Vector2 is calling measure_text_codepoints with font, (points at 0 to 3), 20.0, 1.0
## ```

weave measure_text_codepoints with font as raylib.Font, codepoints as slice of int, font_size as f32, spacing as f32 into raylib.Vector2:
    if (codepoints.length) == 0:
        return calling raylib.MeasureTextEx with font, (calling ffi.cstr_from_string with ""), font_size, spacing
    let raw as ref to frozen int is transmute (sigil of (codepoints at 0)) to (ref to frozen int)
    return calling raylib.MeasureTextCodepoints with font, raw, (codepoints.length), font_size, spacing

# --- Tests ---

test "text_upper converts to upper case":
    var s as string is calling text_upper with "hello pengu"
    calling ward.assert_eq_string with s, "HELLO PENGU"

test "text_lower converts to lower case":
    var s as string is calling text_lower with "HELLO PENGU"
    calling ward.assert_eq_string with s, "hello pengu"

test "static buffer results survive a second call":
    var first as string is calling text_upper with "abc"
    var second as string is calling text_upper with "xyz"
    calling ward.assert_eq_string with first, "ABC"
    calling ward.assert_eq_string with second, "XYZ"

test "text_pascal converts the first letter":
    var s as string is calling text_pascal with "hello world"
    calling ward.assert_eq_string with s, "Hello world"

test "text_snake inserts underscores":
    var s as string is calling text_snake with "helloWorld"
    calling ward.assert_eq_string with s, "hello_world"

test "text_camel removes underscores":
    var s as string is calling text_camel with "hello_world"
    calling ward.assert_eq_string with s, "helloWorld"

test "text_without_spaces joins the words":
    var s as string is calling text_without_spaces with "a b c"
    calling ward.assert_eq_string with s, "abc"

test "text_subtext extracts a range":
    var s as string is calling text_subtext with "hello world", 6, 5
    calling ward.assert_eq_string with s, "world"

test "text_subtext with zero length is empty":
    var s as string is calling text_subtext with "hello", 0, 0
    calling ward.assert_string_empty with s

test "text_between extracts the marked part":
    var s as string is calling text_between with "a[b]c", "[", "]"
    calling ward.assert_eq_string with s, "b"

test "text_between without markers is empty":
    var s as string is calling text_between with "abc", "[", "]"
    calling ward.assert_string_empty with s

test "text_replace swaps a substring":
    var s as string is calling text_replace with "hello world", "world", "there"
    calling ward.assert_eq_string with s, "hello there"

test "text_replace_alloc agrees with text_replace":
    var plain as string is calling text_replace with "hello world", "world", "there"
    var owned as string is calling text_replace_alloc with "hello world", "world", "there"
    calling ward.assert_eq_string with plain, owned

test "text_replace_between_alloc replaces between markers":
    var s as string is calling text_replace_between_alloc with "a[b]c", "[", "]", "-"
    calling ward.assert_eq_string with s, "a[-]c"

test "text_insert puts text in the middle":
    var s as string is calling text_insert with "hello", "XY", 2
    calling ward.assert_eq_string with s, "heXYo"

test "text_insert_alloc agrees with text_insert":
    var plain as string is calling text_insert with "hello", "XY", 2
    var owned as string is calling text_insert_alloc with "hello", "XY", 2
    calling ward.assert_eq_string with plain, owned

test "split_text splits on a delimiter":
    var parts as list of string is calling split_text with "a,b,c", 44
    defer banish parts
    calling ward.assert_eq_int with (parts.length), 3
    calling ward.assert_eq_string with (parts at 0), "a"

test "split_text without the delimiter gives one part":
    var parts as list of string is calling split_text with "abc", 44
    defer banish parts
    calling ward.assert_eq_int with (parts.length), 1

test "text_join reunites the parts":
    var parts as list of string is calling split_text with "a,b,c", 44
    defer banish parts
    var joined as string is calling text_join with (parts at 0 to (parts.length)), "-"
    calling ward.assert_eq_string with joined, "a-b-c"

test "text_join of an empty slice is empty":
    var parts as list of string is list of string
    defer banish parts
    var joined as string is calling text_join with (parts at 0 to 0), "-"
    calling ward.assert_string_empty with joined

test "split_lines splits on newlines":
    var lines as list of string is calling split_lines with "one\ntwo"
    defer banish lines
    calling ward.assert_eq_int with (lines.length), 2
    calling ward.assert_eq_string with (lines at 0), "one"

test "text_is_equal compares content":
    calling ward.assert_true with (calling text_is_equal with "a", "a")
    calling ward.assert_false with (calling text_is_equal with "a", "b")
    calling ward.assert_true with (calling text_is_equal with "", "")

test "text_length counts bytes":
    calling ward.assert_eq_int with ((calling text_length with "hello") to int), 5

test "text_find returns an index or none":
    var found as maybe int is calling text_find with "hello", "l"
    calling ward.assert_maybe_present with found
    calling ward.assert_eq_int with (calling found.unwrap), 2
    var missing as maybe int is calling text_find with "hello", "z"
    calling ward.assert_maybe_none with missing

test "text_to_integer parses a negative integer":
    calling ward.assert_eq_int with (calling text_to_integer with "-42"), -42

test "text_to_float parses a fractional value":
    calling ward.assert_almost_eq with (calling text_to_float with "2.5"), 2.5, 0.001

test "codepoint_count counts codepoints":
    calling ward.assert_eq_int with (calling codepoint_count with "hi"), 2
    calling ward.assert_eq_int with (calling codepoint_count with ""), 0

test "codepoint_at reads the first codepoint":
    var cp as maybe int is calling codepoint_at with "hi"
    calling ward.assert_maybe_present with cp
    calling ward.assert_eq_int with (calling cp.unwrap), 104

test "codepoint_at on an empty string is none":
    var cp as maybe int is calling codepoint_at with ""
    calling ward.assert_maybe_none with cp

test "codepoint_to_text encodes a codepoint":
    var s as string is calling codepoint_to_text with 65
    calling ward.assert_eq_string with s, "A"

test "codepoints_from_text decodes to codepoints":
    var cps as list of int is calling codepoints_from_text with "hi"
    defer banish cps
    calling ward.assert_eq_int with (cps.length), 2
    calling ward.assert_eq_int with (cps at 0), 104

test "text_from_codepoints round trips":
    var cps as list of int is calling codepoints_from_text with "hi"
    defer banish cps
    var text as maybe string is calling text_from_codepoints with (cps at 0 to (cps.length))
    calling ward.assert_maybe_present with text
    calling ward.assert_eq_string with (calling text.unwrap), "hi"

test "text_from_codepoints on an empty slice is none":
    var cps as list of int is list of int
    defer banish cps
    var text as maybe string is calling text_from_codepoints with (cps at 0 to 0)
    calling ward.assert_maybe_none with text

# The drawing and font-lifecycle surface is not called in CI: the drawing entries need an
# active frame, and the font entries need InitWindow, because before it GetFontDefault()
# has no glyph table and measuring or querying a glyph on it segfaults (family plan D16).
# This probe exists so every public signature is type-checked at build time.
weave text_api_probe into void:
    var font as raylib.Font is calling default_font
    var pos as raylib.Vector2 is with x is 10.0, y is 10.0
    var origin as raylib.Vector2 is with x is 0.0, y is 0.0
    var col as raylib.Color is raylib.RAYWHITE
    var cps as list of int is list of int
    defer banish cps
    var blob as list of byte is list of byte
    defer banish blob
    var parts as list of string is list of string
    defer banish parts
    var img as raylib.Image is calling raylib.GenImageColor with 1, 1, raylib.BLANK
    calling font.draw with "t", pos, 20.0, 1.0, col
    calling font.draw_pro with "t", pos, origin, 0.0, 20.0, 1.0, col
    calling font.draw_codepoint with 65, pos, 20.0, col
    calling font.draw_codepoints with (cps at 0 to 0), pos, 20.0, 1.0, col
    var measured as raylib.Vector2 is calling font.measure with "t", 20.0, 1.0
    var ok as bool is calling is_font_valid with font
    var glyph_index as int is calling font_glyph_index with font, 65
    var glyph_info as raylib.GlyphInfo is calling font_glyph_info with font, 65
    var glyph_rec as raylib.Rectangle is calling font_glyph_atlas_rec with font, 65
    var exported as bool is calling export_font_as_code with font, "font.c"
    var from_image as maybe raylib.Font is calling load_font_from_image with img, raylib.MAGENTA, 32
    var from_memory as maybe raylib.Font is calling load_font_from_memory with ".ttf", (blob at 0 to 0), 32, (cps at 0 to 0)
    var loaded as maybe raylib.Font is calling load_font with "a.ttf"
    var loaded_ex as maybe raylib.Font is calling load_font_ex with "a.ttf", 32, (cps at 0 to 0)
    var glyphs as list of raylib.GlyphInfo is calling load_font_data with (blob at 0 to 0), 32, (cps at 0 to 0), 0
    defer banish glyphs
    var atlas as raylib.Image is calling font_atlas_image with (glyphs at 0 to 0), 32, 1, 0
    calling draw_fps with 10, 10
    calling draw_text with "t", 10, 10, 20, col
    calling set_text_line_spacing with 2
    var width as int is calling measure_text with "t", 20
    var m2 as raylib.Vector2 is calling measure_text_codepoints with font, (cps at 0 to 0), 20.0, 1.0
    var joined2 as string is calling text_join with (parts at 0 to 0), "-"
    calling unload_font with font
