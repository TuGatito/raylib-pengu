test "file_exists is true only for a written file":
    var seed as int is calling raylib.GetRandomValue with 100000, 999999
    var path as string is "/tmp/raylibx_files_{(seed to string)}.txt"
    var blob_path as string is "/tmp/raylibx_files_{(seed to string)}.bin"
    var rename_path as string is "/tmp/raylibx_files_{(seed to string)}_renamed.txt"
    var code_path as string is "/tmp/raylibx_files_{(seed to string)}.c"
    defer calling remove_file with path
    calling save_file_text with path, "x"
    calling ward.assert_true with (calling file_exists with path)
    calling ward.assert_false with (calling file_exists with "/tmp/raylibx_files_{(seed to string)}.absent")

test "directory_exists distinguishes directories":
    var seed as int is calling raylib.GetRandomValue with 100000, 999999
    var path as string is "/tmp/raylibx_files_{(seed to string)}.txt"
    var blob_path as string is "/tmp/raylibx_files_{(seed to string)}.bin"
    var rename_path as string is "/tmp/raylibx_files_{(seed to string)}_renamed.txt"
    var code_path as string is "/tmp/raylibx_files_{(seed to string)}.c"
    calling ward.assert_true with (calling directory_exists with "/tmp")
    calling ward.assert_false with (calling directory_exists with "/tmp/raylibx_files_{(seed to string)}.absent")

test "is_file_extension matches ignoring case":
    var seed as int is calling raylib.GetRandomValue with 100000, 999999
    var path as string is "/tmp/raylibx_files_{(seed to string)}.txt"
    var blob_path as string is "/tmp/raylibx_files_{(seed to string)}.bin"
    var rename_path as string is "/tmp/raylibx_files_{(seed to string)}_renamed.txt"
    var code_path as string is "/tmp/raylibx_files_{(seed to string)}.c"
    calling ward.assert_true with (calling is_file_extension with "art.PNG", ".png")
    calling ward.assert_false with (calling is_file_extension with "art.png", ".jpg")

test "is_path_file separates files from directories":
