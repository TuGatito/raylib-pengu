test "file_extension extracts the dot suffix":
    var ext as string is calling file_extension with "/tmp/sample.txt"
    calling ward.assert_eq_string with ext, ".txt"

test "file_name extracts the last component":
    var name as string is calling file_name with "/tmp/sample.txt"
    calling ward.assert_eq_string with name, "sample.txt"

test "file_name_without_extension strips the suffix":
    var stem as string is calling file_name_without_extension with "/tmp/sample.txt"
    calling ward.assert_eq_string with stem, "sample"

test "directory_path extracts the directory":
    var dir as string is calling directory_path with "/tmp/sample.txt"
    calling ward.assert_eq_string with dir, "/tmp"

test "working_directory is not empty":
    var cwd as string is calling working_directory
    calling ward.assert_string_not_empty with cwd

test "application_directory is not empty":
    var app as string is calling application_directory
    calling ward.assert_string_not_empty with app

test "make_directory succeeds on an existing directory":
    var rc as int is calling make_directory with "/tmp"
    calling ward.assert_eq_int with rc, 0

test "change_directory reports one on success":
    var rc as int is calling change_directory with "/tmp"
    calling ward.assert_eq_int with rc, 1
    var bad as int is calling change_directory with "/definitely_absent_raylibx_dir"
    calling ward.assert_eq_int with bad, 0

test "rename_file moves a file":
    var seed as int is calling raylib.GetRandomValue with 100000, 999999
    var path as string is "/tmp/raylibx_files_{(seed to string)}.txt"
    var blob_path as string is "/tmp/raylibx_files_{(seed to string)}.bin"
    var rename_path as string is "/tmp/raylibx_files_{(seed to string)}_renamed.txt"
    var code_path as string is "/tmp/raylibx_files_{(seed to string)}.c"
    defer calling remove_file with path
    defer calling remove_file with rename_path
    calling save_file_text with path, "moved"
    var rc as int is calling rename_file with path, rename_path
    calling ward.assert_eq_int with rc, 0
    calling ward.assert_true with (calling file_exists with rename_path)

test "remove_file deletes a file":
    var seed as int is calling raylib.GetRandomValue with 100000, 999999
    var path as string is "/tmp/raylibx_files_{(seed to string)}.txt"
    var blob_path as string is "/tmp/raylibx_files_{(seed to string)}.bin"
    var rename_path as string is "/tmp/raylibx_files_{(seed to string)}_renamed.txt"
    var code_path as string is "/tmp/raylibx_files_{(seed to string)}.c"
    calling save_file_text with path, "gone"
    var rc as int is calling remove_file with path
    calling ward.assert_eq_int with rc, 0
    calling ward.assert_false with (calling file_exists with path)

test "load_directory lists entries as an owned list":
    var names as list of string is calling load_directory with "/tmp"
    defer banish names
    calling ward.assert_gt_int with (names.length), 0

test "load_directory_filtered keeps only matching suffixes":
    var txts as list of string is calling load_directory_filtered with "/tmp", ".txt", false
    defer banish txts
    calling ward.assert_ge_int with (txts.length), 0

test "dropped_files returns a list without a window":
    var dropped as list of string is calling dropped_files
    defer banish dropped
    calling ward.assert_ge_int with (dropped.length), 0

test "crc32 is stable and input sensitive":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 1
    calling data.push with 2
    var first as u32 is calling crc32 with (data at 0 to 2)
    var second as u32 is calling crc32 with (data at 0 to 2)
    calling ward.assert_eq_int with (first to int), (second to int)
    calling ward.assert_ne_int with (first to int), 0

test "crc32 of an empty slice is zero":
    var empty as list of byte is list of byte
    defer banish empty
    calling ward.assert_eq_int with ((calling crc32 with (empty at 0 to 0)) to int), 0

test "md5 returns four words":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 7
    var digest as slice of u32 is calling md5 with (data at 0 to 1)
    calling ward.assert_eq_int with (digest.length), 4

test "sha1 returns five words":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 7
    var digest as slice of u32 is calling sha1 with (data at 0 to 1)
    calling ward.assert_eq_int with (digest.length), 5

test "sha256 returns eight words":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 7
    var digest as slice of u32 is calling sha256 with (data at 0 to 1)
    calling ward.assert_eq_int with (digest.length), 8

test "raylibx_files digests differ from each other":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 9
    var m as slice of u32 is calling md5 with (data at 0 to 1)
    var s as slice of u32 is calling sha1 with (data at 0 to 1)
    calling ward.assert_ne_int with ((m at 0) to int), ((s at 0) to int)

test "compress and decompress round trip":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 10
    calling data.push with 20
    calling data.push with 30
    var packed as maybe (list of byte) is calling compress with (data at 0 to 3)
    calling ward.assert_maybe_present with packed
    var blob as list of byte is calling packed.unwrap
    defer banish blob
    var back as maybe (list of byte) is calling decompress with (blob at 0 to (blob.length))
    calling ward.assert_maybe_present with back
    calling ward.assert_eq_int with ((calling back.unwrap).length), 3

test "compress of an empty slice is maybe none":
    var empty as list of byte is list of byte
    defer banish empty
    var packed as maybe (list of byte) is calling compress with (empty at 0 to 0)
    calling ward.assert_maybe_none with packed

test "encode_base64 and decode_base64 round trip":
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 104
    calling data.push with 105
    var b64 as maybe string is calling encode_base64 with (data at 0 to 2)
    calling ward.assert_maybe_present with b64
    var text as string is calling b64.unwrap
    defer banish text
    calling ward.assert_string_not_empty with text
    var back as maybe (list of byte) is calling decode_base64 with text
    calling ward.assert_maybe_present with back
    var got as list of byte is calling back.unwrap
    defer banish got
    calling ward.assert_eq_int with (got.length), 2

test "text_lines splits into lines":
    var lines as maybe (list of string) is calling text_lines with "one\ntwo"
    calling ward.assert_maybe_present with lines
    var got as list of string is calling lines.unwrap
    defer banish got
    calling ward.assert_eq_int with (got.length), 2

test "text_from_codepoints encodes back to text":
    var points as list of int is list of int
    defer banish points
    calling points.push with 104
    calling points.push with 105
    var text as maybe string is calling text_from_codepoints with (points at 0 to 2)
    calling ward.assert_maybe_present with text
    calling ward.assert_eq_string with (calling text.unwrap), "hi"

test "export_bytes_as_code writes a source file":
    var seed as int is calling raylib.GetRandomValue with 100000, 999999
    var path as string is "/tmp/raylibx_files_{(seed to string)}.txt"
    var blob_path as string is "/tmp/raylibx_files_{(seed to string)}.bin"
    var rename_path as string is "/tmp/raylibx_files_{(seed to string)}_renamed.txt"
    var code_path as string is "/tmp/raylibx_files_{(seed to string)}.c"
    defer calling remove_file with code_path
    var data as list of byte is list of byte
    defer banish data
    calling data.push with 1
    calling data.push with 2
    calling data.push with 3
    calling data.push with 4
    var ok as bool is calling export_bytes_as_code with (data at 0 to 4), code_path
    calling ward.assert_true with ok
    calling ward.assert_true with (calling file_exists with code_path)
