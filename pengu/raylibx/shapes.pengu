# The window-bound drawing surface is not called in CI: every Draw* below needs an
# active BeginDrawing/EndDrawing frame and a GPU. This probe exists so that every
# public signature is type-checked by `pengu check`; the test that would run it is
# deliberately absent.
weave draw_api_probe into void:
    var p as raylib.Vector2 is with x is 1.0, y is 2.0
    var q as raylib.Vector2 is with x is 3.0, y is 4.0
    var r as raylib.Vector2 is with x is 5.0, y is 6.0
    var rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is 8.0, height is 8.0
    var c as raylib.Color is raylib.RED
    var scratch as list of raylib.Vector2 is list of raylib.Vector2
    defer banish scratch
    var strip as slice of raylib.Vector2 is scratch at 0 to 0
    calling p.draw_pixel with c
    calling p.draw_line_to with q, c
    calling p.draw_line_ex with q, 1.0, c
    calling p.draw_line_bezier with q, 1.0, c
    calling p.draw_circle with 2.0, c
    calling p.draw_circle_gradient with 2.0, c, c
    calling p.draw_circle_sector with 2.0, 0.0, 90.0, 8, c
    calling p.draw_circle_sector_lines with 2.0, 0.0, 90.0, 8, c
    calling p.draw_ellipse with 2.0, 1.0, c
    calling p.draw_ellipse_lines with 2.0, 1.0, c
    calling p.draw_ring with 1.0, 2.0, 0.0, 360.0, 8, c
    calling p.draw_ring_lines with 1.0, 2.0, 0.0, 360.0, 8, c
    calling p.draw_poly with 5, 2.0, 0.0, c
    calling p.draw_poly_lines with 5, 2.0, 0.0, c
    calling p.draw_poly_lines_ex with 5, 2.0, 0.0, 1.0, c
    calling p.draw_rectangle with q, c
    calling p.draw_triangle with q, r, c
    calling p.draw_triangle_lines with q, r, c
    calling rec.draw with c
    calling rec.draw_pro with p, 0.0, c
    calling rec.draw_gradient with c, c, c, c
    calling rec.draw_outline with 1.0, c
    calling rec.draw_rounded with 0.5, 8, c
    calling rec.draw_rounded_outline with 0.5, 8, 1.0, c
    calling draw_pixel with 1, 2, c
    calling draw_line with 0, 0, 1, 1, c
    calling draw_circle with 1, 2, 3.0, c
    calling draw_ellipse with 1, 2, 3.0, 4.0, c
    calling draw_ellipse_lines with 1, 2, 3.0, 4.0, c
    calling draw_rectangle with 0, 0, 4, 4, c
    calling draw_rectangle_lines with 0, 0, 4, 4, c
    calling draw_rectangle_gradient_v with 0, 0, 4, 4, c, c
    calling draw_rectangle_gradient_h with 0, 0, 4, 4, c, c
    calling draw_line_strip with strip, c
    calling draw_triangle_fan with strip, c
    calling draw_triangle_strip with strip, c
    calling draw_spline_linear with strip, 1.0, c
    calling draw_spline_basis with strip, 1.0, c
    calling draw_spline_catmull_rom with strip, 1.0, c
    calling draw_spline_bezier_quadratic with strip, 1.0, c
    calling draw_spline_bezier_cubic with strip, 1.0, c
    calling draw_spline_segment_linear with p, q, 1.0, c
    calling draw_spline_segment_basis with p, q, r, p, 1.0, c
    calling draw_spline_segment_catmull_rom with p, q, r, p, 1.0, c
    calling draw_spline_segment_bezier_quadratic with p, q, r, 1.0, c
    calling draw_spline_segment_bezier_cubic with p, q, r, p, 1.0, c
    calling set_shapes_texture with (calling shapes_texture), rec


test "spline_point_linear is exact at both ends and the middle":
    var a as raylib.Vector2 is with x is 0.0, y is 0.0
    var b as raylib.Vector2 is with x is 10.0, y is 0.0
    var mid as raylib.Vector2 is calling spline_point_linear with a, b, 0.5
    calling ward.assert_almost_eq with mid.x, 5.0, 0.001
    calling ward.assert_almost_eq with mid.y, 0.0, 0.001
    var start as raylib.Vector2 is calling spline_point_linear with a, b, 0.0
    calling ward.assert_almost_eq with start.x, 0.0, 0.001
    var end as raylib.Vector2 is calling spline_point_linear with a, b, 1.0
    calling ward.assert_almost_eq with end.x, 10.0, 0.001

test "spline_point_catmull_rom and basis are finite":
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var p2 as raylib.Vector2 is with x is 10.0, y is 0.0
    var p3 as raylib.Vector2 is with x is 10.0, y is 10.0
    var p4 as raylib.Vector2 is with x is 0.0, y is 10.0
    var cr as raylib.Vector2 is calling spline_point_catmull_rom with p1, p2, p3, p4, 0.5
    calling ward.assert_false with (cr.x != cr.x)
    var ba as raylib.Vector2 is calling spline_point_basis with p1, p2, p3, p4, 0.5
    calling ward.assert_false with (ba.x != ba.x)

test "spline_point_bezier_cubic starts and ends on the anchors":
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var c2 as raylib.Vector2 is with x is 3.0, y is 9.0
    var c3 as raylib.Vector2 is with x is 7.0, y is 9.0
    var p4 as raylib.Vector2 is with x is 10.0, y is 0.0
    var start as raylib.Vector2 is calling spline_point_bezier_cubic with p1, c2, c3, p4, 0.0
    calling ward.assert_almost_eq with start.x, 0.0, 0.001
    var end as raylib.Vector2 is calling spline_point_bezier_cubic with p1, c2, c3, p4, 1.0
    calling ward.assert_almost_eq with end.x, 10.0, 0.001
