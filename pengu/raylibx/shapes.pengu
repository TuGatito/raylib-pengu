## Replaces the 1x1 texture that raylib uses to draw every shape.
##
## ## Parameters
## - `texture`: the texture to draw shapes with.
## - `rec`: the source rectangle inside `texture`.
##
## ## Returns
## Nothing. The new texture becomes the global shapes texture.
##
## ## Notes
## Requires an active drawing frame (`BeginDrawing`/`EndDrawing`). Calling it outside one is undefined by raylib.
## This mutates global state used by every `Draw*` in raylib. The wrapper does not restore the previous texture: that is the caller's decision.
## Before any call, the shapes texture is a 1x1 white placeholder with source rectangle `(0, 0, 1, 1)` (measured in the family plan).
##
## ## Memory
## No allocation; a single direct C call.
##
## ## Example
## ```pengu
## calling raylibx_shapes.set_shapes_texture with tex, (with x is 0.0, y is 0.0, width is 16.0, height is 16.0)
## ```

weave set_shapes_texture with texture as raylib.Texture2D, rec as raylib.Rectangle into void:
    calling raylib.SetShapesTexture with texture, rec

## Returns the texture raylib currently uses to draw shapes.
##
## ## Returns
## The current shapes `raylib.Texture2D`.
##
## ## Notes
## Reading is safe without a drawing frame, but the value only becomes interesting after a `set_shapes_texture`.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var tex as raylib.Texture2D is calling raylibx_shapes.shapes_texture
## ```

weave shapes_texture into raylib.Texture2D:
    return calling raylib.GetShapesTexture

## Returns the source rectangle of the current shapes texture.
##
## ## Returns
## A `raylib.Rectangle`; the default is `(0, 0, 1, 1)`.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var rec as raylib.Rectangle is calling raylibx_shapes.shapes_texture_rectangle
## ```

weave shapes_texture_rectangle into raylib.Rectangle:
    return calling raylib.GetShapesTextureRectangle

## Reports whether two rectangles overlap.
##
## ## Parameters
## - `a`, `b`: the rectangles to test.
##
## ## Returns
## `true` when they overlap, `false` otherwise. An empty rectangle (zero width or height) collides with nothing, not even itself.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var hit as bool is calling raylibx_shapes.collision_recs with a, b
## ```

weave collision_recs with a as raylib.Rectangle, b as raylib.Rectangle into bool:
    return calling raylib.CheckCollisionRecs with a, b

## Returns the overlapping region of two rectangles.
##
## ## Parameters
## - `a`, `b`: the rectangles to intersect.
##
## ## Returns
## The intersection as a `raylib.Rectangle`. When they do not overlap (or either is empty) the result is `(0, 0, 0, 0)`, so this is **not** a `maybe`: use `collision_recs` when the distinction matters.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var overlap as raylib.Rectangle is calling raylibx_shapes.collision_rectangle with a, b
## ```

weave collision_rectangle with a as raylib.Rectangle, b as raylib.Rectangle into raylib.Rectangle:
    return calling raylib.GetCollisionRec with a, b

## Reports whether two circles overlap.
##
## ## Parameters
## - `c1`, `r1`: the first centre and radius.
## - `c2`, `r2`: the second centre and radius.
##
## ## Returns
## `true` when they overlap. Circles exactly `r1 + r2` apart do **not** count: the comparison is strict.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var hit as bool is calling raylibx_shapes.collision_circles with a, 5.0, b, 5.0
## ```

weave collision_circles with c1 as raylib.Vector2, r1 as f32, c2 as raylib.Vector2, r2 as f32 into bool:
    return calling raylib.CheckCollisionCircles with c1, r1, c2, r2

## Reports whether a circle overlaps a rectangle.
##
## ## Parameters
## - `center`, `radius`: the circle.
## - `rec`: the rectangle.
##
## ## Returns
## `true` when they overlap.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var hit as bool is calling raylibx_shapes.collision_circle_rec with c, 5.0, rec
## ```

weave collision_circle_rec with center as raylib.Vector2, radius as f32, rec as raylib.Rectangle into bool:
    return calling raylib.CheckCollisionCircleRec with center, radius, rec

## Reports whether a circle overlaps a line segment.
##
## ## Parameters
## - `center`, `radius`: the circle.
## - `p1`, `p2`: the segment endpoints.
##
## ## Returns
## `true` when the circle and the segment overlap.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var hit as bool is calling raylibx_shapes.collision_circle_line with c, 5.0, a, b
## ```

weave collision_circle_line with center as raylib.Vector2, radius as f32, p1 as raylib.Vector2, p2 as raylib.Vector2 into bool:
    return calling raylib.CheckCollisionCircleLine with center, radius, p1, p2

## Reports whether a point lies inside a circle.
##
## ## Parameters
## - `point`: the point to test.
## - `center`, `radius`: the circle.
##
## ## Returns
## `true` when the point is inside or on the circle.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var inside as bool is calling raylibx_shapes.collision_point_circle with p, c, 5.0
## ```

weave collision_point_circle with point as raylib.Vector2, center as raylib.Vector2, radius as f32 into bool:
    return calling raylib.CheckCollisionPointCircle with point, center, radius

## Reports whether a point lies inside a triangle.
##
## ## Parameters
## - `point`: the point to test.
## - `p1`, `p2`, `p3`: the triangle vertices.
##
## ## Returns
## `true` when the point is inside the triangle.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var inside as bool is calling raylibx_shapes.collision_point_triangle with p, a, b, c
## ```

weave collision_point_triangle with point as raylib.Vector2, p1 as raylib.Vector2, p2 as raylib.Vector2, p3 as raylib.Vector2 into bool:
    return calling raylib.CheckCollisionPointTriangle with point, p1, p2, p3

## Reports whether a point lies within a threshold of a line segment.
##
## ## Parameters
## - `point`: the point to test.
## - `p1`, `p2`: the segment endpoints.
## - `threshold`: the tolerance in pixels.
##
## ## Returns
## `true` when the distance from the point to the segment is within `threshold`.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var near as bool is calling raylibx_shapes.collision_point_line with p, a, b, 1
## ```

weave collision_point_line with point as raylib.Vector2, p1 as raylib.Vector2, p2 as raylib.Vector2, threshold as int into bool:
    return calling raylib.CheckCollisionPointLine with point, p1, p2, threshold

## Finds where two line segments cross.
##
## ## Parameters
## - `a1`, `a2`: the first segment.
## - `b1`, `b2`: the second segment.
##
## ## Returns
## `some` with the intersection point, or `maybe none` when the segments do not cross.
##
## ## Notes
## The C function returns a success flag and writes the point through an out-parameter. Folding both into `maybe ray lib.Vector2` means the flag is not returned twice: `some` *is* the success.
## On a miss raylib leaves the out-parameter untouched, so the wrapper never reads it in that case.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var cross as maybe raylib.Vector2 is calling raylibx_shapes.line_intersection with a1, a2, b1, b2
## ```

weave line_intersection with a1 as raylib.Vector2, a2 as raylib.Vector2, b1 as raylib.Vector2, b2 as raylib.Vector2 into maybe raylib.Vector2:
    var point as raylib.Vector2 is with x is 0.0, y is 0.0
    if calling raylib.CheckCollisionLines with a1, a2, b1, b2, (sigil of point):
        return some point
    return maybe none

## Reports whether a point lies inside a polygon.
##
## ## Parameters
## - `point`: the point to test.
## - `points`: the polygon vertices, in order.
##
## ## Returns
## `true` when the point is inside the polygon; `false` for an empty `points` slice.
##
## ## Notes
## An empty polygon contains nothing, which is why the guard returns `false` rather than touching element zero.
##
## ## Memory
## No allocation.
##
## ## Example
## ```pengu
## var inside as bool is calling raylibx_shapes.collision_point_poly with p, poly
## ```

weave collision_point_poly with point as raylib.Vector2, points as slice of raylib.Vector2 into bool:
    if (points.length) == 0:
        return false
    let raw as ref to void is transmute (sigil of (points at 0)) to (ref to void)
    return calling raylib.CheckCollisionPointPoly with point, raw, (points.length)

# --- Tests ---

test "collision_recs detects overlap":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    calling ward.assert_true with (calling collision_recs with a, b)

test "collision_recs rejects disjoint rectangles":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    var far as raylib.Rectangle is with x is 100.0, y is 100.0, width is 10.0, height is 10.0
    calling ward.assert_false with (calling collision_recs with a, far)

test "collision_recs rejects an empty rectangle":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    var empty as raylib.Rectangle is with x is 0.0, y is 0.0, width is 0.0, height is 0.0
    calling ward.assert_false with (calling collision_recs with a, empty)
    calling ward.assert_false with (calling collision_recs with empty, empty)

test "collision_rectangle returns the overlap":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    var overlap as raylib.Rectangle is calling collision_rectangle with a, b
    calling ward.assert_almost_eq with overlap.x, 5.0, 0.001
    calling ward.assert_almost_eq with overlap.y, 5.0, 0.001
    calling ward.assert_almost_eq with overlap.width, 5.0, 0.001
    calling ward.assert_almost_eq with overlap.height, 5.0, 0.001

test "collision_rectangle is a zero rectangle when disjoint":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    var far as raylib.Rectangle is with x is 100.0, y is 100.0, width is 10.0, height is 10.0
    var none as raylib.Rectangle is calling collision_rectangle with a, far
    calling ward.assert_almost_eq with none.width, 0.0, 0.001
    calling ward.assert_almost_eq with none.height, 0.0, 0.001

test "collision_rectangle never exceeds the inputs":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    var overlap as raylib.Rectangle is calling collision_rectangle with a, b
    calling ward.assert_true with (overlap.width <= a.width)
    calling ward.assert_true with (overlap.height <= b.height)

test "collision_circles detects overlap":
    var c1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var c2 as raylib.Vector2 is with x is 5.0, y is 0.0
    calling ward.assert_true with (calling collision_circles with c1, 5.0, c2, 5.0)

test "collision_circles includes the touching distance":
    var c1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var c2 as raylib.Vector2 is with x is 10.0, y is 0.0
    calling ward.assert_true with (calling collision_circles with c1, 5.0, c2, 5.0)
    var just_past as raylib.Vector2 is with x is 10.001, y is 0.0
    calling ward.assert_false with (calling collision_circles with c1, 5.0, just_past, 5.0)

test "collision_circles rejects far circles":
    var c1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var c2 as raylib.Vector2 is with x is 100.0, y is 0.0
    calling ward.assert_false with (calling collision_circles with c1, 5.0, c2, 5.0)

test "collision_circle_rec detects a circle inside a rectangle":
    var rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is 20.0, height is 20.0
    var center as raylib.Vector2 is with x is 10.0, y is 10.0
    calling ward.assert_true with (calling collision_circle_rec with center, 2.0, rec)

test "collision_circle_rec rejects a distant circle":
    var rec as raylib.Rectangle is with x is 0.0, y is 0.0, width is 20.0, height is 20.0
    var center as raylib.Vector2 is with x is 100.0, y is 100.0
    calling ward.assert_false with (calling collision_circle_rec with center, 2.0, rec)

test "collision_circle_line detects a circle on the segment":
    var center as raylib.Vector2 is with x is 5.0, y is 0.0
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var p2 as raylib.Vector2 is with x is 10.0, y is 0.0
    calling ward.assert_true with (calling collision_circle_line with center, 2.0, p1, p2)

test "collision_circle_line rejects a distant circle":
    var center as raylib.Vector2 is with x is 5.0, y is 50.0
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var p2 as raylib.Vector2 is with x is 10.0, y is 0.0
    calling ward.assert_false with (calling collision_circle_line with center, 2.0, p1, p2)

test "collision_point_circle accepts the centre and the boundary":
    var center as raylib.Vector2 is with x is 0.0, y is 0.0
    calling ward.assert_true with (calling collision_point_circle with center, center, 5.0)
    var edge as raylib.Vector2 is with x is 5.0, y is 0.0
    calling ward.assert_true with (calling collision_point_circle with edge, center, 5.0)

test "collision_point_circle rejects an outside point":
    var center as raylib.Vector2 is with x is 0.0, y is 0.0
    var outside as raylib.Vector2 is with x is 50.0, y is 0.0
    calling ward.assert_false with (calling collision_point_circle with outside, center, 5.0)

test "collision_point_triangle accepts an inside point":
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var p2 as raylib.Vector2 is with x is 10.0, y is 0.0
    var p3 as raylib.Vector2 is with x is 0.0, y is 10.0
    var inside as raylib.Vector2 is with x is 2.0, y is 2.0
    calling ward.assert_true with (calling collision_point_triangle with inside, p1, p2, p3)

test "collision_point_triangle rejects an outside point":
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var p2 as raylib.Vector2 is with x is 10.0, y is 0.0
    var p3 as raylib.Vector2 is with x is 0.0, y is 10.0
    var outside as raylib.Vector2 is with x is 9.0, y is 9.0
    calling ward.assert_false with (calling collision_point_triangle with outside, p1, p2, p3)

test "collision_point_line honours the threshold":
    var p1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var p2 as raylib.Vector2 is with x is 10.0, y is 0.0
    var on as raylib.Vector2 is with x is 5.0, y is 0.0
    calling ward.assert_true with (calling collision_point_line with on, p1, p2, 1)
    var off as raylib.Vector2 is with x is 5.0, y is 9.0
    calling ward.assert_false with (calling collision_point_line with off, p1, p2, 1)

test "line_intersection finds a crossing":
    var a1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var a2 as raylib.Vector2 is with x is 10.0, y is 0.0
    var b1 as raylib.Vector2 is with x is 5.0, y is -5.0
    var b2 as raylib.Vector2 is with x is 5.0, y is 5.0
    var cross as maybe raylib.Vector2 is calling line_intersection with a1, a2, b1, b2
    calling ward.assert_maybe_present with cross
    var point as raylib.Vector2 is calling cross.unwrap
    calling ward.assert_almost_eq with point.x, 5.0, 0.001
    calling ward.assert_almost_eq with point.y, 0.0, 0.001

test "line_intersection is maybe none for parallel segments":
    var a1 as raylib.Vector2 is with x is 0.0, y is 0.0
    var a2 as raylib.Vector2 is with x is 10.0, y is 0.0
    var b1 as raylib.Vector2 is with x is 0.0, y is 5.0
    var b2 as raylib.Vector2 is with x is 10.0, y is 5.0
    var cross as maybe raylib.Vector2 is calling line_intersection with a1, a2, b1, b2
    calling ward.assert_maybe_none with cross

test "Rectangle.contains_point matches the collision predicate":
    var a as raylib.Rectangle is with x is 0.0, y is 0.0, width is 10.0, height is 10.0
    var b as raylib.Rectangle is with x is 5.0, y is 5.0, width is 10.0, height is 10.0
    var inside as raylib.Vector2 is with x is 3.0, y is 3.0
    var outside as raylib.Vector2 is with x is 50.0, y is 50.0
    calling ward.assert_true with (calling a.contains_point with inside)
    calling ward.assert_false with (calling a.contains_point with outside)
    calling ward.assert_eq_bool with (calling a.contains_point with inside), (calling collision_point_circle with inside, (with x is 3.0, y is 3.0), 0.0)

test "shapes_texture_rectangle reports a usable rectangle":
    # Measured: the value depends on whether a graphics device has ever been initialised, so
    # asserting the virgin placeholder would make this test depend on test order.
    #   * before any window: the placeholder, (0,0) 1x1;
    #   * after InitWindow: the default font's atlas glyph, (41,46) 2x8, because loading the
    #     default font calls SetShapesTexture -- and it stays that way after CloseWindow,
    #     since it is process-global state.
    # What holds in both states, and is what the wrapper actually promises, is a rectangle
    # with a non-negative origin and a non-empty extent.
    var rec as raylib.Rectangle is calling shapes_texture_rectangle
    calling ward.assert_true with (rec.x >= 0.0)
    calling ward.assert_true with (rec.y >= 0.0)
    calling ward.assert_true with (rec.width >= 1.0)
    calling ward.assert_true with (rec.height >= 1.0)

test "shapes_texture returns a texture without a drawing frame":
    var tex as raylib.Texture2D is calling shapes_texture
    calling ward.assert_ge_int with (tex.width to int), 0
    calling ward.assert_ge_int with (tex.height to int), 0

test "collision_point_poly accepts an inside point":
    var poly as list of raylib.Vector2 is list of raylib.Vector2
    defer banish poly
    calling poly.push with (with x is 0.0, y is 0.0)
    calling poly.push with (with x is 10.0, y is 0.0)
    calling poly.push with (with x is 0.0, y is 10.0)
    var inside as raylib.Vector2 is with x is 2.0, y is 2.0
    calling ward.assert_true with (calling collision_point_poly with inside, (poly at 0 to 3))

test "collision_point_poly rejects an outside point":
    var poly as list of raylib.Vector2 is list of raylib.Vector2
    defer banish poly
    calling poly.push with (with x is 0.0, y is 0.0)
    calling poly.push with (with x is 10.0, y is 0.0)
    calling poly.push with (with x is 0.0, y is 10.0)
    var outside as raylib.Vector2 is with x is 50.0, y is 50.0
    calling ward.assert_false with (calling collision_point_poly with outside, (poly at 0 to 3))

test "collision_point_poly on an empty slice is false":
    var poly as list of raylib.Vector2 is list of raylib.Vector2
    defer banish poly
    var point as raylib.Vector2 is with x is 0.0, y is 0.0
    calling ward.assert_false with (calling collision_point_poly with point, (poly at 0 to 0))

test "draw_line_strip on an empty slice is a no-op":
    var empty as list of raylib.Vector2 is list of raylib.Vector2
    defer banish empty
    calling draw_line_strip with (empty at 0 to 0), raylib.RED

